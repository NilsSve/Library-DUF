// ServerSelection.dg The servers or data sources of a driver, to pick one from.
// The dialog is a cDUFSelectionDialog; the program fills its psTheData before it pops up.

Use cDUFSelectionDialog.pkg

Object oServerSelection_sl is a cDUFSelectionDialog
    Set Label to "Database Server/DSN Selection"
    Set Size to 105 225
    Set piMinSize to 89 211
    Set Icon to "ServerLookup.ico"
    Set psColumnCaption to "Name"
End_Object
