// oUnit_Tests.pkg - the root fixture for the unit tests of the DUF workspace.
//
// This is the only file to edit when a test file is added: one Use line per subject. One file per class or
// per function under test, named o<Subject>-Tests.pkg.
//
// Setup and TearDown here run around every test in every nested fixture, so state that must be reset between
// tests belongs here.

Use DFUnit\Fixturing\Fixture.pkg

Object oWorkspace_Tests is a cTestFixture
    Set psTestFixtureName to "DUF"

    Procedure Setup
    End_Procedure

    Procedure TearDown
    End_Procedure

    // *** Test files below - one Use line per subject: ***
    Use oDbUpdateFunctionLibrary-Tests.pkg
    Use oDbUpdateTableUpdate-Tests.pkg
    Use oDbUpdateUserCount-Tests.pkg
    Use oDFAbout-Tests.pkg
    Use oSQLConnectionIniFile-Tests.pkg

End_Object
