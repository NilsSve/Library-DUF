// DatabaseSelection.dg The databases of a server, to pick one from.
// The dialog is a cDUFSelectionDialog; the program fills its psTheData before it pops up.

Use cDUFSelectionDialog.pkg

Object oDatabaseSelection_sl is a cDUFSelectionDialog
    Set Label to "SQL Database Selection"
    Set Size to 119 183
    Set piMinSize to 89 170
    Set Icon to "DatabaseLookup.ico"
    Set psColumnCaption to "Database Name"
End_Object
