    // Note: If the psDriverID + other connection properties are to be changed,
    //       the psDriverID *must* be the first property that gets changed!
    //       Otherwise errors might be raised by the driver when e.g. the format
    //       for a connection string has the wrong format for that driver.
    { MethodType=Property Category="Database" InitialValue="Default" }
    { EnumList="DATAFLEX, MSSQLDRV, DB2_DRV, ODBC_DRV" }
    Procedure Set psDriverID String sValue
        Send Ignore_Error of Error_Object_Id DFERR_BAD_MESSAGE
        Delegate Set psDriverID to sValue
        Send Trap_Error of Error_Object_Id DFERR_BAD_MESSAGE
        Set psDriverID of ghoSQLConnectionHandler to sValue
    End_Procedure

    Function psDriverID Returns String
        String sDriverID

        Send Ignore_Error of Error_Object_Id DFERR_BAD_MESSAGE
        // This should get it from the parent object (when using the cDbUpdateHandler class)
        Delegate Get psDriverID to sDriverID
        Send Trap_Error of Error_Object_Id DFERR_BAD_MESSAGE
        Move False to Err

        // ...and in case it didn't use property of this class. Then the library is
        // probably used as "utilites" from a special made program and
        // the ghoSQLConnectionHandler must have been setup
        If (sDriverID = "") Begin
            Get psDriverID of ghoSQLConnectionHandler to sDriverID
        End
        Function_Return sDriverID
    End_Function

    { MethodType=Property Category="Database" InitialValue=Default }
    { EnumList="EN_DbTypeMSSQL, EN_DbTypeMySQL, EN_DbTypeOracle, EN_DbTypeDB2, EN_DbTypePostgre, EN_DbTypeDataFlex" }
    Procedure Set piDbType Integer iValue
        Send Ignore_Error of Error_Object_Id DFERR_BAD_MESSAGE
        Delegate Set piDbType to iValue
        Send Trap_Error of Error_Object_Id DFERR_BAD_MESSAGE
        Set piDbType of ghoSQLConnectionHandler to iValue
    End_Procedure

    Function piDbType Returns Integer
        Integer iRetval
        Get piDbType of ghoSQLConnectionHandler to iRetval
        Function_Return iRetval
    End_Function

    // Returns all schemas as a string array for the passed driver id.
    Function SqlUtilEnumerateSchemas String sDriverID Returns String[]
        String[] sReturnArray
        Boolean bOK

        Get _SqlCheckCurrentDriver sDriverID to bOK
        If (bOK = False) Begin
            Function_Return sReturnArray
        End

        Case Begin
            Case (sDriverID = DB2_DRV_ID)
                Get _SqlEnumerateEsqlDAW "select schemaname from syscat.schemata" 1 to sReturnArray
                Case Break

            Case Else
                Error DFERR_PROGRAM "Unsupported driver passed to SqlUtilEnumerateSchemas function."
                Case Break
        Case End

        Function_Return sReturnArray
    End_Function

    // Returns a string array with all tables for the current database.
    Function _SqlUtilEnumerateTables String sDriverID String sDatabase String sSchema Returns String[]
        String[] asReturnArray
        String sConnectionString
        Integer iDbType
        Boolean bOK

        If (sDriverID = DATAFLEX_ID) Begin
            Function_Return asReturnArray
        End

        Get _SqlCheckCurrentDriver sDriverID to bOK
        If (bOK = False) Begin
            Function_Return asReturnArray
        End
        If (sSchema = "") Begin
            Get _SqlFindKeyWord CI_SQLDBO to sSchema
        End

        Get psConnectionString to sConnectionString

        // We need to treat DAW's ODBC driver a bit different, as the output depends on
        // the dbType.
        Get piDbType to iDbType
        If (sDriverID = ODBC_DRV_ID) Begin
            If (iDbType = EN_DbTypeMSSQL) Begin
                Move MSSQLDRV_ID to sDriverID
            End
            If (iDbType = EN_DbTypeDB2) Begin
                Move DB2_DRV_ID to sDriverID
            End
            If (iDbType = EN_DbTypePostgre) Begin
                Move ODBC_DRV_ID to sDriverID
            End
        End

        Case Begin
            Case (sDriverID = MSSQLDRV_ID)
                Get _SqlTableArrayDAW to asReturnArray
                Case Break

            Case (sDriverID = DB2_DRV_ID)
                Get _SqlTableArrayDAW to asReturnArray
                Case Break

            Case (sDriverID = ODBC_DRV_ID)
                Get _SqlTableArrayDAW to asReturnArray
                Case Break

            Case Else
                Error DFERR_PROGRAM "Unsupported driver passed to _SqlUtilEnumerateTables function."
                Case Break
        Case End

        Function_Return asReturnArray
    End_Function

    // Returns all table spaces as a string array for the passed driver id.
    Function _SqlUtilEnumerateTablespaces String sDriverID Returns String[]
        String[] sReturnArray
        Boolean bOK

        Get _SqlCheckCurrentDriver sDriverID to bOK
        If (bOK = False) Begin
            Function_Return sReturnArray
        End

        Case Begin
            Case (sDriverID = DB2_DRV_ID)
                // The DB2 catalogue. (dba_tablespaces is an Oracle view.) Not run against a DB2 server.
                Get _SqlEnumerateEsqlDAW "SELECT TBSPACE FROM SYSCAT.TABLESPACES" 1 to sReturnArray
                Case Break

            Case Else
                Error DFERR_PROGRAM "Unsupported driver passed to _SqlUtilEnumerateTablespaces function."
                Case Break
        Case End

        Function_Return sReturnArray
    End_Function

    // Returns a string array with all table columns/fields for the passed table handle and driver id.
    Function _SqlUtilEnumerateColumnsByHandle String sDriverID Handle hTable Returns String[]
        String[] asReturnArray
        String sRootName sTableName
        
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _TableNameOnly sRootName to sTableName
        Get _SqlUtilEnumerateColumns sDriverID sTableName to asReturnArray
        Function_Return asReturnArray
    End_Function

    // Returns a string array with all table columns/fields for the passed table handle and driver id.
    Function _SqlUtilEnumerateColumns String sDriverID String sTableName Returns String[]
        String[] sReturnArray
        String sConnectionString sSelect sSchema
        Boolean bOK
        Integer iDbType

        Get _SqlCheckCurrentDriver sDriverID to bOK
        If (bOK = False) Begin
            Error DFERR_PROGRAM ("Unsupported driver. A list of table columns could not be retrieved for:" * sDriverID + ".")
            Function_Return sReturnArray
        End

        Get psConnectionString to sConnectionString
        // The schema of the connection, "dbo" when there is none. (The MS SQL lists had "dbo." written in.)
        Get psSchema to sSchema
        If (sSchema = "") Begin
            Get _SqlFindKeyWord CI_SQLDBO to sSchema
        End

        // We need to treat DAW's ODBC driver a bit different, as the output depends on
        // the dbType.
        Get piDbType to iDbType

        Case Begin
            Case (sDriverID = ODBC_DRV_ID)
                If (iDbType = EN_DbTypeMySQL) Begin
                    Move ("SHOW COLUMNS FROM" * sTableName) to sSelect
                End
                If (iDbType = EN_DbTypePostgre) Begin
                    Move ("select column_name, data_type, character_maximum_length from INFORMATION_SCHEMA.COLUMNS where table_name = '" +sTableName + "'") to sSelect
                End
                If (iDbType = EN_DbTypeMSSQL) Begin
                    Move ("select name from sys.columns where [object_id] = object_id('" + sSchema + "." + sTableName + "')") to sSelect
                End

                Get _SqlEnumerateEsqlDAW sSelect 1 to sReturnArray
                Case Break

            Case (sDriverID = MSSQLDRV_ID)
                Move ("select name from sys.columns where [object_id] = object_id('" + sSchema + "." + sTableName + "')") to sSelect
                Get _SqlEnumerateEsqlDAW sSelect 1 to sReturnArray
                Case Break

            Case (sDriverID = DB2_DRV_ID)
                Move ("SELECT colname from syscat.columns WHERE tabschema = '" + sSchema + "'" * "AND tabname = '" + sTableName + "'") to sSelect
                Get _SqlEnumerateEsqlDAW sSelect 1 to sReturnArray
                Case Break

            Case Else
                Error DFERR_PROGRAM "Unsupported driver passed to _SqlUtilEnumerateColumns function."
                Case Break
        Case End

        Function_Return sReturnArray
    End_Function

    // Returns a string array with all table indexes for the passed table handle and driver id.
    Function _SqlUtilEnumerateIndexes String sTableName String sDriverID Returns String[]
        String[] asReturnArray asReturnArray2
        String sConnectionString sSelect sSchema
        Boolean bOK
        Integer iCount iSize

        Get _SqlCheckCurrentDriver sDriverID to bOK
        If (bOK = False) Begin
            Error DFERR_PROGRAM ("Unsupported driver. A list of table indexes could not be retrieved for:" * sDriverID + ".")
            Function_Return asReturnArray
        End

        Get psConnectionString to sConnectionString
        Get psSchema to sSchema

        Case Begin
            Case (sDriverID = MSSQLDRV_ID)
                Move ("select * from sys.indexes where object_id = (select object_id from sys.objects where name = '" + sTableName + "')") to sSelect
                Get _SqlEnumerateEsqlDAW sSelect 2 to asReturnArray
                Case Break

            // The DB2 catalogue. (It raised an error with no number and went on with an empty list.) Not run
            // against a DB2 server.
            Case (sDriverID = DB2_DRV_ID)
                Move ("SELECT INDNAME FROM SYSCAT.INDEXES WHERE TABSCHEMA = '" + Uppercase(sSchema) + "' AND TABNAME = '" + Uppercase(sTableName) + "'") to sSelect
                Get _SqlEnumerateEsqlDAW sSelect 1 to asReturnArray
                Case Break

            Case Else
                Error DFERR_PROGRAM "Unsupported driver passed to _SqlUtilEnumerateIndexes function."
                Case Break
        Case End

        Move (SizeOfArray(asReturnArray)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            If (Trim(asReturnArray[iCount]) <> "") Begin
                Move asReturnArray[iCount] to asReturnArray2[SizeOfArray(asReturnArray2)]
            End
        Loop

        Function_Return asReturnArray2
    End_Function

    // Returns a string array with all table names the passed table handle has relation ships with.
    // The format of the array is "TableName.FieldName"
    Function _SqlUtilEnumerateRelations String sTableName String sDriverID Returns tSQLRelation[]
        String[][] aRows
        tSQLRelation[] sRelationsArray
        String sConnectionString sSelect sSchema sFileName sFieldName
        Boolean bOK
        Integer iCount iSize iLength

        Get _SqlCheckCurrentDriver sDriverID to bOK
        If (bOK = False) Begin
            Error DFERR_PROGRAM ("Unsupported driver. A list of table relations could not be retrieved for:" * sDriverID + ".")
            Function_Return sRelationsArray
        End

        Get psConnectionString to sConnectionString
        Get psSchema to sSchema

        Case Begin
            Case (sDriverID = MSSQLDRV_ID)
                Move ("SELECT object_name(parent_object_id), object_name(referenced_object_id), name from sys.foreign_keys WHERE parent_object_id = object_id( '" + sTableName + "')") to sSelect
                Get _SqlEnumerateEsqlRowsDAW sSelect 3 to aRows
                Case Break

            // The same three columns from the DB2 catalogue: the table, the table it refers to, the key's name.
            // (It raised an error with no number and went on with an empty list.) Not run against a DB2 server.
            Case (sDriverID = DB2_DRV_ID)
                Move ("SELECT TABNAME, REFTABNAME, CONSTNAME FROM SYSCAT.REFERENCES WHERE TABSCHEMA = '" + Uppercase(sSchema) + "' AND TABNAME = '" + Uppercase(sTableName) + "'") to sSelect
                Get _SqlEnumerateEsqlRowsDAW sSelect 3 to aRows
                Case Break

            Case Else
                Error DFERR_PROGRAM "Unsupported driver passed to the _SqlUtilEnumerateRelations function."
                Case Break
        Case End

        Move (Length(sTableName)) to iLength
        Move (iLength + 4)        to iLength // The related to field key has the format "FK_TableName + FieldName"
        Move (SizeOfArray(aRows)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            If (Trim(aRows[iCount][1]) <> "") Begin
                Move aRows[iCount][1]               to sFileName
                Move aRows[iCount][2]               to sFieldName
                Move (Mid(sFieldName, 99, iLength)) to sFieldName
                Move sFileName  to sRelationsArray[iCount].sFileName
                Move sFieldName to sRelationsArray[iCount].sFieldName
            End
        Loop

        Function_Return sRelationsArray
    End_Function

    Function SqlUtilEnumerateLoggedInUsers String sDriverID String sDatabase Returns tSQLLoggedInUser[]
        tSQLLoggedInUser[] SQLLoggedInUser
        String[][] aRows
        String sSelect
        Integer iSize iCount

        Case Begin
            Case (sDriverID = MSSQLDRV_ID)
                Move ("SELECT RTRIM(SP.nt_username) AS Inlog, RTRIM(SP.program_name) as Programma from master.dbo.sysprocesses SP INNER JOIN master.dbo.sysdatabases SD ON SP.dbid = SD.dbid WHERE (SP.nt_username <> '') and (SP.nt_username <> 'SYSTEM') and (SD.name = '" ;
                + sDatabase + "') ORDER by Inlog") to sSelect
                Get _SqlEnumerateEsqlRowsDAW sSelect 2 to aRows
                Case Break
            Case Else
                Error DFERR_PROGRAM ("Not implemented yet for this driver (" + sDriverID + ")")
        Case End

        Move (SizeOfArray(aRows)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move aRows[iCount][0] to SQLLoggedInUser[iCount].sUser
            Move aRows[iCount][1] to SQLLoggedInUser[iCount].sProgram
        Loop

        Function_Return SQLLoggedInUser
    End_Function

    // Returns an array with all ".int" files for the passed sDataPath, _except_ for the driver .int files;
    // "MSSQLDRV.int", "DB2_DRV.int" & "ODBC_DRV.int".
    Function SqlUtilEnumerateIntFiles String sDataPath Returns String[]
        String[] sFilesData
        Boolean bExists
        Integer iCh
        String sFileName sExt

        Get vFolderExists sDataPath to bExists
        If (bExists = True) Begin
#IF (!@ > 191)
            Move (Utf8ToAnsi(Trim(sDataPath))) to sDataPath
#ELSE
            Move (ToANSI(Trim(sDataPath))) to sDataPath
#ENDIF
            Move ("dir:" + sDataPath)      to sDataPath
            Get Seq_New_Channel to iCh  // get free channel for input
            Direct_Input channel iCh sDataPath
                Repeat
                    Readln channel iCh sFileName
                    Get ParseFileExtension sFileName to sExt
                    If (Uppercase(sExt) = "INT") Begin
                        // None of the three. ("and" where "or" was meant: no name holds all three, so none was left out.)
                        If (not(Uppercase(sFileName) contains "MSSQLDRV" or Uppercase(sFileName) contains "DB2_DRV" or Uppercase(sFileName) contains "ODBC_DRV")) Begin
                            Move sFileName to sFilesData[SizeOfArray(sFilesData)]
                        End
                    End
                Until (SeqEof = True)
            Close_Input channel iCh
            Send Seq_Release_Channel iCh
        End
        Function_Return sFilesData
    End_Function

    // Only done for MSSQLDRV_ID so far...
    Function _SqlEnumerateDatabaseCollations String sDriverID Returns tSQLCollation[]
        String sSQL sConnectionID sConnectionString sSelect sName
        String sDescription sFrom sSys sValue sDescr sPrevious
        Handle hStmt hoSQLManager hoSQLConnect
        Integer iFetchResult iRows iColumn iPos iRow
        tSQLCollation[] aCollations
        
        If (sDriverID = "") Begin
            Error DFERR_PROGRAM "The database driver ID was not passed as a parameter to the '_SqlEnumerateDatabaseCollations' function"
            Function_Return aCollations
        End

        // Only done for MSSQLDRV_ID so far...
        If (sDriverID <> MSSQLDRV_ID) Begin
            Function_Return aCollations
        End                 

        Get phoSQLManager to hoSQLManager
        Get psConnectionID     to sConnectionID
        Get psConnectionString to sConnectionString
        Move 0 to LastErr

        Send Ignore_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL
        Get SqlConnect of hoSQLManager sDriverID sConnectionString to hoSQLConnect
        Send Trap_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL
        If (LastErr = CLIERR_LOGIN_UNSUCCESSFUL) Begin
            Error DFERR_PROGRAM ("Login failed to the database server. The following connect string was used:\n" + SQLConnectionStringMasked(sConnectionString))
            Function_Return aCollations
        End

        Get SqlOpen of hoSQLConnect to hStmt

        If (hStmt = 0) Begin
            Send SqlDisconnect of hoSQLConnect
            Error DFERR_PROGRAM CS_DUF_ConnectError
            Function_Return aCollations
        End
        
        Move 0 to iRow
        Get _SqlFindKeyWord CI_SQLSelect      to sSelect
        Get _SqlFindKeyWord CI_SQLName        to sName
        Get _SqlFindKeyWord CI_SQLDescription to sDescription
        Get _SqlFindKeyWord CI_SQLFrom        to sFrom
        Get _SqlFindKeyWord CI_SQLSys         to sSys

        // MS-SQL Syntax:  
        // SELECT name, description
        //   from sys.fn_helpcollations();
        Move (sSelect  * String(sName) * String(",") * String(sDescription) * String(sFrom) * String(sSys) * String(".fn_helpcollations();")) to sSQL

        Move 1 to iColumn
        Send SqlExecDirect of hStmt sSQL
        Get SQLGetStmtAttribute of hStmt SqlSTMTATTRIB_ROWCOUNT to iRows
        Repeat
            Get SQLFetch of hStmt to iFetchResult
            If (iFetchResult <> 0) Begin
                Get SQLColumnValue of hStmt iColumn to sValue 
                If (sValue <> sPrevious) Begin         
                    // We need to skip all collations starting with "SQL" because they
                    // are obsolete and for pre-SQL Server 2000.
                    Move (Pos("SQL", Uppercase(sValue))) to iPos
                    If (iPos <> 1) Begin
                        Move (Trim(sValue)) to aCollations[iRow].sCollation
                        Get SQLColumnValue of hStmt (iColumn +1) to sDescr
                        Move (Trim(sDescr)) to aCollations[iRow].sDescription
                        Increment iRow
                    End
                End
                Move sValue to sPrevious
            End
        Until (iFetchResult = 0)
        Send SQLClose of hStmt
        Send SQLDisconnect of hoSQLConnect

        Function_Return aCollations
    End_Function

    // All rows of a result set with columns 1 to iColumns of each, trimmed and nothing removed: aRows[row][column - 1].
    // (Callers fetched each column in a run of its own through _SqlEnumerateEsqlDAW, which drops a value equal to the
    // one before it, and paired the lists by place: two users of one program, or two keys to one table, shifted them.)
    Function _SqlEnumerateEsqlRowsDAW String sStmt Integer iColumns Returns String[][]
        String[][] aRows
        String sValue
        Handle hoSQLHandler hoSQLConnect hstmt
        Integer iFetchResult iRow iColumn
        tSQLConnection SQLConnection

        Get phoSQLManager to hoSQLHandler
        If (hoSQLHandler <> 0) Begin
            Get pSQLConnection of ghoSQLConnectionHandler to SQLConnection
            Get SQLConnect of hoSQLHandler SQLConnection.sDriverID SQLConnection.sConnectionString to hoSQLConnect
            If (hoSQLConnect <> 0) Begin
                Get SQLOpen of hoSQLConnect to hstmt
                If (hstmt <> 0) Begin
                    Send SqlExecDirect of hstmt sStmt
                    Move 0 to iRow
                    Repeat
                        Get SQLFetch of hstmt to iFetchResult
                        If (iFetchResult <> 0) Begin
                            For iColumn from 1 to iColumns
                                Get SQLColumnValue of hstmt iColumn to sValue
                                Move (Trim(sValue)) to aRows[iRow][iColumn - 1]
                            Loop
                            Increment iRow
                        End
                    Until (iFetchResult = 0)
                    Send SQLClose of hstmt
                End
                Send SQLDisconnect of hoSQLConnect
            End
        End
        Function_Return aRows
    End_Function

    // To enumerate SQL database resources with ESQL and return the result as a string array,
    // for DAW drivers.
    // Returns: A string array.
    Function _SqlEnumerateEsqlDAW String sStmt Integer iColumn Returns String[]
        String[] sReturnArray
        String sValue sPrevious
        Handle hoSQLHandler hoSQLConnect hstmt
        Integer iFetchResult iRows
        tSQLConnection SQLConnection

        Get phoSQLManager to hoSQLHandler

        If (hoSQLHandler <> 0) Begin
            Get pSQLConnection of ghoSQLConnectionHandler to SQLConnection
            Get SQLConnect of hoSQLHandler SQLConnection.sDriverID SQLConnection.sConnectionString to hoSQLConnect

            If (hoSQLConnect <> 0) Begin
                Get SQLOpen of hoSQLConnect to hstmt
                If (hstmt <> 0) Begin
                    Send SqlExecDirect of hstmt sStmt
                    Get SQLGetStmtAttribute of hstmt SqlSTMTATTRIB_ROWCOUNT to iRows
                    Repeat
                        Get SQLFetch of hstmt to iFetchResult
                        If (iFetchResult <> 0) Begin
                            Get SQLColumnValue of hstmt iColumn to sValue
                            If (sValue <> sPrevious) Begin
                                Move (Trim(sValue)) to sReturnArray[SizeOfArray(sReturnArray)
                            End
                            Move sValue to sPrevious
                        End
                    Until (iFetchResult = 0)
                    Send SQLClose of hstmt
                End
                Send SQLDisconnect of hoSQLConnect
            End
        End

        Function_Return sReturnArray
    End_Function

    { Visibility=Private }
    Function _SqlDatabasesArrayDB2 Returns String[]
        String[] sReturnArray
        String sDataSource
        Handle hoSQLHandler
        Integer iItem

        Get phoDB2SQLHandler to hoSQLHandler
        Send SeedDataSources of hoSQLHandler

        Send Ignore_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL

        Repeat
            Get DataSources of hoSQLHandler to sDataSource
            Move (Replaces(",", sDataSource, "")) to sDataSource
            Move (Trim(sDataSource)) to sReturnArray[iItem]
            Increment iItem
        Until (sDataSource = "")

        Send Trap_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL

        Function_Return sReturnArray
    End_Function

    { Visibility=Private }

    Function _SqlDatabasesArrayODBC Returns tSQLIntTableInfo[]
        String[] sDataSources
        tSQLConnection SQLConnection
        tSQLIntTableInfo[] sReturnArray
        Integer iDataSources iCount iItem
        String sConnection sServer sDatabase sKey sSubKey
        Handle hoIniFile hoRegistry hoODBCDataSources
        Boolean bExists bKeyOpened

        Get pSQLConnection of ghoSQLConnectionHandler to SQLConnection
        Move SQLConnection.sConnectionString to sConnection
        Move SQLConnection.sServer           to sServer

        // FileDSN - read DATABASE name from DSN ini-file
        If (Uppercase(sServer) contains ("." + String(CS_SQLIniDSNKeyword))) Begin
            Get Create (RefClass(cIniFile)) to hoIniFile
            Set psFileName of hoIniFile to sServer
            Get ReadString of hoIniFile CS_SQLODBCIniSectionName CS_SQLIniDatabaseKeyword "" to sDatabase
            Move sDatabase to sReturnArray[0].sDatabaseName
            Send Destroy of hoIniFile
        End

        // DSN - read DATABASE name from the registry
        Else Begin
            Get Create (RefClass(cRegistry)) to hoRegistry

            // We start with checking the "System DNS" area in the registry as it is the
            // most probably place the info is kept that we're after.
            Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
            Set pfAccessRights of hoRegistry to Key_Read
            // One path: Windows shows a 32-bit program the 32-bit list there, a 64-bit program the 64-bit one. (The
            // Wow6432Node key was read whenever it existed, so a 64-bit program listed the 32-bit data sources.)
            Move "SOFTWARE\ODBC\ODBC.INI" to sKey

            Get KeyExists of hoRegistry sKey to bExists
            If (bExists) Begin
                Get OpenKey of hoRegistry sKey to bKeyOpened
                If (bKeyOpened) Begin
                    Get Create (RefClass(Array)) to hoODBCDataSources
                    Get GetSubkeys of hoRegistry hoODBCDataSources to iDataSources
                    If (iDataSources > 0) Begin
                        Move (ResizeArray(sDataSources, iDataSources)) to sDataSources
                        Decrement iDataSources
                        for iCount from 0 to iDataSources
                            Get Value of hoODBCDataSources iCount to sDataSources[iCount]
                        Loop
                        Move 0 to iItem
                        for iCount from 0 to iDataSources
                            Move sDataSources[iCount] to sSubKey
                            Get OpenKey of hoRegistry (sKey + "\" + String(sSubKey)) to bKeyOpened
                            If (bKeyOpened = True) Begin
                                Get ValueExists of hoRegistry CS_SQLIniDatabaseKeyword to bExists
                                If (bExists = True) Begin
                                    Move sSubKey to sReturnArray[iItem].sServerName
                                    Get ReadString of hoRegistry CS_SQLIniDatabaseKeyword to sReturnArray[iItem].sDatabaseName
                                    Increment iItem
                                End
                                // Each sub-key is closed again. (Only the last one was.)
                                Send CloseKey of hoRegistry
                            End
                        Loop
                    End
                    Send CloseKey of hoRegistry
                    Send Destroy of hoODBCDataSources
                End
            End

            // We then check the "User DNS" area in the registry.
            Set phRootKey of hoRegistry to HKEY_CURRENT_USER
            Set pfAccessRights of hoRegistry to Key_Read
            Move "SOFTWARE\ODBC\ODBC.INI" to sKey
            Get KeyExists of hoRegistry sKey to bExists

            If (bExists) Begin
                Get OpenKey of hoRegistry sKey to bKeyOpened
                If (bKeyOpened) Begin
                    Get Create (RefClass(Array)) to hoODBCDataSources
                    Get GetSubkeys of hoRegistry hoODBCDataSources to iDataSources
                    If (iDataSources > 0) Begin
                        Move (ResizeArray(sDataSources, iDataSources)) to sDataSources
                        Decrement iDataSources
                        for iCount from 0 to iDataSources
                            Get Value of hoODBCDataSources iCount to sDataSources[iCount]
                        Loop
                        for iCount from 0 to iDataSources
                            Move sDataSources[iCount] to sSubKey
                            Get OpenKey of hoRegistry (sKey + "\" + String(sSubKey)) to bKeyOpened
                            If (bKeyOpened = True) Begin
                                Get ValueExists of hoRegistry CS_SQLIniDatabaseKeyword to bExists
                                If (bExists = True) Begin
                                    Move sSubKey to sReturnArray[iItem].sServerName
                                    Get ReadString of hoRegistry CS_SQLIniDatabaseKeyword to sReturnArray[iItem].sDatabaseName
                                    Increment iItem
                                End
                                // Each sub-key is closed again. (Only the last one was.)
                                Send CloseKey of hoRegistry
                            End
                        Loop
                    End
                    Send CloseKey of hoRegistry
                    Send Destroy of hoODBCDataSources
                End
            End

            Send Destroy of hoRegistry
        End

        Function_Return sReturnArray
    End_Function

    // Returns the proper Sql language key word(s) for the passed SQL key-word constant
    Function _SqlFindKeyWord Integer iSQLKeywordConstant Returns String
        String sRetval
        Integer iDbType iIndex
        tSQLKeyWords[] SQLKeywordArray
        tSQLKeyWords   SQLKeyWords

        // Sql back-end type. E.g. MS-SQL, MySQL, Oracle, DB2...
        Move "" to sRetval
        Get piDbType to iDbType
        Move iDbType             to SQLKeyWords.iSQLDbType
        Move iSQLKeywordConstant to SQLKeyWords.iSQLWord

        Get paSQLKeywordArray to SQLKeywordArray
        Move (SearchArray(SQLKeyWords, SQLKeywordArray, Self, RefFunc(CompareFindSQLKeyWords))) to iIndex
        If (iIndex >= 0) Begin
            Move SQLKeywordArray[iIndex].sSQLPhrase to sRetval
        End

        Function_Return sRetval
    End_Function

    // Takes the comments out of a script - "/* ... */", also over several lines, and "--" to the end of a line, but
    // not inside a text in quotes - and keeps the code around them; then drops the blank lines and the PRINT lines.
    // (A line that held "*/" was dropped whole, code and all, and "--" in a text was taken for a comment.)
    Function _SqlUtilSanitizeScript tSQLScriptArray SqlScriptArray Returns tSQLScriptArray
        String[] sSQLScriptArray
        String sLine sOut sChar sNext
        Integer iSize iCount iPos iLength
        Boolean bInComment bInText

        Move False to bInComment
        Move (SizeOfArray(SqlScriptArray.sSQLScriptArray)) to iSize
        For iCount from 0 to (iSize - 1)
            Move SqlScriptArray.sSQLScriptArray[iCount] to sLine
            Move "" to sOut
            Move False to bInText
            Move (Length(sLine)) to iLength
            Move 1 to iPos
            While (iPos <= iLength)
                Move (Mid(sLine, 1, iPos)) to sChar
                Move (Mid(sLine, 1, (iPos + 1))) to sNext
                If (bInComment = True) Begin
                    If (sChar = "*" and sNext = "/") Begin
                        Move False to bInComment
                        Increment iPos
                    End
                End
                Else If (bInText = False and sChar = "/" and sNext = "*") Begin
                    Move True to bInComment
                    Increment iPos
                End
                Else If (bInText = False and sChar = "-" and sNext = "-") Begin
                    Move iLength to iPos
                End
                Else Begin
                    If (sChar = "'") Begin
                        Move (not(bInText)) to bInText
                    End
                    Move (sOut + sChar) to sOut
                End
                Increment iPos
            Loop
            If (Trim(sOut) <> "" and Uppercase(Left(Trim(sOut), 6)) <> "PRINT ") Begin
                Move (Rtrim(sOut)) to sSQLScriptArray[SizeOfArray(sSQLScriptArray)]
            End
        Loop

        Move sSQLScriptArray to SqlScriptArray.sSQLScriptArray
        Function_Return SqlScriptArray
    End_Function

    // Helper function that builds a string like;
    // "SELECT name from [Master].[sys].[databases] where name"
    Function _SqlSelectFromWhereName Returns String
        String sRetval sSelect sName sFrom sMaster sSys sDatabases sWhere sDBO

        Get _SqlFindKeyWord CI_SQLSelect       to sSelect
        Get _SqlFindKeyWord CI_SQLName         to sName
        Get _SqlFindKeyWord CI_SQLDBO          to sDBO
        Get _SqlFindKeyWord CI_SQLFrom         to sFrom
        Get _SqlFindKeyWord CI_SQLMaster       to sMaster
        Get _SqlFindKeyWord CI_SQLSys          to sSys
        Get _SqlFindKeyWord CI_SQLDatabases    to sDatabases
        Get _SqlFindKeyWord CI_SQLWhere        to sWhere
        Move (sSelect * sName * sFrom * "[" + sMaster + "].[" + sDBO + "].[" + sSys + sDatabases + "]" * sWhere * sName) to sRetval
        Function_Return sRetval
    End_Function

    // Formats a columns iLenght & iDecimal parameters as SQL expects them in a string.
    // E.g. (4,2), where 4 is the iLength and 2 the iDecimals param.
    Function _SqlFormatLengthAndDecimalAsString Integer iLength Integer iDecimals Returns String
        String sRetval
        If (iLength <> 0) Begin
            Move ("(" + String(iLength)) to sRetval
            If (iDecimals <> 0) Begin
                Move (sRetval + "," + String(iDecimals)) to sRetval
            End
            Move (sRetval + ")") to sRetval
        End
        Function_Return sRetval
    End_Function

    // Checks that the passed sDriverID is defined.
    // Also checks if the driver has been loaded; else it gets loaded.
    Function _SqlCheckCurrentDriver String sDriverID Returns Boolean
        Boolean bOK
        Integer iDriver

        If (sDriverID = DATAFLEX_ID) Begin
            Function_Return False
        End

        Get IsDAWSQLDriver sDriverID to bOK

        If (bOK = False) Begin
            Error DFERR_PROGRAM "Driver needs to be one of MSSQLDRV, DB2_DRV, or ODBC_DRV"
            Function_Return False
        End

        Get DriverIndex sDriverID to iDriver
        If (iDriver = 0) Begin
            Load_Driver sDriverID
        End

        Function_Return True
    End_Function

    Function _SqlProperTableName String sTableName Returns String
        String sVal sSchema sDriverID
        Integer iDbType

        If (Trim(sTableName) = "") Begin
            Function_Return ""
        End

        Get psDriverID to sDriverID
        Get piDbType   to iDbType
        If (iDbType = EN_dbTypeOracle) Begin
            Get psUserID to sSchema
            // Not sure about this uppercasing but it seems like Oracle wants that?
            Move (Uppercase(sSchema)) to sSchema
            Move ('"' + sSchema + '"."' + sTableName + '"') to sTableName
            Function_Return sTableName
        End
        If (iDbType = EN_DbTypeMySQL) Begin
            Get psDatabase to sVal
            Move (sVal + "." + sTableName) to sTableName
            Function_Return sTableName
        End
        If (iDbType = EN_DbTypePostgre) Begin
            Move ('"' + sTableName + '"') to sTableName
            Function_Return sTableName
        End

        Get psSchema to sSchema
        If (sSchema = "") Begin
            Get _SqlFindKeyWord CI_SQLDBO to sSchema
        End

        // Both in capitals. (An uppercased name was looked through for the schema as it was.)
        Move (Uppercase(sTableName)) to sVal
        If (not(sVal contains (Uppercase(sSchema) + "."))) Begin
            If (iDbType = EN_dbTypeDB2) Begin
                Move (Lowercase(sSchema) + "." + sTableName) to sTableName
            End
            Else Begin
                Move (sSchema + "." + sTableName) to sTableName
            End
        End

        Function_Return sTableName
    End_Function

    // A name for an SQL statement: for MS SQL in brackets, a "]" in it doubled, so a blank or a reserved word in the
    // name is no problem. Other back ends get the name as it is - quotes would make a DB2 name case-sensitive. A
    // name in brackets already stays as it is.
    Function SqlQuotedName Integer iDbType String sName Returns String
        If (iDbType <> EN_DbTypeMSSQL or (Left(sName, 1) = "[" and Right(sName, 1) = "]")) Begin
            Function_Return sName
        End
        Function_Return ("[" + Replaces("]", sName, "]]") + "]")
    End_Function

    // A value for an SQL statement: in quotes, a quote in it doubled - O'Brien is a value, not the end of the text.
    Function SqlQuotedValue String sValue Returns String
        Function_Return ("'" + Replaces("'", sValue, "''") + "'")
    End_Function

    // Is the text one word of letters, digits and underscores - a collation name, for instance - that can go into a
    // statement as it is? (A collation typed in a dialog went in as it was: anything after it ran on the server.)
    Function _SqlIsSafeSqlWord String sWord Returns Boolean
        Integer iPos iChar

        If (sWord = "") Begin
            Function_Return False
        End
        For iPos from 1 to (Length(sWord))
            Move (Ascii(Mid(sWord, 1, iPos))) to iChar
            If (not((iChar >= 48 and iChar <= 57) or (iChar >= 65 and iChar <= 90) or (iChar >= 97 and iChar <= 122) or iChar = 95)) Begin
                Function_Return False
            End
        Loop
        Function_Return True
    End_Function

    // The start of a quiet section: error iError is neither shown nor logged - under DataFlex's standard error
    // object (Ignore_Error) and under cDbUpdateHandler, which takes Ignore_Error for nothing and reads
    // Error_Report_Mode instead. Returns the report mode it found, for _UtilQuietEnd. (The library used one way or
    // the other, each working under one error handler only.)
    Function _UtilQuietBegin Integer iError Returns Integer
        Integer iMode

        Get Error_Report_Mode to iMode
        Set Error_Report_Mode to DUF_ERROR_NO_REPORT
        Send Ignore_Error of Error_Object_Id iError
        Function_Return iMode
    End_Function

    // The end of a quiet section: error iError is trapped again, and the report mode is the one _UtilQuietBegin found.
    Procedure _UtilQuietEnd Integer iError Integer iMode
        Send Trap_Error of Error_Object_Id iError
        Set Error_Report_Mode to iMode
    End_Procedure

    // SQL column names can be case-sensitive. This function is used to check that
    // the passed sFieldName has the correct spelling.
    // Used with Embedded SQL statement calls.
    // If the spelling or fieldname doesn't exist, the return value is "" (blank).
    Function _SqlFindColumnName String sTableName String sColumnName Returns String
        String sRetval sDriverID
        String[] asColumnNamesArray
        Integer iIndex 

        Move "" to sRetval
        Get psDriverID to sDriverID
        Get _SqlUtilEnumerateColumns sDriverID sTableName to asColumnNamesArray
        // The column is looked for. (The table name was: nothing was ever found.)
        Move (SearchArray(sColumnName, asColumnNamesArray, Desktop, (RefFunc(DFSTRICMP)))) to iIndex
        If (iIndex <> -1) Begin
            Move asColumnNamesArray[iIndex] to sRetval
        End

        Function_Return sRetval
    End_Function

    Function _SqlColumnNumberToColumnName String sTableName Integer iColumn Returns String
        String sRetval sDriverID
        String[] asColumnNamesArray

        Move "" to sRetval
        Get psDriverID to sDriverID
        Get _SqlUtilEnumerateColumns sDriverID sTableName to asColumnNamesArray
        If (iColumn > -1 and iColumn < SizeOfArray(asColumnNamesArray)) Begin
            Move asColumnNamesArray[iColumn] to sRetval
        End

        Function_Return sRetval
    End_Function

    { Visibility=Private }
    Function _SqlDatabasesArrayMSSQL Returns String[]
        String[] sReturnArray
        Handle hoSQLHandler
        Integer iCount iSize iItem
        String sServer
        tSQLConnection SQLConnection

        Get phoMSSQLHandler to hoSQLHandler
        Send Delete_Data    of hoSQLHandler
        Get pSQLConnection  of ghoSQLConnectionHandler to SQLConnection

        Send Ignore_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL
        Get EnumerateDatabasesEncrypt of hoSQLHandler SQLConnection.sServer SQLConnection.sUserID SQLConnection.sPassword SQLConnection.bTrustedCertificate SQLConnection.eEncryptOption to iSize
        Decrement iSize

        For iCount from 0 to iSize
            Get String_Value of hoSQLHandler iCount to sServer
            Move (Trim(sServer)) to sReturnArray[iItem]
            Increment iItem
        Loop

        Send Trap_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL

        Function_Return sReturnArray
    End_Function

    Function _SqlTableArrayDAW Returns String[]
        String[] asSQLTables
        String sTable sTableType sSchema sDefSchema sComment sTableKeyWord sSysKeyWord sConnectionString
        Handle hoSQLHandler
        Integer iCount iSize iItem
        Boolean bOK
        tSQLConnection SQLConnection

        Get pSQLConnection of ghoSQLConnectionHandler to SQLConnection
        If (SQLConnection.sConnectionString = "") Begin
            Function_Return asSQLTables
        End
        // The list is made once. (The cache was looked at after the login error was switched off, and that was
        // not switched on again: failed logins stayed silent for the rest of the program.)
        Get pasSQLDataTables to asSQLTables
        If (SizeOfArray(asSQLTables) <> 0) Begin
            Function_Return asSQLTables
        End

        Move SQLConnection.sSchema      to sDefSchema
        Move (Uppercase(sDefSchema))    to sDefSchema
        Get _SqlFindKeyWord CI_SQLTable to sTableKeyWord
        Get _SqlFindKeyWord CI_SQLSys   to sSysKeyWord

        Get phoCLIHandler to hoSQLHandler
        Set psDriverID    of hoSQLHandler to SQLConnection.sDriverID
        Send Delete_Data  of hoSQLHandler

        Send Ignore_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL
        Move SQLConnection.sConnectionString to sConnectionString

        Get EnumerateTables of hoSQLHandler sConnectionString to iSize
        Move False to Err
        Move 0 to iItem

        // Note that the enumeration starts from table no 1. (not zero)
        For iCount from 1 to iSize
            Get TableName    of hoSQLHandler iCount to sTable
            Get TableType    of hoSQLHandler iCount to sTableType
            Get SchemaName   of hoSQLHandler iCount to sSchema
            If (sSchema = "") Begin
                Get _SqlFindKeyWord CI_SQLDBO to sSchema
            End
            Get TableComment of hoSQLHandler iCount to sComment
            Move (Trim(sTable)) to sTable
            If (SQLConnection.sDriverID = DB2_DRV_ID) Begin
                Move (sTable <> "" and Uppercase(sTableType) = sTableKeyWord and Uppercase(sSchema) = sDefSchema) to bOK
            End
            Else Begin
                Move (sTable <> "" and Uppercase(sTableType) = sTableKeyWord and Uppercase(sSchema) <> sSysKeyWord and Uppercase(sSchema) <> "SYSTOOLS") to bOK
            End
            If (bOK = True) Begin
                Move sTable to asSQLTables[iItem]
                Increment iItem
            End
        Loop

        Send Trap_Error of Error_Object_Id CLIERR_LOGIN_UNSUCCESSFUL

        Set pasSQLDataTables to asSQLTables
        Function_Return asSQLTables
    End_Function

    Function _SqlUtilUpdateIntFile Integer hTable Returns Boolean
        String sWorkFolder
        String sOrgFormat sNewFormat sRootName sTableName sDriverID
        Boolean bOpened bOK

        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _TableNameOnly sRootName to sTableName
        Move CS_OEM_Txt  to sOrgFormat
        Move CS_ANSI_Txt to sNewFormat
        Get AutoConnectionIDLogin to bOK

        // It seems this can be called to quickly; causing a 13001 error "Cannot open cache file for write"
        Get _UtilDeleteCacheFile sTableName to bOK
        Get_Attribute DF_FILE_OPENED of hTable to bOpened
        If (bOpened = False and UtilTableIsSafeToOpen(Self, hTable)) Begin
            Open hTable
            Get_Attribute DF_FILE_OPENED of hTable to bOpened
        End
        If (bOpened = False) Begin
            Function_Return False
        End

        Get psDriverID to sDriverID
        Get_Attribute DF_FILE_TABLE_CHARACTER_FORMAT of hTable to sOrgFormat
        Move (Uppercase(sOrgFormat)) to sOrgFormat
        // Lets swap the OEM/ANSI format, just to make a change in Structure_Start below (and back),
        // to "touch" the table so the driver feels there has been a change and updates the .int file.
        Move (If(sOrgFormat = CS_OEM_Txt, CS_ANSI_Txt, CS_OEM_Txt)) to sNewFormat
        Move False to Err

        If (hTable > 0) Begin
            Get _StructureWorkFolder hTable to sWorkFolder
            Structure_Start hTable
                Set_Attribute DF_FILE_TABLE_CHARACTER_FORMAT of hTable to sNewFormat
                Set_Attribute DF_FILE_TABLE_CHARACTER_FORMAT of hTable to sOrgFormat
            Structure_End hTable DF_STRUCTEND_OPT_FORCE sWorkFolder ghoDbUpdateHandler
        End
        Else Begin
            Set_Attribute DF_FILE_TABLE_CHARACTER_FORMAT of hTable to sNewFormat
            Set_Attribute DF_FILE_TABLE_CHARACTER_FORMAT of hTable to sOrgFormat
        End
        Function_Return (Err = False)
    End_Function

    // Subfunction to the ApiTableUpdate function (et al)
    Function _UtilTableCheckChangeFilelistNames tAPITableNameInfo APITableNameInfoFrom Boolean bIsSQLTableTo Returns Boolean
        Handle hTable
        String sConnectionID sRootName sLogicalName sDisplayName sBareTo sBareFrom
        Boolean bTableExists bSameTableNames bANSI bOK bChangeRoot

        Get _ApiTableFilelistNamesCompare True APITableNameInfoFrom to bSameTableNames
        If (bSameTableNames = True) Begin
            Function_Return True
        End

        Move True to bOK
        Move APITableNameInfoFrom.iTableNumber  to hTable
        Set Private.phCurrentTable              to hTable
        
        Get_Attribute DF_FILE_ROOT_NAME         of hTable to sRootName
        Move (sRootName <> APITableNameInfoFrom.sRootName) to bChangeRoot
        // An SQL table under a description for an embedded table stays on SQL (ApiTableUpdate): it keeps its root
        // name with the driver when the names are the same without it. (It was given the bare embedded name.)
        If (bChangeRoot = True and APITableNameInfoFrom.bIsSQL = False and (sRootName contains ":")) Begin
            Get _TableNameOnly sRootName                        to sBareTo
            Get _TableNameOnly APITableNameInfoFrom.sRootName   to sBareFrom
            Move (Uppercase(sBareTo) <> Uppercase(sBareFrom)) to bChangeRoot
        End
        If (bChangeRoot = True) Begin
            Set_Attribute DF_FILE_ROOT_NAME     of hTable to APITableNameInfoFrom.sRootName
        End
        
        Get_Attribute DF_FILE_LOGICAL_NAME      of hTable to sLogicalName
        If (sLogicalName <> APITableNameInfoFrom.sLogicalName) Begin
            Set_Attribute DF_FILE_LOGICAL_NAME  of hTable to APITableNameInfoFrom.sLogicalName
        End
        
        Get_Attribute DF_FILE_DISPLAY_NAME      of hTable to sDisplayName
        If (sDisplayName <> APITableNameInfoFrom.sDisplayName) Begin
            Set_Attribute DF_FILE_DISPLAY_NAME  of hTable to APITableNameInfoFrom.sDisplayName
        End

        If (APITableNameInfoFrom.bIsSQL = True) Begin
            Get psConnectionID to sConnectionID
            Get _UtilTableExists hTable to bTableExists
            If (bTableExists = True) Begin
                Get _SqlUtilUpdateIntFile hTable to bOK
            End
            Else Begin
                Get pbToANSI to bANSI
                Get _SqlUtilCreateIntFile hTable APITableNameInfoFrom.sDriverID sConnectionID bANSI False True to bOK
            End
        End

        Function_Return bOK
    End_Function

    // The table must already exist in the filelist for this function to work.
    // It creates an .int file in the first Data folder of the psDataPath property. 
    // It is important that the hTable can be opened.
    Function _SqlUtilCreateIntFile Handle hTable String sDriverID String sConnectionID Boolean bAnsi Boolean bSysFile Boolean bBackup Returns Boolean
        String sWorkFolder
        Boolean bOK bExists bUseConnectionID bOpen 
        String sDataPath sRootName sLogicalName sPhysicalFileName sConnectionString sTableName sSchemaName sANSI_OEM 
        String[] asIndexArray
        Integer iCount iCh iSize iRetval
        Handle hTableOrg

        Move (Trim(sConnectionID) <> "") to bUseConnectionID
        Get psConnectionString to sConnectionString

        Move CS_ANSI_Txt to sANSI_OEM
        If (bANSI = False) Begin
            Move CS_OEM_Txt to sANSI_OEM
        End

        Get psDataPathFirstPart to sDataPath
        Get vFolderExists sDataPath to bOK
        If (bOK = False) Begin
            Error DFERR_PROGRAM "Function _SqlUtilCreateIntFile; psDataPath not found!"
            Function_Return False
        End
        Get vFolderFormat sDataPath to sDataPath

        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _TableNameOnly sRootName to sTableName
        Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sLogicalName
        Move sLogicalName  to sPhysicalFileName
        Move (sPhysicalFileName + ".int") to sPhysicalFileName

        Get psSchema hTable to sSchemaName
        If (sSchemaName = "") Begin
            Get _SqlFindKeyWord CI_SQLDBO to sSchemaName
        End
        
        If (bBackup = True) Begin
            // If the .int file already exists; we rename it to "FileName" + ".bak"
            Get vFilePathExists (sDataPath + sPhysicalFileName) to bExists
            If (bExists = True) Begin
                Get vRenameFile (sDataPath + sPhysicalFileName) (sDataPath + sPhysicalFileName + ".bak") to iRetval
            End
        End 
        Else Begin
            Get vDeleteFile (sDataPath + sPhysicalFileName) to iRetval
        End

        Get _UtilDeleteCacheFile sTableName to bOK
        Get _SqlUtilEnumerateIndexes sTableName sDriverID to asIndexArray

        // The result is that of writing the file and its restructure. (It was the result of the cache file.)
        Move False to Err
        Get Seq_Open_Output_Channel (sDataPath + sPhysicalFileName) to iCh
        If (iCh < 0) Begin 
            Error DFERR_PROGRAM "No free channel for creating output file. (Routine: _SqlUtilCreateIntFile)"
            Function_Return False
        End
        
        Writeln channel iCh CS_DRIVER_NAME     " " sDriverID
        If (bUseConnectionID = True) Begin
            Writeln channel iCh CS_SERVER_NAME " " CS_DFCONNID "=" sConnectionID
        End
        Else Begin
            Writeln channel iCh CS_SERVER_NAME " " CS_SERVER "=" sConnectionString
        End
        Writeln channel iCh CS_DATABASE_NAME          " " (Uppercase(sTableName))
        Writeln channel iCh CS_SCHEMA_NAME            " " (Lowercase(sSchemaName)) 
        Writeln channel iCh ""
        // There seems to be a new order how these are set from DF19.
        If (bSysFile = True) Begin
            Writeln channel iCh CS_SYSTEM_FILE        " " "YES"
            Writeln channel iCh CS_RECNUM_TABLE       " " "NO"
        End
        Writeln channel iCh CS_TABLE_CHARACTER_FORMAT " " sANSI_OEM
        Writeln channel iCh CS_USE_DUMMY_ZERO_DATE    " " "YES" // ToDo: We maybe need to paramerize this setting?

        If (bSysFile = False) Begin
            Move (SizeOfArray(asIndexArray)) to iSize
            Move (SortArray(asIndexArray)) to asIndexArray
            If (iSize > 0) Begin
                Writeln channel iCh (CS_PRIMARY_INDEX * String("0"))
                Writeln channel iCh "" // Just an empty line
            End
            Decrement iSize
            for iCount from 0 to iSize
                Writeln channel iCh (CS_INDEX_NUMBER * String(iCount))
                Writeln channel iCh (CS_INDEX_NAME   * String(asIndexArray[iCount]))
                Writeln channel iCh ""
            Loop
        End

        // Flush_Output is a DataFlex 20 command; Close_Output writes what is left on every version.
        #IF (!@ > 191)
            Flush_Output channel iCh
        #ENDIF
        Close_Output channel iCh
        Send Seq_Close_Channel iCh 
        
        // The table has a new .int file: what UtilTableIsSafeToOpen found for the old one is forgotten.
        Send _UtilSafeOpenForget

        // There might be a bug in the MSSQLDRV driver, because if we create an .int file for a sysfile
        // a Structure_Start/End *always* removes the line "RECNUM_TABLE NO", even if it shouldn't.
        If (bSysFile = False) Begin
            Open hTable
            Move hTable to hTableOrg
            Get_Attribute DF_FILE_OPENED of hTable to bOpen
            If (bOpen = True) Begin
                Get _StructureWorkFolder hTable to sWorkFolder
                Structure_Start hTable sDriverID
                Structure_End hTable DF_STRUCTEND_OPT_FORCE sWorkFolder ghoDbUpdateHandler
                Set Message_Text of ghoStatusPanel to ("Table number:" * String(hTableOrg))
            End
        End

        Function_Return (Err = False)
    End_Function 
    
    // Simplier version of the _SqlUtilCreateIntFile. It can be used if there might be something wrong with the .int file and it needs
    // to be refreshed by the driver. 
    Function _SqlUtilRefreshIntFile Handle hTable String sDriverID String sConnectionID Boolean bAnsi Boolean bSysFile Returns Boolean        
        String sWorkFolder
        Boolean bErr
        Integer iLastErr iErrLine
        
        Move Err to bErr
        Move LastErr to iLastErr
        Move ErrLine to iErrLine
        Move False to Err
        If (UtilTableIsSafeToOpen(Self, hTable)) Begin
            Open hTable
        End
        Else Begin
            Move True to Err
        End
        If (Err = True) Begin 
            Error DFERR_PROGRAM ("The table:" * String(hTable) * "could not be opened")
            Move bErr to Err
            Move iLastErr to LastErr
            Move iErrLine to ErrLine
            Function_Return False
        End
        
        Get _StructureWorkFolder hTable to sWorkFolder
        Structure_Start hTable
        Structure_End hTable DF_STRUCTEND_OPT_FORCE sWorkFolder ghoDbUpdateHandler

        If (Err = True) Begin  
            Error DFERR_PROGRAM ("The table:" * String(hTable) * "could not restructered properly. Error:" * String(LastErr))
            Move bErr to Err
            Move iLastErr to LastErr
            Move iErrLine to ErrLine
            Function_Return False
        End
        Function_Return True
    End_Function

    // Removes the cache file (.cch) of a table from the first data folder. True when it is gone - also when there
    // was none. (It answered the result of vDeleteFile, which is 0 when the file is gone: the other way round.)
    Function _UtilDeleteCacheFile String sTableName Returns Boolean
        String sDataPath
        Integer iPos iRetval
        Boolean bExists

        If (sTableName contains ".") Begin
            Move (Pos(".", sTableName)) to iPos
            Move (Mid(sTableName, Length(sTableName), (iPos +1))) to sTableName
        End

        Get psDataPathFirstPart to sDataPath
        Get vFilePathExists (sDataPath + sTableName + ".cch") to bExists
        If (bExists = False) Begin
            Function_Return True
        End
        Get vDeleteFile (sDataPath + sTableName + ".cch") to iRetval
        Function_Return (iRetval = 0)
    End_Function

    // Collects all tables from the SQL Database backend and sets the pasSQLTables property.
    Procedure UtilFillSQLTables
        String[] asSQLTables
        String sDataBase

        Get psDatabase to sDataBase
        If (sDataBase = "") Begin
            Set pasSQLDataTables to asSQLTables
            Procedure_Return
        End
        Get _SqlUtilEnumerateTables MSSQLDRV_ID sDataBase "" to asSQLTables
        Set pasSQLDataTables to asSQLTables
    End_Procedure  
    
    Procedure ResetFillSQLTables
        String[] asSQLTables
        Set pasSQLDataTables to asSQLTables
    End_Procedure
    
    // This collects *all* filelist entries and sets the pFileListArray struct property.
    Procedure UtilFillFileListStruct Boolean ByRef bCancel
        tFilelist[] Tables
        String sRootName sLogicalName sDisplayName sDriver sNoDriverRootname
        Handle hTable
        Integer iItem iLastErr iErrLine
        Boolean bIsSystem bIsAlias bOpened bErr
        
        // Refresh Data reads the .int files again: one of them may have been mended since.
        Send _UtilSafeOpenForget
        Move 0 to iItem
        Move 0 to hTable 
        Move Err to bErr
        Move LastErr to iLastErr
        Move ErrLine to iErrLine
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable 
            Send DoAdvance of ghoProgressBar
            // 0 = no more table in Filelist.cfg, 50 = Flexerrs.
            If (hTable <> 0 and hTable <> 50) Begin  
                Move False to Err
                Move False to bIsSystem
                Get_Attribute DF_FILE_ROOT_NAME    of hTable to sRootName
                Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sLogicalName
                Get _DriverIDFromRootName sRootName to sDriver
                Set Message_Text of ghoStatusPanel to ("Reading table" * String(hTable) * "LogicalName =" * sLogicalName)
                Move False to bIsSystem
                // A table whose .int file would crash the MS SQL driver stays closed: it is an open error.
                If (UtilTableIsSafeToOpen(Self, hTable)) Begin
                    Open hTable
                End
                Get_Attribute DF_FILE_OPENED of hTable to bOpened
                If (bOpened = True) Begin
                    Get_Attribute DF_FILE_IS_SYSTEM_FILE of hTable to bIsSystem
                End
                Close hTable
                Get_Attribute DF_FILE_DISPLAY_NAME of hTable to sDisplayName
                Get _TableNameOnly sRootName to sNoDriverRootname
                Move hTable              to Tables[iItem].hTable
                Move sRootName           to Tables[iItem].sRootName
                Move sLogicalName        to Tables[iItem].sLogicalName
                Move sDisplayName        to Tables[iItem].sDisplayName
                Move sNoDriverRootname   to Tables[iItem].sNoDriverRootname
                Move sDriver             to Tables[iItem].sDriver 
                Move bIsSystem           to Tables[iItem].bIsSystemFile
                Move (bOpened = False)   to Tables[iItem].bErrorOpening
                Get _IsAliasTable hTable to Tables[iItem].bIsAlias 
                Move False to Err
                Increment iItem
            End 
            Get Check_StatusPanel of ghoStatusPanel to bCancel
            If (bCancel = True) Begin
                Procedure_Return 
            End
        Until (hTable = 0)
        
        Move bErr to Err
        Move iLastErr to LastErr
        Move iErrLine to ErrLine
        Set Message_Text of ghoStatusPanel to ""
        Set pFileListArray to Tables
    End_Procedure   
    
    // Special array search function for the tFilelistLogicalName struct.
    // Used by e.g. UtilAliasToMasterTableHandle
    Function CompareFileListTable tFilelistLogicalName FileListTable1 tFilelistLogicalName FileListTable2 Returns Integer
        If (Lowercase(FileListTable1.sLogicalName) < Lowercase(FileListTable2.sLogicalName)) ;
            Function_Return (LT)
        If (Lowercase(FileListTable1.sLogicalName) > Lowercase(FileListTable2.sLogicalName)) ;
            Function_Return (GT)

        If (Lowercase(FileListTable1.sNoDriverRootname) < Lowercase(FileListTable2.sNoDriverRootname)) ;
            Function_Return (LT)
        If (Lowercase(FileListTable1.sNoDriverRootname) > Lowercase(FileListTable2.sNoDriverRootname)) ;
            Function_Return (GT)
            
        Function_Return (EQ)
    End_Function

    // Finds the corresponding Master table for the passed Alias handle
    Function UtilAliasToMasterTableHandle Handle hTable Returns Handle
        Handle hMasterTable
        String sRootNameAlias sNoDriverRootnameAlias
        Boolean bIsAlias bFound bIsIntTable
        Integer iItem
        tFilelistLogicalName[] FilelistLogicalTables
        tFilelistLogicalName FileListTable
        
        Get _IsAliasTable hTable to bIsAlias
        If (bIsAlias = False) Begin
            Function_Return 0
        End
        
        Move 0 to hMasterTable
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootNameAlias 
        Get _TableNameOnly sRootNameAlias to sNoDriverRootnameAlias
        Get _IsIntEntry hTable to bIsIntTable
        Get pFilelistLogicalTables  to FilelistLogicalTables
        Move sNoDriverRootnameAlias to FileListTable.sLogicalName
        Move sNoDriverRootnameAlias to FileListTable.sNoDriverRootname
        Move (SearchArray(FileListTable, FilelistLogicalTables, Self, (RefFunc(CompareFileListTable)))) to iItem
        If (iItem = -1) Begin
            Function_Return 0
        End
        Move (Lowercase(sNoDriverRootnameAlias) = Lowercase(FilelistLogicalTables[iItem].sNoDriverRootname) and Lowercase(FilelistLogicalTables[iItem].sNoDriverRootname) = Lowercase(FilelistLogicalTables[iItem].sLogicalName)) to bFound
        If (bFound = True) Begin
            Move FilelistLogicalTables[iItem].hTable to hMasterTable
            Function_Return hMasterTable
        End
        
        Function_Return hMasterTable
    End_Function
     
    Function pFilelistLogicalTables Returns tFilelistLogicalName[]
        tFilelistLogicalName[] FilelistLogicalTables
        tFilelist[] FileListTables
        Integer iSize iCount
        
        Get pFileListArray to FileListTables
        Move (SizeOfArray(FileListTables)) to iSize
        Decrement iSize
        for iCount from 0 to iSize
            Move FileListTables[iCount].bErrorOpening       to FilelistLogicalTables[iCount].bErrorOpening    
            Move FileListTables[iCount].bIsAlias            to FilelistLogicalTables[iCount].bIsAlias
            Move FileListTables[iCount].bIsSystemFile       to FilelistLogicalTables[iCount].bIsSystemFile
            Move FileListTables[iCount].hTable              to FilelistLogicalTables[iCount].hTable
            Move FileListTables[iCount].sDisplayName        to FilelistLogicalTables[iCount].sDisplayName
            Move FileListTables[iCount].sDriver             to FilelistLogicalTables[iCount].sDriver
            Move FileListTables[iCount].sLogicalName        to FilelistLogicalTables[iCount].sLogicalName
            Move FileListTables[iCount].sNoDriverRootname   to FilelistLogicalTables[iCount].sNoDriverRootname
            Move FileListTables[iCount].sRootName           to FilelistLogicalTables[iCount].sRootName
        Loop
        Move (SortArray(FilelistLogicalTables)) to FilelistLogicalTables
        Function_Return FilelistLogicalTables
    End_Function 
    
    // The folder of the data path that holds the data file of an embedded table, with a backslash at the end,
    // or "" when none does. The data path can name several folders; they are looked at in their order.
    Function _UtilEmbeddedTableFolder String sRootName Returns String
        String sDataPath sFolder
        Integer iPaths iPath
        Boolean bExists

        Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
        Get CountOfPaths of (phoWorkspace(ghoApplication)) sDataPath to iPaths
        For iPath from 1 to iPaths
            Get PathAtIndex of (phoWorkspace(ghoApplication)) sDataPath iPath to sFolder
            Get vFolderFormat sFolder to sFolder
            Get vFilePathExists (sFolder + sRootName + ".dat") to bExists
            If (bExists = True) Begin
                Function_Return sFolder
            End
        Loop
        Function_Return ""
    End_Function

    // Is the data file of an embedded table in the data path? The data path can name several folders, so each
    // of them is looked at. (The whole path used to be taken for one folder name. With two folders no table
    // was found, and a table that is not found is created.)
    Function _UtilEmbeddedTableFileExists String sRootName Returns Boolean
        String sFolder

        Get _UtilEmbeddedTableFolder sRootName to sFolder
        Function_Return (sFolder <> "")
    End_Function

    // Is the root name that of a table of a database driver? A driver prefix in front - MSSQLDRV:Customer - or an
    // .int file - Customer.int. A drive in front - C:\Data\Customer - is a folder: a driver id is longer than one
    // letter.
    Function _UtilRootNameIsDriverTable String sRootName Returns Boolean
        If (Lowercase(Right(sRootName, 4)) = ".int") Begin
            Function_Return True
        End
        Function_Return (Pos(":", sRootName) > 2)
    End_Function

    // Is the data file of an embedded table where the runtime looks for it? A root name with a folder of its own
    // is looked for there. Else each folder of the data path is looked at, and then each folder of the open path
    // (DF_OPEN_PATH): the runtime searches the open path when it opens a table, and it can name other folders.
    Function _UtilEmbeddedTableIsFound String sRootName Returns Boolean
        String sOpenPath sFolder
        Integer iPaths iPath
        Boolean bExists

        If ((sRootName contains "\") or (sRootName contains ":")) Begin
            Get vFilePathExists (sRootName + ".dat") to bExists
            If (bExists = True) Begin
                Function_Return True
            End
        End
        Get _UtilEmbeddedTableFileExists sRootName to bExists
        If (bExists = True) Begin
            Function_Return True
        End
        Get_Attribute DF_OPEN_PATH to sOpenPath
        Get CountOfPaths of (phoWorkspace(ghoApplication)) sOpenPath to iPaths
        For iPath from 1 to iPaths
            Get PathAtIndex of (phoWorkspace(ghoApplication)) sOpenPath iPath to sFolder
            If (Trim(sFolder) <> "") Begin
                Get vFolderFormat sFolder to sFolder
                Get vFilePathExists (sFolder + sRootName + ".dat") to bExists
                If (bExists = True) Begin
                    Function_Return True
                End
            End
        Loop
        Function_Return False
    End_Function

    // Is the table of a database driver gone for sure? Only its server can say so: the table must be missing from
    // the list of tables of the database the library is connected to. When there is no such list to look in - an
    // .int file without a driver prefix, another driver than the library's, no database, or an empty list - the
    // answer is False, and sWhy says why the table could not be looked for. When the answer is True, sWhy says
    // where it was not found.
    Function _UtilDriverTableIsGone String sRootName String ByRef sWhy Returns Boolean
        String sDriverID sOwnDriverID sDatabase sSchema sTable
        String[] asTables
        Integer iPos

        Move "" to sWhy
        Move "" to sDriverID
        Move (Pos(":", sRootName)) to iPos
        If (iPos > 2) Begin
            Move (Left(sRootName, (iPos - 1))) to sDriverID
        End
        If (sDriverID = "") Begin
            Move "only the driver named in the .int file can tell whether its table is there" to sWhy
            Function_Return False
        End
        Get psDriverID to sOwnDriverID
        Get psDatabase to sDatabase
        If (Uppercase(sDriverID) <> Uppercase(sOwnDriverID) or sDatabase = "") Begin
            Move ("the library is not connected to a database of the" * sDriverID * "driver, so the table could not be looked for") to sWhy
            Function_Return False
        End
        Move (Uppercase(sOwnDriverID)) to sOwnDriverID
        If (sOwnDriverID <> MSSQLDRV_ID and sOwnDriverID <> DB2_DRV_ID and sOwnDriverID <> ODBC_DRV_ID) Begin
            Move ("the tables of the" * sDriverID * "driver cannot be listed, so the table could not be looked for") to sWhy
            Function_Return False
        End
        Get psSchema to sSchema
        Get _SqlUtilEnumerateTables sOwnDriverID sDatabase sSchema to asTables
        If (SizeOfArray(asTables) = 0) Begin
            Move ("the database" * sDatabase * "gave no list of its tables, so the table could not be looked for") to sWhy
            Function_Return False
        End
        Get _TableNameOnly sRootName to sTable
        If (SearchArray(sTable, asTables, Desktop, (RefFunc(DFSTRICMP))) <> -1) Begin
            Function_Return False
        End
        Move ("the database" * sDatabase * "has no table" * sTable) to sWhy
        Function_Return True
    End_Function

    // After an embedded table was copied to a new root name in sFolder: removes each file of the old name - the
    // .dat, .hdr, .tag and .vld file and the index files .k1 to .k15 - whose copy under the new name is there.
    // An old file without a copy, or one that cannot be removed, stays and is named in the log. Returns False
    // when a file stays. (This used to remove "old name.*" without looking at what the copy had made.)
    Function _UtilEmbeddedTableOldFilesRemove String sFolder String sRootNameFrom String sRootNameTo Returns Boolean
        String[] asExtensions
        String sLeft
        Integer iCount iRetval
        Boolean bExists

        Move ".dat" to asExtensions[0]
        Move ".hdr" to asExtensions[1]
        Move ".tag" to asExtensions[2]
        Move ".vld" to asExtensions[3]
        For iCount from 1 to 15
            Move (".k" + String(iCount)) to asExtensions[iCount + 3]
        Loop

        Move "" to sLeft
        For iCount from 0 to (SizeOfArray(asExtensions) - 1)
            Get vFilePathExists (sFolder + sRootNameFrom + asExtensions[iCount]) to bExists
            If (bExists = True) Begin
                Get vFilePathExists (sFolder + sRootNameTo + asExtensions[iCount]) to bExists
                Move 1 to iRetval
                If (bExists = True) Begin
                    // vDeleteFile answers 0 when the file is gone.
                    Get vDeleteFile (sFolder + sRootNameFrom + asExtensions[iCount]) to iRetval
                End
                If (iRetval <> 0) Begin
                    Move (sLeft + " " + sRootNameFrom + asExtensions[iCount]) to sLeft
                End
            End
        Loop
        If (sLeft <> "") Begin
            Send LogError ("Table" * sRootNameFrom * "was renamed to" * sRootNameTo + ". These files of the old name are left in" * sFolder + ":" + sLeft) False
        End
        Function_Return (sLeft = "")
    End_Function

    // Is the table there: its number is in Filelist.cfg, and the server has it (a table of a database driver,
    // _UtilRootNameIsDriverTable) or its data file is there (an embedded table). bCached: the server's list in
    // pasSQLDataTables. (A ":" anywhere in the root name made the table SQL, a drive too; _UtilTableExists and its
    // _Ex were two copies.)
    Function _UtilTableExistsBy Handle hTable Boolean bCached Returns Boolean
        Boolean bExists bIsSQLTable
        String sRootName

        Get _UtilTableNumberIsInUse hTable to bExists
        If (bExists = False) Begin
            Function_Return False
        End

        Move False to bIsSQLTable
        If (hTable > 0) Begin
            Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
            Get _UtilRootNameIsDriverTable sRootName to bIsSQLTable
        End
        If (bIsSQLTable = True) Begin
            Get _UtilTableIsSqlBy hTable bCached to bExists
        End
        Else Begin
            Get _UtilEmbeddedTableFileExists sRootName to bExists
        End
        Function_Return bExists
    End_Function

    // Checks that the passed hTable number both exists in Filelist.cfg and
    // that the embedded .dat file exists on disk _or_ that the SQL table exists
    // if it is an SQL table
    Function _UtilTableExists Handle hTable Returns Boolean
        Boolean bExists
        Get _UtilTableExistsBy hTable False to bExists
        Function_Return bExists
    End_Function

    // Note: This variant uses the pasSQLDataTables property!
    //       Thus, that property needs to have been initialized before
    //       calling.
    // It checks that the SQL table exists on the SQL end, *or*
    // if embedded database, that the .dat file exists on disk.
    Function _UtilTableExists_Ex Handle hTable Returns Boolean
        Boolean bExists
        Get _UtilTableExistsBy hTable True to bExists
        Function_Return bExists
    End_Function

    // Pass a table handle
    // Returns True if the table exists in filelist.cfg.
    Function _UtilTableNumberIsInUse Handle hCheckTable Returns Boolean
        Handle hTable
        Boolean bFound

        Move False to bFound
        Move 0 to hTable
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable
            If (hTable > 0) Begin
                If (hTable = hCheckTable) Begin
                    Move True to bFound
                End
            End
            If (bFound = True) ;
                Break
        Until (hTable = 0)

        Function_Return bFound
    End_Function

    // Returns number of tables in filelist.cfg.
    // The number of Filelist entries in use. (It was declared Returns Boolean; the number came through as it was.)
    Function _UtilNumberOfFileListTables Returns Integer
        Handle hTable
        Integer iCount

        Move 0 to iCount
        Move 0 to hTable
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable
            If (hTable > 0) Begin
                Increment iCount
            End
        Until (hTable = 0)

        Function_Return iCount
    End_Function

    // DataFlex Embedded Database Data Types:
    // Helper function for _UtilEnumerateColumnTypes
    // bCanEditSize: True when the size of a column of that type can be set, as in the driver type tables. (Date and
    // DateTime had True, the others False: the meaning the other way round.)
    Function _UtilEnumerateDataFlexTypes Returns tColumnType[]
        tColumnType[] ColumnType
        Integer i

        Move DF_ASCII           to ColumnType[i].iSQLType
        Move "ASCII"            to ColumnType[i].sSQLType
        Move DF_ASCII           to ColumnType[i].iDataFlexType
        Move "ASCII"            to ColumnType[i].sDataFlexType
        Move "254"              to ColumnType[i].sPrecision
        Move True               to ColumnType[i].bCanEditSize
        Increment i

        Move DF_BCD             to ColumnType[i].iSQLType
        Move "Numeric"          to ColumnType[i].sSQLType
        Move DF_BCD             to ColumnType[i].iDataFlexType
        Move "Numeric"          to ColumnType[i].sDataFlexType
        Move "14.8"             to ColumnType[i].sPrecision
        Move True               to ColumnType[i].bCanEditSize
        Increment i

        Move DF_DATE            to ColumnType[i].iSQLType
        Move "Date"             to ColumnType[i].sSQLType
        Move DF_DATE            to ColumnType[i].iDataFlexType
        Move "Date"             to ColumnType[i].sDataFlexType
        Move "6.0"              to ColumnType[i].sPrecision
        Move False              to ColumnType[i].bCanEditSize
        Increment i

        Move DF_TEXT            to ColumnType[i].iSQLType
        Move "Text"             to ColumnType[i].sSQLType
        Move DF_TEXT            to ColumnType[i].iDataFlexType
        Move "Text"             to ColumnType[i].sDataFlexType
        Move "16384"            to ColumnType[i].sPrecision
        Move True               to ColumnType[i].bCanEditSize
        Increment i

        Move DF_BINARY          to ColumnType[i].iSQLType
        Move "Binary"           to ColumnType[i].sSQLType
        Move DF_BINARY          to ColumnType[i].iDataFlexType
        Move "Binary"           to ColumnType[i].sDataFlexType
        Move "16384"            to ColumnType[i].sPrecision
        Move True               to ColumnType[i].bCanEditSize
        Increment i

        Move DF_DATETIME        to ColumnType[i].iSQLType
        Move "DateTime"         to ColumnType[i].sSQLType
        Move DF_DATETIME        to ColumnType[i].iDataFlexType
        Move "DateTime"         to ColumnType[i].sDataFlexType
        Move "23"               to ColumnType[i].sPrecision
        Move False              to ColumnType[i].bCanEditSize
        Increment i

        Move DF_OVERLAP         to ColumnType[i].iSQLType
        Move "Overlap"          to ColumnType[i].sSQLType
        Move DF_OVERLAP         to ColumnType[i].iDataFlexType
        Move "Overlap"          to ColumnType[i].sDataFlexType
        Move "0.0"              to ColumnType[i].sPrecision

        Function_Return ColumnType
    End_Function

    Function _UtilEnumerateDB2Types Returns tColumnType[]
        tColumnType[] aColumnType
        Integer i

        #Include DB2_DRV_DriverDef.inc

        Function_Return aColumnType
    End_Function

    // Microsoft SQL Server Database Data Types:
    // Helper function for _UtilEnumerateColumnTypes
    Function _UtilEnumerateMSSQLTypes String sDriverID Returns tColumnType[]
        tColumnType[] aColumnType
        Integer i

        If (sDriverID = MSSQLDRV_ID) Begin
            #Include MSSQLDRV_DriverDef.inc

        End

        Function_Return aColumnType
    End_Function

    // The entry of a type list for a type number (bByNumber True) or for a type name in any case; -1 when the list
    // has none.
    Function _UtilColumnTypeFind tColumnType[] ColumnTypeArray Integer iType String sType Boolean bByNumber Returns Integer
        Integer iCount

        Move (Uppercase(sType)) to sType
        For iCount from 0 to (SizeOfArray(ColumnTypeArray) - 1)
            If (bByNumber = True) Begin
                If (ColumnTypeArray[iCount].iSQLType = iType) Begin
                    Function_Return iCount
                End
            End
            Else If (Uppercase(ColumnTypeArray[iCount].sSQLType) = sType) Begin
                Function_Return iCount
            End
        Loop
        Function_Return -1
    End_Function

    // Internal usage. Use the UtilColumnTypeXXX functions instead.
    Function _UtilColumnType String sDriverID Integer iDbType Integer iType String sType Boolean bIntegerInputType Returns tColumnType
        Integer iStart iItem
        tColumnType[] ColumnTypeArray
        tColumnType RetvalType
        Boolean bFrameworkDataFlexType

        Move "Undefined" to RetvalType.sSQLType
        Move -1999       to RetvalType.iSQLType

        Move 0 to iStart
        Move (Uppercase(sType)) to sType
        Move (iType <= -1490) to bFrameworkDataFlexType
        If (bFrameworkDataFlexType = True) Begin
            Get _UtilDUFDataTypeToSqlTypeMapping sDriverID iDbType iType to RetvalType
            Function_Return RetvalType
        End

        // By the type number, or by the type name in any case. (SearchArray on the struct compared the number only,
        // and a lookup by name passed 0: every name became the type with number 0.)
        Get _UtilEnumerateColumnTypes sDriverID iDbType to ColumnTypeArray
        Get _UtilColumnTypeFind ColumnTypeArray iType sType bIntegerInputType to iItem
        If (iItem = -1) Begin
            Get _UtilEnumerateDataFlexTypes to ColumnTypeArray
            Get _UtilColumnTypeFind ColumnTypeArray iType sType bIntegerInputType to iItem
        End
        If (iItem <> -1) Begin
            Move ColumnTypeArray[iItem].sSQLType       to RetvalType.sSQLType
            Move ColumnTypeArray[iItem].iSQLType       to RetvalType.iSQLType
            Move ColumnTypeArray[iItem].sDataFlexType  to RetvalType.sDataFlexType
            Move ColumnTypeArray[iItem].iDataFlexType  to RetvalType.iDataFlexType
            Move ColumnTypeArray[iItem].sPrecision     to RetvalType.sPrecision
            Move ColumnTypeArray[iItem].bCanEditSize   to RetvalType.bCanEditSize
        End

        Function_Return RetvalType
    End_Function

    // Returns a struct array with all data types for the passed driver & dbtype.
    Function _UtilEnumerateColumnTypes String sDriverID Integer iDbType Returns tColumnType[]
        tColumnType[] ColumnType

        // We need to treat DAW's ODBC driver a bit different, as the output depends on
        // the dbType.
        If (sDriverID = ODBC_DRV_ID) Begin
            If (iDbType = EN_DbTypeMySQL) Begin
                Move ODBC_DRV_ID to sDriverID
            End
            If (iDbType = EN_DbTypeMSSQL) Begin
                Move MSSQLDRV_ID to sDriverID
            End
            If (iDbType = EN_DbTypeDB2) Begin
                Move DB2_DRV_ID to sDriverID
            End
            If (iDbType = EN_DbTypePostgre) Begin
                Move ODBC_DRV_ID to sDriverID
            End
        End

        Case Begin
            Case (iDbType = EN_dbTypeDataFlex)
                Get _UtilEnumerateDataFlexTypes to ColumnType
                Case Break

            Case (iDbType = EN_DbTypeDB2)
                Get _UtilEnumerateDB2Types to ColumnType
                Case Break

            Case (iDbType = EN_DbTypeMSSQL)
                Get _UtilEnumerateMSSQLTypes sDriverID to ColumnType
                Case Break
        Case End

        Function_Return ColumnType
    End_Function

    // Returns a struct with the default column types for the SQL back-end and how they
    // are mapped to a DUF data type.
    Function _UtilDUFDataTypeToSqlTypeMapping String sDriverID Integer iDbType Integer iType Returns tColumnType
        tColumnType ColumnType
        String sDataType
        Integer iDriverID iCount

        Move 0 to iCount
        Get DriverIndex sDriverID to iDriverID

        Case Begin
            // DF_ASCII
            Case (iType = DF_ASCII_DUF)
                If (sDriverID = ODBC_DRV_ID) Begin
                    Get_Attribute DF_DRIVER_MAP_DFASCII_TO_ODBCTYPE of iDriverID to sDataType
                End
                Else Begin
                    Get_Attribute DF_DRIVER_MAP_DFASCII_TO_SQLTYPE  of iDriverID to sDataType
                End
                Move DF_ASCII    to ColumnType.iDataFlexType
                Move "ASCII"     to ColumnType.sDataFlexType
                Move sDataType   to ColumnType.sSQLType
                Move DF_ASCII    to ColumnType.iSQLType
                Move True        to ColumnType.bCanEditSize
                Case Break

            // DF_BINARY
            Case (iType = DF_BINARY_DUF)
                If (sDriverID = ODBC_DRV_ID) Begin
                    Get_Attribute DF_DRIVER_MAP_DFBINARY_TO_ODBCTYPE of iDriverID to sDataType
                End
                Else Begin
                    Get_Attribute DF_DRIVER_MAP_DFBINARY_TO_SQLTYPE  of iDriverID to sDataType
                End
                Move DF_BINARY   to ColumnType.iDataFlexType
                Move "Binary"    to ColumnType.sDataFlexType
                Move sDataType   to ColumnType.sSQLType
                Move DF_BINARY   to ColumnType.iSQLType
                Move True        to ColumnType.bCanEditSize
                Case Break

            // DF_DATE
            Case (iType = DF_DATE_DUF)
                If (sDriverID = ODBC_DRV_ID) Begin
                    Get_Attribute DF_DRIVER_MAP_DFDATE_TO_ODBCTYPE of iDriverID to sDataType
                End
                Else Begin
                    Get_Attribute DF_DRIVER_MAP_DFDATE_TO_SQLTYPE  of iDriverID to sDataType
                End
                Move DF_DATE     to ColumnType.iDataFlexType
                Move "Date"      to ColumnType.sDataFlexType
                Move sDataType   to ColumnType.sSQLType
                Move DF_DATE     to ColumnType.iSQLType
                Move False       to ColumnType.bCanEditSize
                Case Break

            // DF_DATETIME
            Case (iType = DF_DATETIME_DUF)
                If (sDriverID = ODBC_DRV_ID) Begin
                    Get_Attribute DF_DRIVER_MAP_DFDATETIME_TO_ODBCTYPE of iDriverID to sDataType
                End
                Else Begin
                    Get_Attribute DF_DRIVER_MAP_DFDATETIME_TO_SQLTYPE  of iDriverID to sDataType
                End
                Move DF_DATETIME to ColumnType.iDataFlexType
                Move "DateTime"  to ColumnType.sDataFlexType
                Move sDataType   to ColumnType.sSQLType
                Move DF_DATETIME to ColumnType.iSQLType
                Move False       to ColumnType.bCanEditSize
                Case Break

            // DF_NUMERIC
            // *** Why is there no DF_DRIVER_MAP available for BCD/Numeric??? ***
            // DF_BCD can in SQL be either of "SmallInt", "Int", or "Numeric", but
            // we make them here all "Numeric"...
            // If (sDriverID = ODBC_DRV_ID) Begin
            //     Get_Attribute DF_DRIVER_MAP_DFDATE_TO_ODBCTYPE of iDriverID to sDataType
            // End
            // Else Begin
            //     Get_Attribute DF_DRIVER_MAP_DFDATE_TO_SQLTYPE  of iDriverID to sDataType
            // End
            // ToDo: How should we find the best "Numeric" data type here?
            Case (iType = DF_BCD_DUF)
                Move DF_BCD      to ColumnType.iDataFlexType
                Move "Numeric"   to ColumnType.sDataFlexType
                Move "Numeric"   to ColumnType.sSQLType
                Move SQL_NUMERIC to ColumnType.iSQLType
                Move True        to ColumnType.bCanEditSize
                Case Break

            // DF_TEXT
            Case (iType = DF_TEXT_DUF)
                If (sDriverID = ODBC_DRV_ID) Begin
                    Get_Attribute DF_DRIVER_MAP_DFTEXT_TO_ODBCTYPE of iDriverID to sDataType
                End
                Else Begin
                    Get_Attribute DF_DRIVER_MAP_DFTEXT_TO_SQLTYPE  of iDriverID to sDataType
                End
                Move DF_TEXT     to ColumnType.iDataFlexType
                Move "Text"      to ColumnType.sDataFlexType
                Move sDataType   to ColumnType.sSQLType
                Move DF_TEXT     to ColumnType.iSQLType
                Move True        to ColumnType.bCanEditSize
                Case Break

            Case Else
                Move -1999       to ColumnType.iDataFlexType
                Move "Undefined" to ColumnType.sDataFlexType
                Move "Undefined" to ColumnType.sSQLType
                Move -1999       to ColumnType.iSQLType
                Move True        to ColumnType.bCanEditSize

        Case End

        Function_Return ColumnType
    End_Function

    Function _AllTablesToConvert Returns Integer[]
        Integer[] aTableConvertExceptions iTablesArray
        Handle hTable
        Integer iIndex
        String sTableName
        Boolean bFlexErrs

        // a) Get the exception table array the developer has specified
        Get paTableConvertExceptions to aTableConvertExceptions

        // b) Add CodeMast, CodeType & DbVersion to exceptions
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable
            If (hTable <> 0) Begin
                Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sTableName
                Move (Uppercase(sTableName) = "FLEXERRS")  to bFlexErrs
                If (bFlexErrs = False) Begin
                    If (Uppercase(sTableName) = "CODEMAST" or Uppercase(sTableName) = "CODETYPE" or Uppercase(sTableName) = "DBVERSION") Begin
                        Move (SearchArray(hTable, aTableConvertExceptions)) to iIndex
                        If (iIndex = -1) Begin
                            Move hTable to aTableConvertExceptions[SizeOfArray(aTableConvertExceptions)]
                        End
                    End
                End
            End
        Until (hTable = 0)

        Move 0 to hTable

        // c) Spin through filelist.cfg and add all tables except those from the exception array, to the return array.
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable
            If (hTable > 0) Begin
                Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sTableName
                Move (Uppercase(sTableName) = "FLEXERRS")  to bFlexErrs
                If (bFlexErrs = False) Begin
                    Move (SearchArray(hTable, aTableConvertExceptions)) to iIndex
                    If (iIndex = -1) Begin
                        Move hTable to iTablesArray[SizeOfArray(iTablesArray)]
                    End
                End
            End
        Until (hTable = 0)

        Function_Return iTablesArray
    End_Function

    Function _AllTablesDateCorrections Returns Integer[]
        Integer[] aTableDateCorrectionExceptions iTablesArray
        Handle hTable
        Integer iIndex
        String sTableName
        Boolean bFlexErrs

        Get paTableDateCorrectionExceptions to aTableDateCorrectionExceptions
        Move 0 to hTable

        // Spin through filelist.cfg and add all tables except those from the exception array, to the return array.
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable
            If (hTable > 0) Begin
                Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sTableName
                Move (Uppercase(sTableName) = "FLEXERRS")  to bFlexErrs
                If (bFlexErrs = False) Begin
                    Move (SearchArray(hTable, aTableDateCorrectionExceptions)) to iIndex
                    If (iIndex = -1) Begin
                        Move hTable to iTablesArray[SizeOfArray(iTablesArray)]
                    End
                End
            End
        Until (hTable = 0)

        Function_Return iTablesArray
    End_Function

    Function _AppendAPIColumn tAPIColumn[] aCurrent String sFieldName Integer iType Integer iLength Integer iPrecision Integer iOptions Returns tAPIColumn[]
        tAPIColumn NewAPIColumn

        Move sFieldName to NewAPIColumn.sFieldName
        Move iType      to NewAPIColumn.iType
        Move iLength    to NewAPIColumn.iLength
        Move iPrecision to NewAPIColumn.iPrecision
        Move iOptions   to NewAPIColumn.iOptions

        Move NewAPIColumn to aCurrent[SizeOfArray(aCurrent)]

        Function_Return aCurrent
    End_Function

    // *** Miscellaneous other functions ***
    // Some of which can be used by both "Sqlxxx" and "Apixxx" functions.
    //

    // Callback functionality used when e.g. calling driver functions directly.
    Function Callback String sCallback_Text Integer iCallback_Type Returns Integer
        Integer iPerc
        Number nReady nTotal

        Send DoAdvance of ghoProgressBar

        If (sCallback_Text contains "Copy records") Begin
            Move CS_DUF_CopyingData to sCallback_Text
        End
        If (sCallback_Text contains "Dropping index" or sCallback_Text contains "Temporary delete of all indices of table") Begin
            Move (Replace("Dropping index", sCallback_Text, CS_DUF_DeletingIndex)) to sCallback_Text
            Move (Replace("Temporary delete of all indices of table", sCallback_Text, CS_DUF_DeletingIndex)) to sCallback_Text
        End
        If (sCallback_Text contains "Creating index") Begin
            Move (Replace("Creating index", sCallback_Text, CS_DUF_CreatingIndex)) to sCallback_Text
        End

        Case Begin
            Case (iCallback_Type = DF_Message_Text)
                Set Message_Text of ghoStatusPanel to sCallback_Text
                Set Action_Text  of ghoStatusPanel to ""
                Case Break
            Case (iCallback_Type = DF_Message_Heading_1)
                Set Message_Text of ghoStatusPanel to sCallback_Text
                Set Action_Text  of ghoStatusPanel to ""
                Case Break
            Case (iCallback_Type = DF_Message_Heading_2)
                Set Message_Text of ghoStatusPanel to sCallback_Text
                Set Action_Text  of ghoStatusPanel to ""
                Case Break
            Case (iCallback_Type = DF_Message_Heading_3)
                Set Message_Text of ghoStatusPanel to sCallback_Text
                Set Action_Text  of ghoStatusPanel to ""
                Case Break
            Case (iCallback_Type = DF_Message_Heading_4)
                Set Message_Text of ghoStatusPanel to sCallback_Text
                Set Action_Text  of ghoStatusPanel to ""
                Case Break
            Case (iCallback_Type = DF_Message_Heading_5)
                Set Message_Text of ghoStatusPanel to sCallback_Text
                Set Action_Text  of ghoStatusPanel to ""
                Case Break
            Case (iCallback_Type = DF_Message_Warning)
                Send None
                Case Break
            Case (iCallback_Type = DF_Message_Progress_Title)
                Set Message_Text of ghoStatusPanel to sCallback_Text
                Set Action_Text  of ghoStatusPanel to ""
                Case Break
            Case (iCallback_Type = DF_Message_Progress_Value)
                //*** Interpret numbers
                Move (Left(sCallback_Text, (Pos(",", sCallback_Text) - 1)))                       to nReady
                Move (Right(sCallback_Text, (Length(sCallback_Text) - Pos(",", sCallback_Text)))) to nTotal
                Move ((nReady / nTotal) * 100)                                                    to iPerc
                Set Action_Text of ghoStatusPanel to (String(iPerc) * String("% Done (Total Number of Records:") * String(nTotal) + ")")
                Case Break
            Case Else
                Set Message_Text to ""
                Set Action_Text  to ""
        Case End

        Send ProcessEvents of ghoStatusPanel
        Function_Return False
    End_Function

    // * Dummy function for the Studio's Code Explorer *
    Function PRIVATE_SUB_FUNCTIONS Returns Boolean
        Function_Return False
    End_Function

    // *** Helper functions with compiled sql script code ***
    //
    // When dropping columns on some SQL back-ends they doesn't reclaim the space taken up by the columns dropped.
    // For data types that are stored inline in the rows (int for example) it may even take up space on
    // the new rows added after the alter statement. to get around this you need to create a clustered
    // index on the table _or_ rebuild the clustered Index if it already has one. Rebuilding the index
    // can be done with a REBUILD command after modifying the table. But be warned this can be slow on very big tables.
    //   ALTER TABLE MyTable
    //       REBUILD
    Function _SqlUtilRemoveTableColumnMSSQL String sTableName String sColumnName Returns Boolean
        Boolean bOK

        If (Trim(sTableName) = "" or Trim(sColumnName) = "") Begin
            Function_Return False
        End

        SQLIncludeScriptFile ..\Scripts\DropConstraintAndColumnNameMSSQL.sql as DropConstraintAndColumnNameMSSQL.sql
        Get _SqlUtilRemoveTableColumnByScript "DropConstraintAndColumnNameMSSQL.sql" sTableName sColumnName to bOK

        Function_Return (bOK = True)
    End_Function

    // Runs an SQL script that is compiled into the program, with each placeholder (asPlaceholders) replaced in every
    // line by its value (asValues). (Three functions each had a copy of this.)
    Function _SqlUtilRunScriptResource String sMemScriptFile String[] asPlaceholders String[] asValues Returns Boolean
        tSQLScriptArray SQLScriptArray
        String sDriverID
        Boolean bOK
        Integer iLine iItem

        Get psDriverID to sDriverID
        Get _SqlUtilReadResource sMemScriptFile to SQLScriptArray
        If (SQLScriptArray.bError = True) Begin
            Function_Return False
        End
        For iLine from 0 to (SizeOfArray(SQLScriptArray.sSQLScriptArray) - 1)
            For iItem from 0 to (SizeOfArray(asPlaceholders) - 1)
                Move (Replaces(asPlaceholders[iItem], SQLScriptArray.sSQLScriptArray[iLine], asValues[iItem])) to SQLScriptArray.sSQLScriptArray[iLine]
            Loop
        Loop
        Get _SqlUtilExecuteEmbeddedScript SQLScriptArray sDriverID False "" to bOK
        Function_Return (bOK = True)
    End_Function

    // Removes a column from a table with the script sMemScriptFile (TABLE_NAME_XXX, COLUMN_NAME_XXX).
    // can be done with a REBUILD command after modifying the table. But be warned this can be slow on very big tables.
    //   ALTER TABLE MyTable
    //       REBUILD
    Function _SqlUtilRemoveTableColumnByScript String sMemScriptFile String sTableName String sColumnName Returns Boolean
        String[] asPlaceholders asValues
        Boolean bOK

        If (Trim(sTableName) = "" or Trim(sColumnName) = "") Begin
            Function_Return False
        End
        Move "TABLE_NAME_XXX"  to asPlaceholders[0]
        Move "COLUMN_NAME_XXX" to asPlaceholders[1]
        Move sTableName        to asValues[0]
        Move sColumnName       to asValues[1]
        Get _SqlUtilRunScriptResource sMemScriptFile asPlaceholders asValues to bOK
        Function_Return bOK
    End_Function

    // Reads a SQL script file that has been compiled into the .exe program as a resource.
    // Pass: The memory resource reference and a boolean True if you want to create the file on disk (in the Home folder).
    // Returns: A tSQLScriptArray Struct with the Sql script as an uChar Array will be returned along with the a bError boolean.
    Function _SqlUtilReadResource String sMemFileName Returns tSQLScriptArray
        Integer iChannel iArgumentSize iCount
        Number nByteCount
        String sSQLScript
        tSQLScriptArray SqlScriptArray
        UChar[] uCharData

        Move False to Err
        Get Seq_New_Channel to iChannel
        If (iChannel = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
            Error DFERR_PROGRAM 'No channel available...'
            Move True to SqlScriptArray.bError
            Function_Return SqlScriptArray
        End

        // First decide the size of the script
        Direct_Input channel iChannel ("Resource: " + sMemFileName)
        Read_Block channel iChannel uCharData -1 // -1 means that all data should be read.
        Close_Input channel iChannel

        Move (SizeOfArray(uCharData)) to nByteCount
        If (nByteCount  < 1) Begin
            Send Seq_Release_Channel iChannel
            Move True to SqlScriptArray.bError
            Function_Return SqlScriptArray
        End

        // If necessary change the string argument_size
#IF (!@ < 201)
        Get_Argument_Size to iArgumentSize
        If (nByteCount >= iArgumentSize) Begin
            Move (nByteCount + 2048) to nByteCount
            Set_Argument_Size nByteCount // Set new argument size just a bit higher than "needed" for overhead margin.
            Move True          to SqlScriptArray.bArgumentSizeChanged
            Move iArgumentSize to SqlScriptArray.iOrgArgumentSize
        End
        Else Begin
            Move False to SqlScriptArray.bArgumentSizeChanged
        End
#ENDIF
        // Read the script file from memory line-by-line
        Direct_Input channel iChannel ("Resource: " + sMemFileName)
            Move 0 to iCount
            Repeat
                Readln channel iChannel sSQLScript
                Move sSQLScript to SqlScriptArray.sSQLScriptArray[iCount]
                Increment iCount
            Until (SeqEof = True)
        Close_Input channel iChannel
        Send Seq_Release_Channel iChannel

        // Finally "sanitize" the script by removing all comments.
        Get _SqlUtilSanitizeScript SqlScriptArray to SqlScriptArray

        Function_Return SqlScriptArray
    End_Function

    // The messages of an SQL statement that ran: each is added to the update handler's list (paSQLQueryMessages) and
    // to this library's (paQueryMessages, emptied by the caller when its statement starts); with bShowProgress each
    // is shown in the status panel, or on the screen when the panel is not up. SqlUtilExecuteQuery and
    // _SqlUtilExecuteEmbeddedScript share it. (Each had a copy, and both showed message number 0 for every message.)
    Procedure _SqlUtilCollectMessages Handle hoStmt Integer iMsgs Boolean bShowProgress
        String[] asMsg asSQLQueryMessages
        String sMessage
        Integer iMessage

        If (iMsgs < 1) Begin
            Procedure_Return
        End
        Get paQueryMessages to asMsg
        If (ghoDbUpdateHandler > 0) Begin
            Get paSQLQueryMessages of ghoDbUpdateHandler to asSQLQueryMessages
        End
        For iMessage from 1 to iMsgs
            Get SqlGetMessage of hoStmt iMessage to sMessage
            Get RemoveComponentIdentifier of hoStmt sMessage to sMessage
            If (bShowProgress = True) Begin
                If (Active_State(ghoStatusPanel)) Begin
                    Send Update_StatusPanel of ghoStatusPanel (Sformat("  SQLGetMessage iMessage %1 returned [%2]", iMessage, sMessage))
                End
                Else Begin
                    Showln (Sformat("  SQLGetMessage iMessage %1 returned [%2]", iMessage, sMessage))
                End
            End
            Move sMessage to asMsg[SizeOfArray(asMsg)]
            Move sMessage to asSQLQueryMessages[SizeOfArray(asSQLQueryMessages)]
        Loop
        If (ghoDbUpdateHandler > 0) Begin
            Set paSQLQueryMessages of ghoDbUpdateHandler to asSQLQueryMessages
        End
        Set paQueryMessages to asMsg
    End_Procedure

    Function _SqlUtilExecuteEmbeddedScript tSQLScriptArray SQLScriptArray String sDriverID Boolean bCreateScriptFile String sMemFileName Boolean bShowProgr Returns Boolean
        String sSQLVal sStmt sCR sGOKeyWord sNoCountKeyWord sExportFile sLineUpper
        Handle hoSql hoSQLConnect hoStmt hoError
        Integer iMsgs iRows jRows iRowType iCount iChunkCounter iChunkMax iCh iNextSet iPos
        String[] asNoMessages
        DateTime dtQueryExecStart dtQueryExecEnd
        TimeSpan tsQuery
        tSqlErrorArray aSqlErrorArray
        tSQLConnection SQLConnection
        Boolean bShowProgress
        
        If (num_arguments > 4) Begin
            Move bShowProgr to bShowProgress
        End
        Get phoSQLManager to hoSql

        Get _SqlFindKeyWord CI_SQLGO to sGOKeyWord
        // There seems to be a problem with passing strings when their value gets really big, aka
        // above the argument_size level. It isn't clear when these problems starts but sooner
        // or later SqlExecDirect stops working correctly with no error messages!
        // To guard from this we set a max number of lines (iChunkMax) that can be processed
        // at a time. Testing with the Create Chinook Database script; 500 seems like a number that works fine.
        // A bonus of this is that it turns out that it is actually faster to run in chunks!
        Get piChunkMax to iChunkMax
        Set paQueryMessages to asNoMessages
        Move False to Err
        Move 0 to iChunkCounter
        Move "" to sStmt
        Get _SqlFindKeyWord CI_SQLSetNoCountOn to sNoCountKeyWord
        Move (Character(13) + Character(10)) to sCR

        Get pSQLConnection of ghoSQLConnectionHandler to SQLConnection
        Get phoSQLManager  to hoSQL
        If (sDriverID = ODBC_DRV_ID) Begin
            If (Uppercase(SQLConnection.sConnectionString) contains CS_SQLIniDSNKeyword) Begin
                Move (Pos(";", SQLConnection.sConnectionString)) to iPos
                If (iPos > 0) Begin
                    Move (Left(SQLConnection.sConnectionString, (iPos - 1))) to SQLConnection.sConnectionString
                    Move (Trim(SQLConnection.sConnectionString)) to SQLConnection.sConnectionString
                End
            End
        End
        Send SqlSetConnect of hoSQL sDriverID SQLConnection.sConnectionString
        Get SqlConnect     of hoSQL "" "" to hoSQLConnect

        If (hoSQLConnect <> 0) Begin
            Move False to Err
            Get SqlOpen of hoSQLConnect to hoStmt
            If (hoStmt <> 0) Begin

                // If the embedded resource should be written as a script file to disk:
                If (bCreateScriptFile = True) Begin
                    Get psHome of (phoWorkspace(ghoApplication)) to sExportFile
                    Get vFolderFormat sExportFile to sExportFile
                    Move (sExportFile + sMemFileName) to sExportFile
                    Get Seq_New_Channel to iCh
                    If (iCh <> DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
                        Direct_Output channel iCh sExportFile
                    End
                End

                // Record starting date/time stamp
                Move (CurrentDateTime()) to dtQueryExecStart
                // Turn on error handling if enabled
                If (pbHandleQueryErrors(Self)) Begin
                    Set pbSqlError to False
                    Set paSqlErrorArray to aSqlErrorArray
                    Move Error_Object_Id to hoError
                    Move Self to Error_Object_Id
                End
                If (sDriverID = MSSQLDRV_ID) Begin
                    Move (sNoCountKeyWord + sCR) to sStmt
                End

                Move (SizeOfArray(SQLScriptArray.sSQLScriptArray)) to iRows
                Decrement iRows

                For iCount from 0 to iRows
                    Move (SQLScriptArray.sSQLScriptArray[iCount]) to sSQLVal
                    Move (Uppercase(Trim(sSQLVal))) to sLineUpper

                    If (sLineUpper <> sGOKeyWord) Begin
                        If (sSQLVal <> "") Begin
                            Move (sSQLVal + sCR) to sSQLVal
                        End
                        Move (Append(sStmt, (sSQLVal))) to sStmt
                    End

                    // - Each time we encounter a "GO" statement we execute it,
                    // or if at the very end of the script. Past piChunkMax lines a chunk ends at a line that ends a
                    // statement (";"), past twice that anywhere. (It ended at piChunkMax lines wherever that fell, in
                    // the middle of a statement too, and "GO " with a blank after it was no GO.)
                    If (sLineUpper = sGOKeyWord or iCount = iRows or (iChunkCounter >= iChunkMax and Right(sLineUpper, 1) = ";") or iChunkCounter >= (iChunkMax * 2)) Begin

                        // - It turns out it can be at least 10 times faster to execute SQL statements in chunks,
                        // instead of all in one go.
                        Send Update_StatusPanel of ghoStatusPanel sStmt
                        
                        // *** Execute script lines: ***
                        Send SqlExecDirect of hoStmt sStmt
                        
                        If (bCreateScriptFile = True) Begin
                            Writeln channel iCh sStmt 
                            Writeln channel iCh "GO"
                        End
                        Move "" to sStmt
                        Move 0 to iChunkCounter
                    End
                    Increment iChunkCounter
                Loop

                Repeat
                    If (pbHandleQueryErrors(Self)) Begin
                        Move hoError to Error_Object_Id
                    End

                    Send _SqlColumnInfo hoStmt
                    Get SQLGetStmtAttribute  of hoStmt SqlSTMTATTRIB_ROWCOUNT to jRows
                    Get SQLGetStmtAttribute  of hoStmt SqlSTMTATTRIB_ROWCOUNT_TYPE to iRowType
                    Get SQLGetStmtAttribute  of hoStmt SqlSTMTATTRIB_NUMMESSAGES to iMsgs
                    Set piRows    to jRows
                    Set piRowType to iRowType

                    Send _SqlUtilCollectMessages hoStmt iMsgs bShowProgress

                    Get SQLNextResultSet of hoStmt to iNextSet
                Until (iNextSet = 0)
    
                Move (CurrentDateTime()) to dtQueryExecEnd
            End

            Move (dtQueryExecEnd - dtQueryExecStart) to tsQuery
            Set ptsQueryExec to tsQuery
            Send SqlClose of hoStmt

            If (bCreateScriptFile = True) Begin
                Close_Output channel iCh
                Send Seq_Release_Channel iCh
            End
        End
        Send SqlDisconnect of hoSQLConnect

        Function_Return (hoSQLConnect <> 0 and Err = False)
    End_Function

    // Creates a database with the script sMemScriptFile (DATABASE_NAME_XXX, and COLLATION_NAME_XXX for psCollation),
    // for PostgreSQL and MySQL. (Each had a function of its own, the same function.)
    Function _SqlUtilCreateDatabaseByScript String sMemScriptFile String sDatabaseName Returns Boolean
        String[] asPlaceholders asValues
        String sCollation
        Boolean bOK

        If (Trim(sDatabaseName) = "") Begin
            Function_Return False
        End
        Get psCollation to sCollation
        Move "DATABASE_NAME_XXX"  to asPlaceholders[0]
        Move "COLLATION_NAME_XXX" to asPlaceholders[1]
        Move sDatabaseName        to asValues[0]
        Move sCollation           to asValues[1]
        Get _SqlUtilRunScriptResource sMemScriptFile asPlaceholders asValues to bOK
        Function_Return bOK
    End_Function

    // Checks if the passed connection id exists in the CLI interface.
    // This might be needed by API-methods when a connection id is to be used and
    // the connection id hasn't been established with the driver's CLI interface.
    // NOTE: Only applicable for DAW drivers.
    Function IsConnectionID String sConnectionID String sDriverID Returns Boolean
        String sID sConnString
        Integer iDriver iNumConn iCount
        Handle hoCLI
        Boolean bOK

        Get IsDAWSQLDriver sDriverID to bOK
        If (bOK = False) Begin
            Error DFERR_PROGRAM "Connection ID's can only be used with DAW drivers."
            Function_Return False
        End

        Move False to bOK
        Get phoCLIHandler to hoCLI
        If (hoCLI <> 0) Begin
            Set psDriverID of hoCLI to sDriverID
            Get DriverIndex of hoCLI sDriverID to iDriver

            // If driver not loaded; load it.
            If (iDriver = 0) Begin
                Load_Driver sDriverID
                Get DriverIndex sDriverID to iDriver
            End
            If (iDriver <> 0) Begin
                Get_Attribute DF_DRIVER_NUMBER_CONNECTION_IDS of iDriver to iNumConn
                Decrement iNumConn
                For iCount from 0 to iNumConn
                    Get_Attribute DF_DRIVER_CONNECTION_ID_STRING of iDriver iCount to sConnString
                    Get_Attribute DF_DRIVER_CONNECTION_ID of iDriver iCount to sID
                    If (sID = sConnectionID) Begin
                        Move True to bOK
                    End
                Loop
            End
        End

        Function_Return bOK
    End_Function

    Function IsDAWSQLDriver String sDriverID Returns Boolean
        Boolean bOK
        Move (sDriverID = MSSQLDRV_ID or sDriverID = DB2_DRV_ID or sDriverID = ODBC_DRV_ID or sDriverID = DFBTRDRV_ID) to bOK
        Function_Return bOK
    End_Function

    Function IsMSSQLDriver Returns Boolean
        Integer iDriverIndex
        Get DriverIndex MSSQLDRV_ID to iDriverIndex
        Function_Return (iDriverIndex <> 0)
    End_Function

    // Similar to _SqlCheckCurrentDriver but generates no error and it doesn't
    // attempt to load the driver.
    // Returns true if the passed driver is SQL based.
    Function IsSQLDriver String sDriverID Returns Boolean
        Boolean bOK
        Get IsDAWSQLDriver sDriverID to bOK
        Function_Return bOK
    End_Function

    // *** Error Handler ***
    //
    // Note: If the cDbUpdateHandler & cDbUpdateVersion classes are used this error handler is _not_
    //       used. Instead the Error_Report in the cDbUpdateHandler i used.
    Procedure Error_Report Integer iErrorNumber Integer iErrorLine String sErrorText
        Integer iSize iErrorMode
        tSqlErrorArray aSqlErrorArray

        If (pbProcessingError(Self)) Begin
            Procedure_Return
        End

        Get Error_Report_Mode to iErrorMode
        If (iErrorMode = DUF_ERROR_NO_REPORT) Begin
            Set pbProcessingError to False
            Procedure_Return
        End

        Set pbProcessingError to True
        Set pbSqlError to True
        Get paSqlErrorArray      to aSqlErrorArray
        Move (SizeOfArray(aSqlErrorArray.sSqlErrorArray)) to iSize
        Move sErrorText          to aSqlErrorArray.sSqlErrorArray[iSize]
        Get psSQLStatementString to aSqlErrorArray.sSqlStatementArray[iSize]
        Move iErrorNumber        to aSqlErrorArray.iSqlErrorArray[iSize]
        Set paSqlErrorArray      to aSqlErrorArray
        Set pbProcessingError to False
    End_Procedure

    // The table name of a root name: without a driver prefix (MSSQLDRV:Customer), a folder (C:\Data\Customer) or an .int
    // suffix (Customer.int). A drive is no driver prefix: a driver id is longer than one letter. (A drive was taken
    // for a driver prefix, and the folder was left in.)
    Function _TableNameOnly String sTableName Returns String
        Integer iPos
        Move (Pos(":", sTableName)) to iPos
        If (iPos > 2) Begin
            Move (Right(sTableName, (Length(sTableName) - iPos))) to sTableName
        End
        Move (RightPos("\", sTableName)) to iPos
        If (iPos > 0) Begin
            Move (Right(sTableName, (Length(sTableName) - iPos))) to sTableName
        End
        If (Lowercase(Right(sTableName, 4)) = ".int") Begin
            Move (Left(sTableName, (Length(sTableName) - 4))) to sTableName
        End
        Function_Return sTableName
    End_Function

    // Removes any prefix from a table name.
    // Example mssqldrv:mytable returns mytable
    //         dbo.mytable returns mytable
    Function _TableNoPrefix String sName Returns String
        Integer iPos
        Move (Pos(":", sName)) to iPos
        If (iPos <> 0) Begin
            Move (Mid(sName, Length(sName), (iPos + 1))) to sName
        End
        Move (Pos(".", sName)) to iPos
        If (iPos <> 0) Begin
            Move (Mid(sName, Length(sName), (iPos + 1))) to sName
        End
        Function_Return sName
    End_Function
    
    // The driver of a root name: its prefix (MSSQLDRV:Customer), else DATAFLEX_ID. A drive is no prefix. An .int file
    // without a prefix (Customer.int) names its driver itself; DATAFLEX_ID is answered for it too.
    Function _DriverIDFromRootName String sRootName Returns String
        Integer iPos
        Move (Pos(":", sRootName)) to iPos
        If (iPos > 2) Begin
            Function_Return (Left(sRootName, (iPos - 1)))
        End
        Function_Return DATAFLEX_ID
    End_Function

    // Does the Rootname points to a .dat file?
    Function _IsDatEntry Handle hTable Returns Boolean
        Boolean bFound bIsIntEntry
        String sRootName sNoDriverRootname sDriver
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _DriverIDFromRootName sRootName to sDriver
        Get _TableNameOnly sRootName to sNoDriverRootname
        Get _IsIntEntry hTable to bIsIntEntry
        Move (bIsIntEntry = False and sDriver = DATAFLEX_ID) to bFound
        Function_Return bFound
    End_Function

    // Checks that the RootName points to a .dat file and that the .dat file exists in a folder of the data path.
    // (The whole data path was taken for one folder name: with two folders no file was found.)
    Function _DatFileExists Handle hTable Returns Boolean
        Boolean bExists
        String sRootName sNoDriverRootname
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _TableNameOnly sRootName to sNoDriverRootname
        Get _UtilEmbeddedTableFileExists sNoDriverRootname to bExists
        Function_Return bExists
    End_Function
    
    // Does an .int file stand for the table: does its root name end in ".int"?
    Function _IsIntEntry Handle hTable Returns Boolean
        String sRootName
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Function_Return (Lowercase(Right(sRootName, 4)) = ".int")
    End_Function

    // Checks to see if the .int file actually exists in a folder of the data path. (The whole data path was taken
    // for one folder name.)
    Function _IntFileExists Handle hTable Returns Boolean
        Boolean bExists
        String sDataPath sIntFileName sFolder
        Integer iPos iPaths iPath

        Move False to bExists
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sIntFileName
        Get _TableNameOnly sIntFileName to sIntFileName
        Move (Pos(".int", Lowercase(sIntFileName))) to iPos
        If (iPos = 0) Begin
            Move (sIntFileName + ".int") to sIntFileName
        End
        Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
        Get CountOfPaths of (phoWorkspace(ghoApplication)) sDataPath to iPaths
        For iPath from 1 to iPaths
            Get PathAtIndex of (phoWorkspace(ghoApplication)) sDataPath iPath to sFolder
            Get vFolderFormat sFolder to sFolder
            If (bExists = False) Begin
                Get vFilePathExists (sFolder + sIntFileName) to bExists
            End
        Loop
        Function_Return bExists
    End_Function
        
    // Is the table a table of a database driver? See _UtilRootNameIsDriverTable.
    Function _IsSQLEntry Handle hTable Returns Boolean
        String sRootName
        Boolean bFound

        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _UtilRootNameIsDriverTable sRootName to bFound
        Function_Return bFound
    End_Function

    // This is used in place of the DF_FILE_OPENED table attribute, because
    // the table then needs to be open, which takes time.
    Function _IsAliasTable Handle hTable Returns Boolean
        Boolean bFound
        String sLogicalName sRootName sNoDriverRootname
        
        Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sLogicalName
        Get_Attribute DF_FILE_ROOT_NAME    of hTable to sRootName
        Get _TableNameOnly sRootName to sNoDriverRootname
        // Do we have an Alias table?
        Move (Lowercase(sLogicalName) <> Lowercase(sNoDriverRootname)) to bFound
        Function_Return bFound
    End_Function

    // If the SQL table cannot be opened, we do the checking a bit different.
    Function _IsSystemFile Handle hTable Returns Boolean
        Boolean bIsSystem bIsSQL bExists bOpen
        String sRootName sDataPath sDriver
        String[] asIndexes
        Move False to bIsSystem

        If (UtilTableIsSafeToOpen(Self, hTable)) Begin
            Open hTable
        End
        Get_Attribute DF_FILE_OPENED of hTable to bOpen
        If (bOpen = True) Begin
            Get_Attribute DF_FILE_IS_SYSTEM_FILE of hTable to bIsSystem
            Function_Return bIsSystem
        End
        
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _DriverIDFromRootName sRootName to sDriver
        Get _TableNameOnly sRootName to sRootName
        Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath 
        Get PathAtIndex of (phoWorkspace(ghoApplication))  sDataPath 1 to sDataPath
        Get vFolderFormat sDataPath to sDataPath
        
        Get _IsSQLEntry hTable to bIsSQL
        If (bIsSQL = False) Begin
            File_Exist (sDataPath + sRootName + ".dat") bExists
            If (bExists = True) Begin
                Open (sDataPath + sRootName + ".dat") as hTable
                Get_Attribute DF_FILE_IS_SYSTEM_FILE of hTable to bIsSystem 
                Close hTable
            End
        End 
        Else Begin
            Get _SqlUtilEnumerateIndexes sRootName sDriver to asIndexes
            Move (SizeOfArray(asIndexes) = 0) to bIsSystem
        End
        Function_Return bIsSystem
    End_Function
                          
    // The table name of a root name (_TableNameOnly); its driver goes into sDriver (_DriverIDFromRootName).
    Function _RemoveDriverFromRootName String sRootname String ByRef sDriver Returns String
        String sTableName

        Get _DriverIDFromRootName sRootname to sDriver
        Get _TableNameOnly sRootname to sTableName
        Function_Return sTableName
    End_Function

    Function _CountFilelistSystemTables Returns Integer
        tFilelist[] FileListTables
        Integer iCount iSize iItems
        
        Move 0 to iItems
        Get pFileListArray to FileListTables
        Move (SizeOfArray(FileListTables)) to iSize
        If (iSize <> 0) Begin
            Decrement iSize
            for iCount from 0 to iSize
                If (FileListTables[iCount].bIsSystemFile = True) Begin
                    Increment iItems
                End
            Loop
        End
        Function_Return iItems    
    End_Function

    Function _CountFileListAliasTables Returns Integer
        tFilelist[] FileListTables
        Integer iCount iSize iItems
        
        Move 0 to iItems
        Get pFileListArray to FileListTables
        Move (SizeOfArray(FileListTables)) to iSize
        If (iSize <> 0) Begin
            Decrement iSize
            for iCount from 0 to iSize
                If (FileListTables[iCount].bIsAlias = True) Begin
                    Increment iItems
                End
            Loop
        End
        Function_Return iItems    
    End_Function

    Function _CountFileListMasterTables Returns Integer
        String sRootName sLogicalName sDriver sNoDriverRootname
        Handle hTable
        Integer iItems
        Boolean bIsAlias bIsIntTable
        
        Move 0 to iItems
        Move 0 to hTable 
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable
            If (hTable <> 0 and hTable <> 50) Begin
                Get _IsAliasTable hTable to bIsAlias
                If (bIsAlias = False) Begin
                    Get_Attribute DF_FILE_ROOT_NAME    of hTable to sRootName
                    Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sLogicalName                    
                    Get _RemoveDriverFromRootName sRootName (&sDriver) to sNoDriverRootname
                    Get _IsIntEntry hTable to bIsIntTable
                    If (sDriver <> DATAFLEX_ID and Lowercase(sNoDriverRootname) = Lowercase(sLogicalName)) Begin
                        Increment iItems
                    End
                End
            End
        Until (hTable = 0)
        
        Function_Return iItems
    End_Function

    Function _CountFileListOpenErrors Returns Integer
        tFilelist[] FileListTables
        Integer iCount iSize iItems
        
        Move 0 to iItems
        Get pFileListArray to FileListTables
        Move (SizeOfArray(FileListTables)) to iSize
        If (iSize <> 0) Begin
            Decrement iSize
            for iCount from 0 to iSize
                If (FileListTables[iCount].bErrorOpening = True) Begin
                    Increment iItems
                End
            Loop
        End
        Function_Return iItems    
    End_Function 

    // Checks all Alias Filelist entries for errors,
    // and return them as a string array of RootNames.
    Function _CountFileListAliasErrors Returns tFilelist[]
        Integer iCount iItem
        Handle hTable
        Boolean bIsAlias
        String sRootName
        tFilelist[] FileListArray
        
        Move 0 to iCount
        Move 0 to hTable
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of hTable to hTable
            If (hTable <> 0 and hTable <> 50) Begin
                Get _IsAliasTable hTable to bIsAlias
                If (bIsAlias = True) Begin
                    Get _FindAliasEntryError hTable to iItem
                    If (iItem <> 0) Begin
                        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
                        Move hTable    to FileListArray[iCount].hTable
                        Move sRootName to FileListArray[iCount].sRootName
                    End
                    Add iItem to iCount
                End
            End
        Until (hTable = 0)
        
        Function_Return FileListArray
    End_Function

    // Helper function for _CountFileListAliasErrors.
    // Checks to see if an Alias Filelist entry is correct
    // What it does:
    //  1. Checks that the Filelist entry is an Alias table
    //  2. If an Alias, checks if the RootName points to a valid Table
    Function _FindAliasEntryError Handle hTable Returns Integer
        Handle hMasterTable
        String sLogicalNameAlias sRootNameAlias sNoDriverRootnameAlias
        Boolean bOK bIsAlias bIsAliasSQL bIsMasterSQL bIsIntFile
        Integer iRetval
        
        Get _IsAliasTable hTable to bIsAlias
        If (bIsAlias = False) Begin
            Function_Return 0
        End
        
        Move 0 to iRetval
        Move False to bOK
        Move False to bIsAliasSQL
        Move False to bIsMasterSQL

        Get _IsIntEntry hTable to bIsIntFile
        Get_Attribute DF_FILE_ROOT_NAME    of hTable to sRootNameAlias
        Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sLogicalNameAlias
        Get _TableNameOnly sRootNameAlias to sNoDriverRootnameAlias
        Get UtilAliasToMasterTableHandle hTable to hMasterTable
        Move (hMasterTable <> 0) to bOK
        If (bOK = True) Begin
            Get _IsSQLEntry hTable       to bIsAliasSQL
            Get _IsSQLEntry hMasterTable to bIsMasterSQL 
            Move (bIsAliasSQL = bIsMasterSQL) to bOK
        End
        
        // Checks that the .int file exists in the Data folder - after the master checks, which it must not overwrite,
        // and by the name with ".int". (It replaced their verdict, and looked for the name without ".int".)
        If (bOK = True and bIsIntFile = True) Begin
            Get _IntFileExists hTable to bOK
        End

        If (bOK = False) Begin
            Move 1 to iRetval
        End
        Function_Return iRetval
    End_Function
        
    // Returns the first datapath found in the psDataPath property.
    // The returned path always ends with a "\"
    Function psDataPathFirstPart Returns String
        String sDataPath
        Integer iCount

        Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
        Get CountOfPaths of (phoWorkspace(ghoApplication)) sDataPath to iCount
        If (iCount > 1) Begin
            Get PathAtIndex of (phoWorkspace(ghoApplication)) sDataPath 1 to sDataPath
        End
        If (sDataPath <> "") Begin
            Get vFolderFormat sDataPath to sDataPath
        End

        Function_Return sDataPath
    End_Function

    Function psLogTextFileWithPath Returns String
        String sFileName
        Handle hoLogFile
        Get phoLogFile to hoLogFile
        Get psLogTextFileWithPath of hoLogFile to sFileName
        Function_Return sFileName
    End_Function

    Function phoLogFile Returns Handle
        Handle hoLogFile   
        Boolean bErr
        Integer iMode
        
        Move Err to bErr
        Move 0 to hoLogFile
        // The mode it found is put back: a caller's quiet section stays quiet. (It set "report" in any case.)
        Get Error_Report_Mode to iMode
        Set Error_Report_Mode to DUF_ERROR_NO_REPORT  
        Send Ignore_Error of Error_Object_Id DFERR_BAD_MESSAGE
        Delegate Get phoLogFile to hoLogFile
        Send Trap_Error of Error_Object_Id DFERR_BAD_MESSAGE
        Set Error_Report_Mode to iMode
        Move bErr to Err
        
        Function_Return hoLogFile
    End_Function

    Function pnCurrentVersionUpdate Returns Number
        Number nCurrentVersionUpdate
        Integer iMode

        Get Error_Report_Mode to iMode
        Set Error_Report_Mode to DUF_ERROR_NO_REPORT
        Delegate Get pnCurrentVersionUpdate to nCurrentVersionUpdate
        Set Error_Report_Mode to iMode

        Function_Return nCurrentVersionUpdate
    End_Function

    Procedure LogError String sText Boolean bError
        Handle hoLogFile
        Number nCurrentVersionUpdate
        Integer iMode

        Get phoLogFile to hoLogFile
        If (hoLogFile = 0) Begin
            Procedure_Return
        End
        Get pnCurrentVersionUpdate to nCurrentVersionUpdate

        Get Error_Report_Mode to iMode
        Set Error_Report_Mode to DUF_ERROR_NO_REPORT
        Send LogError of hoLogFile nCurrentVersionUpdate 0 sText 0 bError
        Set Error_Report_Mode to iMode
    End_Procedure

    // The caller's Err, kept while a function does work of its own and tests Err for it. _ErrKeep answers the
    // caller's Err and clears it; _ErrGiveBack answers whether that work raised no error, and gives the caller its
    // Err back. A function that uses the pair leaves Err as its caller had it.
    Function _ErrKeep Returns Boolean
        Boolean bCallersErr

        Move Err to bCallersErr
        Move False to Err
        Function_Return bCallersErr
    End_Function

    Function _ErrGiveBack Boolean bCallersErr Returns Boolean
        Boolean bOK

        Move (Err = False) to bOK
        Move bCallersErr to Err
        Function_Return bOK
    End_Function

    Function pbContinueOnError Returns Boolean
        Boolean bContinueOnError
        If (ghoDbUpdateHandler > 0) Begin
            Get pbContinueOnError of ghoDbUpdateHandler to bContinueOnError
        End
        Function_Return bContinueOnError
    End_Function

    Function _UtilUpdateTAGFile String sFullTAGFileName String sColumnName Returns Boolean
        Integer iChIn iChOut // iCount
        Boolean bExists
        String sExistingColumn

        Move False to bExists
        // One channel at a time, each one given back on every path. (Both used to be taken here: the output
        // channel was kept when the column was in the file already, so each added SQL column cost a channel.)
        Get Seq_New_Channel to iChIn
        If (iChIn = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
            Function_Return False
        End

        Move False to Err
        // The following line should also use the channel attribute. (Thank you, Hans van de Laar)
        // The name as it is: wrapped in single quotes the file was not opened, so a name already in the file was
        // never found and was added once more by every call (measured on DataFlex 26).
        Direct_Input channel iChIn sFullTAGFileName
        While (not(SeqEof))
            Readln channel iChIn sExistingColumn
            If (Uppercase(sExistingColumn) = Uppercase(sColumnName)) Begin
                Move True to bExists
            End
            If (Trim(sExistingColumn) = "") Begin
                Move True to SeqEof
            End
        Loop
        Close_Input channel iChIn
        Send Seq_Release_Channel iChIn

        If (bExists = False) Begin
            Get Seq_New_Channel to iChOut
            If (iChOut = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
                Function_Return False
            End
            Append_Output channel iChOut sFullTAGFileName
            Writeln channel iChOut sColumnName
            Close_Output channel iChOut
            Send Seq_Release_Channel iChOut
        End

        Function_Return (Err = False)
    End_Function

    // Changes source code files.
    // Pass a file name with full path and a value to search for, together with the value
    // to change to. Can e.g. be used for changing all .int files from using a fixed server name,
    // to use a Connection ID.
    // Sample: Get _UtilChangeSourceCodeLine "C:\DataFlex 18.2 Examples\Order Entry\Data\Order.int" "SERVER_NAME SERVER=(local)\SQLEXPRESS1" "SERVER_NAME DFCONNID=ChinookDb"
    // Pass "True" for the bShowResult if you want to see the result while it works. Showln will then be used for output
    // Returns True if no errors occured.
    // The file is written only when a line changed, and without the empty read at its end. True when it ran without
    // an error, whether a line changed or not. (It answered "a line changed" - a caller took "nothing to change"
    // for a failure - and wrote the file back every time, one blank line longer.)
    Function _UtilChangeSourceCodeLineCount String sFileName String sChangeFrom String sChangeTo Boolean bShowResult Returns Integer
        Integer iCh iRow iItems iCount iChanges
        String sValue sRow
        String[] sFileArray
        Boolean bExists bIsActive bFileChange

        Move False to Err
        Move 0 to iRow
        Move False to bFileChange

        If (ghoStatusPanel <> 0) Begin
            Get Active_state of ghoStatusPanel to bIsActive
        End

        Get vFilePathExists sFileName to bExists
        If (bExists = False) Begin
            If (bShowResult = True) Begin
                If (bIsActive = True) Begin
                    Send Update_StatusPanel of ghoStatusPanel ("File does not exist:" * String(sFileName))
                End
                Else Begin
                    Showln "File does not exist: " sFileName
                End
            End
            Function_Return -1
        End

        Get Seq_Open_Input_Channel sFileName to iCh
        If (iCh < 1) Begin
            Function_Return -1
        End

        If (bShowResult = True) Begin
            If (ghoStatusPanel <> 0) Begin
                Get Active_state of ghoStatusPanel to bIsActive
                If (bIsActive = True) Begin
                    Set Message_Text of ghoStatusPanel to sFileName
                    Send Update_StatusPanel of ghoStatusPanel ("sChangeFrom =" * String(sChangeFrom) * "sChangeTo =" * String(sChangeTo))
                    Send DoAdvance of ghoProgressBar
                End
            End
            Else Begin
                Showln ""
                Showln "sFileName = " sFileName
                Showln "sChangeFrom = " sChangeFrom " sChangeTo = " sChangeTo
            End
        End

        While (not(SeqEof))
            Readln channel iCh sRow
            // A line that is the new line already is no change.
            If (Uppercase(sRow) contains Uppercase(sChangeFrom) and sRow <> sChangeTo) Begin
                // Change the whole line to the new connection id:
                Move sChangeTo to sRow
                Move True to bFileChange
                Increment iChanges
            End
            Move sRow to sFileArray[iRow]
            Increment iRow
        Loop
        Send Seq_Close_Channel iCh
        If (bFileChange = False) Begin
            Function_Return 0
        End
        // The read after the last line gives an empty line: it is no line of the file.
        If (iRow > 0) Begin
            If (sFileArray[iRow - 1] = "") Begin
                Move (ResizeArray(sFileArray, (iRow - 1))) to sFileArray
            End
        End

        Get Seq_Open_Output_Channel sFileName to iCh
        If (iCh < 1) Begin
            Function_Return -1
        End
        Move (SizeOfArray(sFileArray)) to iItems
        Decrement iItems

        for iCount from 0 to iItems
            Move sFileArray[iCount] to sValue
            Writeln channel iCh sValue
        Loop
        Send Seq_Close_Channel iCh

        Function_Return iChanges
    End_Function
    // True when it ran without an error - a line changed or not. The number of changed lines:
    // _UtilChangeSourceCodeLineCount.
    Function _UtilChangeSourceCodeLine String sFileName String sChangeFrom String sChangeTo Boolean bShowResult Returns Boolean
        Integer iChanges
        Get _UtilChangeSourceCodeLineCount sFileName sChangeFrom sChangeTo bShowResult to iChanges
        Function_Return (iChanges >= 0)
    End_Function

    // This message creates an error log in the "Home" folder named "SQLErrorLog.txt",
    // and opens it in "notepad.exe".
    // Note: This is _not_ used by the cDbUpdateHandler & cDbUpdateVersion classes!
    //       Instead the cDbUpdateLogFile's WriteErrorLog & ShowErrorLog are used.
    Procedure _UtilShowErrorList
        tSqlErrorArray aSqlErrorArray
        Integer iRows iCount iCh iErrorNum iErrors
        String sPath sFileName sErrorTxt sStatement

        Get psHome of (phoWorkspace(ghoApplication)) to sPath
        Get vFolderFormat sPath to sPath
        Move "SQLErrorLog.txt"  to sFileName
        Get Seq_Open_Output_Channel (sPath + sFileName) to iCh
            Get paSqlErrorArray to aSqlErrorArray
            Move (SizeOfArray(aSqlErrorArray.sSqlErrorArray)) to iRows
            Move iRows to iErrors
            If (iRows > 0) Begin
                Decrement iRows
                for iCount from 0 to iRows
                    Move aSqlErrorArray.sSqlErrorArray[iCount]      to sErrorTxt
                    Move aSqlErrorArray.sSqlStatementArray[iCount]  to sStatement
                    Move aSqlErrorArray.iSqlErrorArray[iCount]      to iErrorNum
                    Writeln channel iCh "Error No: " iErrorNum " Error Text: " sErrorTxt
                    Writeln channel iCh "SQL Statement: " sStatement
                Loop
            End
        Send Seq_Close_Channel iCh

        // The count before the Decrement above. (With exactly one error the log was not opened.)
        If (iErrors > 0) Begin
            Runprogram Shell Background (sPath + sFileName)
        End
    End_Procedure

    // Is the table an SQL table that is there: its root name is that of a table of a database driver, and the
    // server has it. bCached: the server's list in pasSQLDataTables (FillSQLTables). (_UtilTableIsSql and its _Ex
    // were two copies.)
    Function _UtilTableIsSqlBy Handle hTable Boolean bCached Returns Boolean
        String sRootName sDriverID
        Boolean bIsSQL

        If (hTable <= 0) Begin
            Function_Return False
        End
        Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
        Get _UtilTableIsSqlByRootName sRootName to bIsSQL
        If (bIsSQL = True) Begin
            Get psDriverID to sDriverID
            Get _TableNameOnly sRootName to sRootName
            Get _SqlUtilTableNameIsOnServer sRootName sDriverID bCached False to bIsSQL
        End
        Function_Return bIsSQL
    End_Function

    // For this to be returning a True value, the table number needs to be in the Filelist.cfg,
    // and the table needs to exist as an SQL table.
    Function _UtilTableIsSql Handle hTable Returns Boolean
        Boolean bIsSQL
        Get _UtilTableIsSqlBy hTable False to bIsSQL
        Function_Return bIsSQL
    End_Function

    // Note: This version uses the pasSQLDataTables array(!)
    //       Thus that property needs to have been initialized before
    //       calling this function.
    Function _UtilTableIsSql_Ex Handle hTable Returns Boolean
        Boolean bIsSQL
        Get _UtilTableIsSqlBy hTable True to bIsSQL
        Function_Return bIsSQL
    End_Function

    // Is the root name that of a table of a database driver? See _UtilRootNameIsDriverTable. (A ":" anywhere said
    // yes: a drive too. An .int file said no.)
    Function _UtilTableIsSqlByRootName String sRootName Returns Boolean
        Boolean bIsSQL
        Get _UtilRootNameIsDriverTable sRootName to bIsSQL
        Function_Return bIsSQL
    End_Function

    // Is a table of this name in the database the library is connected to? bCached: in pasSQLDataTables, filled
    // by FillSQLTables, instead of the server's list. bQuiet: no error when there is no database to look in, or the
    // driver is DataFlex's own. (_SqlUtilCheckIfTableNameExists, its _Ex and SqlUtilCheckIfTableHandleExists each
    // had a copy of this.)
    Function _SqlUtilTableNameIsOnServer String sTableName String sDriverID Boolean bCached Boolean bQuiet Returns Boolean
        String sDatabase sSchema
        String[] asTablesArray

        Get psDatabase to sDatabase
        Get psSchema   to sSchema
        If (sDriverID = DATAFLEX_ID or sDatabase = "") Begin
            If (bQuiet = False) Begin
                Error DFERR_PROGRAM ("Function _SqlUtilCheckIfTableNameExists: psDatabase =" * String(sDatabase) * "psDriver =" * String(sDriverID))
            End
            Function_Return False
        End
        If (bCached = True) Begin
            Get pasSQLDataTables to asTablesArray
        End
        Else Begin
            Get _SqlUtilEnumerateTables sDriverID sDatabase sSchema to asTablesArray
        End
        Function_Return (SearchArray(sTableName, asTablesArray, Desktop, (RefFunc(DFSTRICMP))) <> -1)
    End_Function

    // Checks if a table exists as an SQL table. Returns = True if it does.
    Function _SqlUtilCheckIfTableNameExists String sTableName String sDriverID Returns Boolean
        Boolean bExists
        Get _SqlUtilTableNameIsOnServer sTableName sDriverID False False to bExists
        Function_Return bExists
    End_Function

    // Checks if a table exists as an SQL table, in pasSQLDataTables (much faster: the tables were listed once).
    Function _SqlUtilCheckIfTableNameExists_Ex String sTableName String sDriverID Returns Boolean
        Boolean bExists
        Get _SqlUtilTableNameIsOnServer sTableName sDriverID True False to bExists
        Function_Return bExists
    End_Function

    // Checks that the passed hTable number both exists in Filelist.cfg and
    // that the embedded .dat file exists on disk.
    Function _UtilTableIsEmbedded Handle hTable Returns Boolean
        Boolean bExists bIsEmbedded
        String sRootName

        Get _UtilTableNumberIsInUse hTable to bExists
        If (bExists = False) Begin
            Function_Return False
        End

        Move False to bIsEmbedded
        If (hTable > 0) Begin
            Get_Attribute DF_FILE_ROOT_NAME of hTable to sRootName
            Move (not(sRootName contains ":")) to bIsEmbedded
        End
        // In any folder of the data path. (The whole data path was taken for one folder name.)
        If (bIsEmbedded = True) Begin
            Get _UtilEmbeddedTableFileExists sRootName to bIsEmbedded
        End

        Function_Return bIsEmbedded
    End_Function

    // Returns the DateTime of the passed file name was modified, with seconds (only) precision.
    Function FileModTime String sFileName Returns DateTime
        Date dDate
        Integer iYY iHH iMM iSS
        Boolean bExists
        DateTime dtFileDateTime

        Move (NullDateTime()) to dtFileDateTime
        Get vFilePathExists sFileName to bExists
        If (bExists = True) Begin
            Get_File_Mod_Time sFileName to dDate iHH iMM iSS
            Move dDate            to dtFileDateTime
            Move (DateGetYear       (dtFileDateTime))      to iYY
            Move (DateSetYear       (dtFileDateTime, iYY)) to dtFileDateTime
            Move (DateSetHour       (dtFileDateTime, iHH)) to dtFileDateTime
            Move (DateSetMinute     (dtFileDateTime, iMM)) to dtFileDateTime
            Move (DateSetSecond     (dtFileDateTime, iSS)) to dtFileDateTime
            Move (DateSetMillisecond(dtFileDateTime, 0))   to dtFileDateTime
        End

        Function_Return dtFileDateTime
    End_Function

    // Returns True if the file passed as sFileName1 is newer than sFileName2.
    Function IsFileTimeNewer String sFileName1 String sFileName2 Returns Boolean
        Boolean bExists bIsNewer
        DateTime dtFileDateTime1 dtFileDateTime2

        Move False to bIsNewer
        Get vFilePathExists sFileName1 to bExists
        If (bExists = True) Begin
            Get FileModTime sFileName1  to dtFileDateTime1
            Get FileModTime sFileName2  to dtFileDateTime2
            Move (dtFileDateTime1 > dtFileDateTime2) to bIsNewer
        End
        Function_Return bIsNewer
    End_Function

End_Class
