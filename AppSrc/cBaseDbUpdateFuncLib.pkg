    Function pbDriverDefaultNullableASCII Returns Boolean
        Boolean bState
        If (_NoSQLConnectionHandler(Self)) Begin
            Function_Return
        End
        Get pbDriverDefaultNullableASCII of ghoSQLConnectionHandler to bState
        Function_Return bState
    End_Function

