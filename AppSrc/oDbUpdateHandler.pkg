Use cDbUpdateHandler.pkg

// The update handler of the DUF utilities (DUFCodeGenerator, DUFSQLRepairUtility, DUFTestProgram): it gives the
// function library its error handling, log and settings, and updates no database. A utility is built into the
// workspace it works on, so it makes no table there and keeps no Filelist slot. (It made a DbVersion table in
// slot 285 and an .int backup table in slot 286 of that workspace, and its version object read the table in slot
// 285 - an application table when the workspace used that slot - as the database version.)
Object oDbUpdateHandler is a cDbUpdateHandler
    Set pbAutoCreateDbVersionTable to False
    Set pbUseIntFilesBackup    to False
    Set pbCheckIntFiles to False 
    Set psDriverID to DATAFLEX_ID

    Set pbExitIfDebuggerActive to False
    Set phoDbUpdateHandler of ghoApplication to Self 
    
    Procedure OnPreUpdate
    End_Procedure  

End_Object
