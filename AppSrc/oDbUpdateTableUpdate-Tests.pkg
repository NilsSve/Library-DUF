// Table updates on real embedded tables, through ApiTableUpdate with a description of the table as it
// should be - the call that generated update code makes for every table.
//
// The tables live in a folder of their own with a Filelist of their own. Every test makes that folder in
// the temp folder, points the runtime and the workspace object at it, and removes it again afterwards.
// The Filelist, the Data folder and the DDSrc folder of the workspace are not touched.
//
// Errors are taken the way cDbUpdateHandler takes them: dropped while the library has its report mode
// switched off, counted otherwise. A test that expects a clean run asserts that the count is 0.

Use DFUnit\Fixturing\Fixture.pkg
Use cDbUpdateFunctionLibrary.pkg
Use cDbUpdateHandler.h.pkg

Object oDbUpdateTableUpdate_Tests is a cTestFixture
    Set psTestFixtureName to "ApiTableUpdate on embedded tables"

    Property String psFolder ""
    Property String psOldFilelistName ""
    Property String psOldOpenPath ""
    Property String psOldDataPath ""
    Property String psOldFileList ""
    Property String psOldDdSrcPath ""
    Property Handle phOldErrorObject 0
    Property String psTable ""
    // The new root name of a test that renames its table
    Property String psOtherTable ""
    Property Handle phTable 0

    // Stands in for the handler object as the error object of an update run.
    Object oErrors is a cObject
        Property Integer piErrors 0
        Property String  psErrors ""
        Procedure Error_Report Integer iErr Integer iLine String sMsg
            If (Error_Report_Mode(ghoDbUpdateFunctionLibrary) = DUF_ERROR_NO_REPORT) Begin
                Move False to Err
                Procedure_Return
            End
            If (iErr = DFERR_UNSUPPORTED_ATTRIBUTE) Begin
                Procedure_Return
            End
            // The library asks its parent object for the driver first. In a program that is the handler object.
            If (iErr = 98 and (Uppercase(sMsg) contains "PSDRIVERID")) Begin
                Procedure_Return
            End
            Set piErrors to (piErrors(Self) + 1)
            Set psErrors to (psErrors(Self) + " [" + String(iErr) + ": " + Left(sMsg, 80) + "]")
        End_Procedure
        Procedure Ignore_Error Integer iErr
        End_Procedure
        Procedure Trap_Error Integer iErr
        End_Procedure
        Procedure Ignore_All
        End_Procedure
        Procedure Trap_All
        End_Procedure
    End_Object

    // Stands in for the update handler as the parent of a library object that a test makes for itself: the
    // library asks its parent for the log object, and this log object keeps the lines it is given.
    Object oLogHost is a cObject
        Object oLog is a cObject
            Property String psLines ""
            Procedure LogError Number nVersion Integer iError String sText Integer iLine Boolean bError
                Set psLines to (psLines(Self) + sText + " | ")
            End_Procedure
        End_Object
        Function phoLogFile Returns Handle
            Function_Return (oLog(Self))
        End_Function
        Function pnCurrentVersionUpdate Returns Number
            Function_Return 0
        End_Function
    End_Object

    Procedure Setup
        Handle ho hoWorkspace
        String sTemp sFolder sValue

        If (ghoDbUpdateFunctionLibrary = 0) Begin
            Get Create (RefClass(cDbUpdateFunctionLibrary)) to ho
        End
        Get phoWorkspace of ghoApplication to hoWorkspace
        Close DF_ALL

        Get_Environment "TEMP" to sTemp
        Get vFolderFormat sTemp to sTemp
        Move (sTemp + "DUFTableTests" + String(Random(899999) + 100000)) to sFolder
        Make_Directory sFolder
        Set psFolder to sFolder

        Get_Attribute DF_FILELIST_NAME to sValue
        Set psOldFilelistName to sValue
        Get_Attribute DF_OPEN_PATH to sValue
        Set psOldOpenPath to sValue
        Get psDataPath of hoWorkspace to sValue
        Set psOldDataPath to sValue
        Get psFileList of hoWorkspace to sValue
        Set psOldFileList to sValue
        Get psDdSrcPath of hoWorkspace to sValue
        Set psOldDdSrcPath to sValue

        // A copy of the workspace's Filelist: the tests take a free slot of the copy.
        CopyFile (psOldFileList(Self)) to (sFolder + "\Filelist.cfg")
        Set_Attribute DF_FILELIST_NAME to (sFolder + "\Filelist.cfg")
        Set_Attribute DF_OPEN_PATH     to (sFolder + ";" + psOldOpenPath(Self))
        Set psDataPath of hoWorkspace  to sFolder
        Set psFileList of hoWorkspace  to (sFolder + "\Filelist.cfg")
        // A column that is added writes the table's .fd file into the DDSrc folder.
        Set psDdSrcPath of hoWorkspace to sFolder

        Set pbCompareDate_DateTime  of ghoDbUpdateFunctionLibrary to False
        Set pbCompareIndexAscending of ghoDbUpdateFunctionLibrary to False
        Set pbCompareIndexUppercase of ghoDbUpdateFunctionLibrary to False
        Set psTable to ""
        Set phTable to 0
        Move False to Err
    End_Procedure

    // The files of one embedded table in the test folder
    Procedure EraseTableFiles String sFolder String sTable
        Integer iKey

        If (sTable <> "") Begin
            EraseFile (sFolder + "\" + sTable + ".dat")
            EraseFile (sFolder + "\" + sTable + ".hdr")
            EraseFile (sFolder + "\" + sTable + ".tag")
            EraseFile (sFolder + "\" + sTable + ".vld")
            EraseFile (sFolder + "\" + sTable + ".fd")
            For iKey from 1 to 15
                EraseFile (sFolder + "\" + sTable + ".k" + String(iKey))
            Loop
        End
    End_Procedure

    Procedure TearDown
        Handle hoWorkspace
        String sFolder sTable

        Get phoWorkspace of ghoApplication to hoWorkspace
        Get psFolder to sFolder
        Close DF_ALL
        Set_Attribute DF_FILELIST_NAME to (psOldFilelistName(Self))
        Set_Attribute DF_OPEN_PATH     to (psOldOpenPath(Self))
        Set psDataPath of hoWorkspace  to (psOldDataPath(Self))
        Set psFileList of hoWorkspace  to (psOldFileList(Self))
        Set psDdSrcPath of hoWorkspace to (psOldDdSrcPath(Self))

        // Only what the test made, in the folder the test made.
        If (sFolder <> "" and (Uppercase(sFolder) contains "DUFTABLETESTS")) Begin
            Send EraseTableFiles sFolder (psTable(Self))
            // A test that renames its table: the files of the new name, and a folder that stood in their way.
            Get psOtherTable to sTable
            If (sTable <> "") Begin
                Send EraseTableFiles sFolder sTable
                Remove_Directory (sFolder + "\" + sTable + ".dat")
            End
            EraseFile (sFolder + "\Filelist.cfg")
            Remove_Directory sFolder
        End
        Set psFolder to ""
        Set psOtherTable to ""
        Move False to Err
    End_Procedure

    Function Col Integer iNo String sName Integer iType Integer iLen Integer iPrec Returns tAPIColumn
        tAPIColumn c
        Move iNo   to c.iFieldNumber
        Move sName to c.sFieldName
        Move iType to c.iType
        Move False to c.bIsSQLType
        Move False to c.bAllowNULL
        Move ""    to c.sDefaultValue
        Move (If(iType = DF_ASCII, "ASCII", If(iType = DF_BCD, "Numeric", "Date"))) to c.sType
        Move iLen  to c.iLength
        Move iPrec to c.iPrecision
        Move 0     to c.iOptions
        Function_Return c
    End_Function

    // An index of two or three segments. A field number of -1 ends the list.
    Function Idx Integer iNo Integer iF1 String sN1 Integer iF2 String sN2 Integer iF3 String sN3 Returns tAPIIndex
        tAPIIndex x
        Integer[] aiFields
        String[] asNames
        Integer i
        Move iNo   to x.iIndexNumber
        Move 0     to x.iPrimaryIndex
        Move 0     to x.iSQLIndexType
        Move False to x.bIsSQLClustered
        Move False to x.bIsSQLPrimaryKey
        Move iF1 to aiFields[0]
        Move sN1 to asNames[0]
        Move iF2 to aiFields[1]
        Move sN2 to asNames[1]
        Move iF3 to aiFields[2]
        Move sN3 to asNames[2]
        For i from 0 to 2
            If (aiFields[i] <> -1) Begin
                Move aiFields[i] to x.IndexSegmentArray[i].iFieldNumber
                Move asNames[i]  to x.IndexSegmentArray[i].sFieldName
                Move False       to x.IndexSegmentArray[i].bUppercase
                // bAscending holds DF_INDEX_SEGMENT_DIRECTION: DF_ASCENDING is 0, False.
                Move DF_ASCENDING to x.IndexSegmentArray[i].bAscending
            End
        Loop
        Function_Return x
    End_Function

    // The table the tests start from: 1 Id N6.0, 2 Code A5, 3 Name A30, 4 Created Date, 5 Amount N8.2
    Function BaseColumns Returns tAPIColumn[]
        tAPIColumn[] a
        Get Col 1 "Id" DF_BCD 6 0        to a[0]
        Get Col 2 "Code" DF_ASCII 5 0    to a[1]
        Get Col 3 "Name" DF_ASCII 30 0   to a[2]
        Get Col 4 "Created" DF_DATE 6 0  to a[3]
        Get Col 5 "Amount" DF_BCD 8 2    to a[4]
        Function_Return a
    End_Function

    // Its indexes: 1 Id; 2 Name, Id; 3 Created, Id
    Function BaseIndexes Returns tAPIIndex[]
        tAPIIndex[] a
        Get Idx 1 1 "Id" -1 "" -1 ""        to a[0]
        Get Idx 2 3 "Name" 1 "Id" -1 ""     to a[1]
        Get Idx 3 4 "Created" 1 "Id" -1 ""  to a[2]
        Function_Return a
    End_Function

    // One call of ApiTableRename that gives the table a new root, logical and display name, with the fixture's
    // error object in place. Returns the number of errors that were raised, or -1 when the call returned False
    // without one.
    Function RenameTable String sName Returns Integer
        Handle hoErrors
        Boolean bOK
        Integer iErrors

        Set psOtherTable to sName
        Move (oErrors(Self)) to hoErrors
        Set piErrors of hoErrors to 0
        Set psErrors of hoErrors to ""
        Set phOldErrorObject to Error_Object_Id
        Move hoErrors to Error_Object_Id
        Move False to Err
        Get ApiTableRename of ghoDbUpdateFunctionLibrary (phTable(Self)) sName sName sName to bOK
        Close DF_ALL
        Move (phOldErrorObject(Self)) to Error_Object_Id
        Move False to Err
        Get piErrors of hoErrors to iErrors
        If (iErrors = 0 and bOK = False) Begin
            Move -1 to iErrors
        End
        Function_Return iErrors
    End_Function

    // Is the file there? "Name.ext" in the test folder
    Function FileThere String sFileName Returns Boolean
        Boolean bExists

        Get vFilePathExists (psFolder(Self) + "\" + sFileName) to bExists
        Function_Return bExists
    End_Function

    // One call of ApiTableUpdate with the fixture's error object in place. Returns the number of errors
    // that were raised, or -1 when the call returned False without one.
    Function UpdateTable tAPIColumn[] aColumns tAPIIndex[] aIndexes Returns Integer
        tAPITableNameInfo Info
        tAPIRelation[] aNoRelations
        Handle hoErrors
        Boolean bOK
        Integer iErrors

        Move (phTable(Self)) to Info.iTableNumber
        Move (psTable(Self)) to Info.sRootName
        Move (psTable(Self)) to Info.sLogicalName
        Move (psTable(Self)) to Info.sDisplayName
        Move DATAFLEX_ID     to Info.sDriverID
        Move False           to Info.bIsAlias
        Move False           to Info.bIsSQL
        Move False           to Info.bIsSystemFile

        Move (oErrors(Self)) to hoErrors
        Set piErrors of hoErrors to 0
        Set psErrors of hoErrors to ""
        Set phOldErrorObject to Error_Object_Id
        Move hoErrors to Error_Object_Id
        Move False to Err
        Get ApiTableUpdate of ghoDbUpdateFunctionLibrary Info aColumns aIndexes aNoRelations to bOK
        Close DF_ALL
        Move (phOldErrorObject(Self)) to Error_Object_Id
        Move False to Err
        Get piErrors of hoErrors to iErrors
        If (iErrors = 0 and bOK = False) Begin
            Move -1 to iErrors
        End
        Function_Return iErrors
    End_Function

    // Makes the base table in a free slot of the copied Filelist and writes two records.
    // iColumns is 4 (the Date column last) or 5; bAllIndexes False leaves index 1 only.
    Procedure MakeBaseTable String sName Integer iColumns Boolean bAllIndexes
        Handle h
        String sRoot
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors

        Move 500 to h
        Repeat
            Increment h
            Get_Attribute DF_FILE_ROOT_NAME of h to sRoot
        Until (sRoot = "" or h > 4000)
        Set phTable to h
        Set psTable to sName

        Get BaseColumns to aColumns
        Move (ResizeArray(aColumns, iColumns)) to aColumns
        Get BaseIndexes to aIndexes
        If (not(bAllIndexes)) Begin
            Move (ResizeArray(aIndexes, 1)) to aIndexes
        End
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The base table is created without an error." + psErrors(oErrors(Self)))

        Open h
        Lock
            Clear h
            Set_Field_Value h 1 to 1
            Set_Field_Value h 2 to "C1"
            Set_Field_Value h 3 to "Anna"
            Set_Field_Value h 4 to (DateSet(2026, 1, 15))
            If (iColumns > 4) Begin
                Set_Field_Value h 5 to 12.5
            End
            SaveRecord h
            Clear h
            Set_Field_Value h 1 to 2
            Set_Field_Value h 2 to "C2"
            Set_Field_Value h 3 to "Bertil"
            Set_Field_Value h 4 to (DateSet(2026, 2, 20))
            If (iColumns > 4) Begin
                Set_Field_Value h 5 to 7
            End
            SaveRecord h
        Unlock
        Close h
    End_Procedure

    // "Name,Id" for an index, "" for an index that is not there
    Function IndexColumns Integer iIndex Returns String
        Handle h
        Integer iSegments iSegment iField
        String sName sResult
        Get phTable to h
        Open h
        Get_Attribute DF_INDEX_NUMBER_SEGMENTS of h iIndex to iSegments
        For iSegment from 1 to iSegments
            Get_Attribute DF_INDEX_SEGMENT_FIELD of h iIndex iSegment to iField
            Get_Attribute DF_FIELD_NAME of h iField to sName
            Move (sResult + If(iSegment > 1, ",", "") + sName) to sResult
        Loop
        Close h
        Function_Return sResult
    End_Function

    // "Id,Code,Created" - the table's columns in their order
    Function ColumnNames Returns String
        Handle h
        Integer iFields iField
        String sName sResult
        Get phTable to h
        Open h
        Get_Attribute DF_FILE_NUMBER_FIELDS of h to iFields
        For iField from 1 to iFields
            Get_Attribute DF_FIELD_NAME of h iField to sName
            Move (sResult + If(iField > 1, ",", "") + sName) to sResult
        Loop
        Close h
        Function_Return sResult
    End_Function

    // The type of the named column and its value in the first record, as "type|value"
    Function ColumnTypeAndFirstValue String sColumn Returns String
        Handle h
        Integer iField iType
        String sValue
        Get phTable to h
        Open h
        Field_Map h sColumn to iField
        Get_Attribute DF_FIELD_TYPE of h iField to iType
        Clear h
        Vfind h 0 GT
        Get_Field_Value h iField to sValue
        Close h
        Function_Return (String(iType) + "|" + Trim(sValue))
    End_Function

    { Published=True }
    Procedure Test_A_Date_Column_That_Moves_Up_Keeps_Its_Type_And_Its_Dates
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        // Id, Code, Name, Created: the column in front of the Date column goes.
        Send MakeBaseTable "DUFTT1" 4 False
        Get Col 1 "Id" DF_BCD 6 0        to aColumns[0]
        Get Col 2 "Code" DF_ASCII 5 0    to aColumns[1]
        Get Col 3 "Created" DF_DATE 6 0  to aColumns[2]
        Get Idx 1 1 "Id" -1 "" -1 ""     to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,Created" (ColumnNames(Self)) "The column in front of the Date column is gone."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "The Date column is still a Date and holds its date."
    End_Procedure

    { Published=True }
    Procedure Test_A_Date_Column_That_Changes_Places_Keeps_Its_Type_And_Its_Dates
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        Send MakeBaseTable "DUFTT2" 5 False
        Get Col 1 "Id" DF_BCD 6 0        to aColumns[0]
        Get Col 2 "Code" DF_ASCII 5 0    to aColumns[1]
        Get Col 3 "Created" DF_DATE 6 0  to aColumns[2]
        Get Col 4 "Name" DF_ASCII 30 0   to aColumns[3]
        Get Col 5 "Amount" DF_BCD 8 2    to aColumns[4]
        Get Idx 1 1 "Id" -1 "" -1 ""     to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,Created,Name,Amount" (ColumnNames(Self)) "Name and Created have changed places."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "The Date column is still a Date and holds its date."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "Name")) "The text column holds its text."
    End_Procedure

    { Published=True }
    Procedure Test_A_Changed_Index_Is_Changed_Under_Its_Own_Number
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors iRun iLast
        Handle h

        Send MakeBaseTable "DUFTT3" 5 True
        Get BaseColumns to aColumns
        Get BaseIndexes to aIndexes
        Get Idx 2 3 "Name" 4 "Created" 1 "Id" to aIndexes[1]

        // Twice: the second run has to find nothing to do.
        For iRun from 1 to 2
            Get UpdateTable aColumns aIndexes to iErrors
            Send AssertIAreEqual 0 iErrors ("Run " + String(iRun) + " is without an error." + psErrors(oErrors(Self)))
            Send AssertSAreEqual "Name,Created,Id" (IndexColumns(Self, 2)) ("Run " + String(iRun) + ": index 2 has its third segment.")
            Send AssertSAreEqual "Created,Id" (IndexColumns(Self, 3)) ("Run " + String(iRun) + ": index 3 is as it was.")
            Get phTable to h
            Open h
            Get_Attribute DF_FILE_LAST_INDEX_NUMBER of h to iLast
            Close h
            Send AssertIAreEqual 3 iLast ("Run " + String(iRun) + ": no index was added under a new number.")
        Loop
    End_Procedure

    { Published=True }
    Procedure Test_An_Index_Removed_From_The_Middle_Leaves_The_Others
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors

        Send MakeBaseTable "DUFTT4" 5 True
        Get BaseColumns to aColumns
        Get Idx 1 1 "Id" -1 "" -1 ""        to aIndexes[0]
        Get Idx 3 4 "Created" 1 "Id" -1 ""  to aIndexes[1]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id" (IndexColumns(Self, 1)) "Index 1 is as it was."
        Send AssertSAreEqual "" (IndexColumns(Self, 2)) "Index 2 is gone."
        Send AssertSAreEqual "Created,Id" (IndexColumns(Self, 3)) "Index 3 is as it was."
    End_Procedure

    { Published=True }
    Procedure Test_Columns_That_Change_Places_Keep_Their_Index
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors iLast
        Handle h

        // Code and Name change places. Name is in index 2.
        Send MakeBaseTable "DUFTT5" 5 True
        Get Col 1 "Id" DF_BCD 6 0        to aColumns[0]
        Get Col 2 "Name" DF_ASCII 30 0   to aColumns[1]
        Get Col 3 "Code" DF_ASCII 5 0    to aColumns[2]
        Get Col 4 "Created" DF_DATE 6 0  to aColumns[3]
        Get Col 5 "Amount" DF_BCD 8 2    to aColumns[4]
        Get Idx 1 1 "Id" -1 "" -1 ""        to aIndexes[0]
        Get Idx 2 2 "Name" 1 "Id" -1 ""     to aIndexes[1]
        Get Idx 3 4 "Created" 1 "Id" -1 ""  to aIndexes[2]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Name,Code,Created,Amount" (ColumnNames(Self)) "Code and Name have changed places."
        Send AssertSAreEqual "Name,Id" (IndexColumns(Self, 2)) "Index 2 is on Name and Id again."
        Get phTable to h
        Open h
        Get_Attribute DF_FILE_LAST_INDEX_NUMBER of h to iLast
        Close h
        Send AssertIAreEqual 3 iLast "No index was added under a new number."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "Name")) "The values followed their columns."
    End_Procedure

    // How many records the table has
    Function RecordCount Returns Integer
        Handle h
        Integer iRecords
        Get phTable to h
        Open h
        Move 0 to iRecords
        Clear h
        Repeat
            Vfind h 0 GT
            If (Found) Begin
                Increment iRecords
            End
        Until (not(Found))
        Close h
        Function_Return iRecords
    End_Function

    { Published=True }
    Procedure Test_A_Column_Removed_From_The_Middle_Leaves_The_Others_As_They_Are
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        // Code goes. Three columns stand behind it, one of them in an index.
        Send MakeBaseTable "DUFTT6" 5 True
        Get Col 1 "Id" DF_BCD 6 0        to aColumns[0]
        Get Col 2 "Name" DF_ASCII 30 0   to aColumns[1]
        Get Col 3 "Created" DF_DATE 6 0  to aColumns[2]
        Get Col 4 "Amount" DF_BCD 8 2    to aColumns[3]
        Get Idx 1 1 "Id" -1 "" -1 ""        to aIndexes[0]
        Get Idx 2 2 "Name" 1 "Id" -1 ""     to aIndexes[1]
        Get Idx 3 3 "Created" 1 "Id" -1 ""  to aIndexes[2]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The first run is without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Name,Created,Amount" (ColumnNames(Self)) "Code is gone and the others are in their order."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "Name")) "Name holds its text."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "Created holds its date."
        Send AssertSAreEqual "Name,Id" (IndexColumns(Self, 2)) "Index 2 is on Name and Id."
        Send AssertSAreEqual "Created,Id" (IndexColumns(Self, 3)) "Index 3 is on Created and Id."
        Send AssertIAreEqual 2 (RecordCount(Self)) "Both records are there."
    End_Procedure

    { Published=True }
    Procedure Test_A_New_Column_Beside_A_Column_Of_The_Same_Form_Is_A_New_Column
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        // Title is new, in front of Name, and has the type and the length of Name. It is not Name renamed:
        // Name is still in the description.
        Send MakeBaseTable "DUFTT7" 5 False
        Get Col 1 "Id" DF_BCD 6 0        to aColumns[0]
        Get Col 2 "Code" DF_ASCII 5 0    to aColumns[1]
        Get Col 3 "Title" DF_ASCII 30 0  to aColumns[2]
        Get Col 4 "Name" DF_ASCII 30 0   to aColumns[3]
        Get Col 5 "Created" DF_DATE 6 0  to aColumns[4]
        Get Col 6 "Amount" DF_BCD 8 2    to aColumns[5]
        Get Idx 1 1 "Id" -1 "" -1 ""     to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,Title,Name,Created,Amount" (ColumnNames(Self)) "Title stands in front of Name."
        Send AssertSAreEqual (String(DF_ASCII) + "|") (ColumnTypeAndFirstValue(Self, "Title")) "The new column is empty."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "Name")) "Name holds its text."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "Created holds its date."
        Send AssertSAreEqual (String(DF_BCD) + "|" + String(12.5)) (ColumnTypeAndFirstValue(Self, "Amount")) "Amount holds its number."
    End_Procedure

    { Published=True }
    Procedure Test_A_Column_Removed_And_The_Next_One_Renamed_Keeps_The_Renamed_Values
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors

        // Code goes, and Name is now FullName, same type and length.
        Send MakeBaseTable "DUFTT8" 5 False
        Get Col 1 "Id" DF_BCD 6 0          to aColumns[0]
        Get Col 2 "FullName" DF_ASCII 30 0 to aColumns[1]
        Get Col 3 "Created" DF_DATE 6 0    to aColumns[2]
        Get Col 4 "Amount" DF_BCD 8 2      to aColumns[3]
        Get Idx 1 1 "Id" -1 "" -1 ""       to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,FullName,Created,Amount" (ColumnNames(Self)) "Code is gone and Name is FullName."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "FullName")) "FullName holds the names."
    End_Procedure

    { Published=True }
    Procedure Test_Columns_In_Another_Order_Are_Moved_Into_Place
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        // The four columns behind Id in the opposite order: three moves.
        Send MakeBaseTable "DUFTT9" 5 False
        Get Col 1 "Id" DF_BCD 6 0        to aColumns[0]
        Get Col 2 "Amount" DF_BCD 8 2    to aColumns[1]
        Get Col 3 "Created" DF_DATE 6 0  to aColumns[2]
        Get Col 4 "Name" DF_ASCII 30 0   to aColumns[3]
        Get Col 5 "Code" DF_ASCII 5 0    to aColumns[4]
        Get Idx 1 1 "Id" -1 "" -1 ""     to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Amount,Created,Name,Code" (ColumnNames(Self)) "The columns are in the described order."
        Send AssertSAreEqual (String(DF_ASCII) + "|C1") (ColumnTypeAndFirstValue(Self, "Code")) "Code holds its text."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "Name")) "Name holds its text."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "Created holds its date."
    End_Procedure

    { Published=True }
    Procedure Test_A_Table_Is_Found_When_The_Data_Path_Names_Two_Folders
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        String sFolder

        Send MakeBaseTable "DUFTT10" 5 True
        Get psFolder to sFolder
        Set psDataPath of (phoWorkspace(ghoApplication)) to (sFolder + ";" + sFolder + "\Second")

        // The same description: nothing is to be done. The table must not be taken for a new one.
        Get BaseColumns to aColumns
        Get BaseIndexes to aIndexes
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertIAreEqual 2 (RecordCount(Self)) "The table still has its two records."
    End_Procedure

    { Published=True }
    Procedure Test_A_Data_File_Without_A_Filelist_Entry_Keeps_Its_Records
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Handle h
        String sRoot

        Send MakeBaseTable "DUFTT11" 5 True
        // The table loses its Filelist entry. Its files stay.
        Get phTable to h
        Close h
        Set_Attribute DF_FILE_ROOT_NAME    of h to ""
        Set_Attribute DF_FILE_LOGICAL_NAME of h to ""
        Set_Attribute DF_FILE_DISPLAY_NAME of h to ""

        Get BaseColumns to aColumns
        Get BaseIndexes to aIndexes
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Get_Attribute DF_FILE_ROOT_NAME of h to sRoot
        Send AssertSAreEqual "DUFTT11" sRoot "The table is in the Filelist again."
        Send AssertIAreEqual 2 (RecordCount(Self)) "The table still has its two records."
    End_Procedure

    // The length of the named column
    Function ColumnLength String sColumn Returns Integer
        Handle h
        Integer iField iLength
        Get phTable to h
        Open h
        Field_Map h sColumn to iField
        Get_Attribute DF_FIELD_LENGTH of h iField to iLength
        Close h
        Function_Return iLength
    End_Function

    // One call of ApiColumnRemove, the way update code can make it in front of ApiTableUpdate
    Function RemoveColumn String sColumn Returns Boolean
        Handle hoErrors
        Boolean bOK

        Move (oErrors(Self)) to hoErrors
        Set phOldErrorObject to Error_Object_Id
        Move hoErrors to Error_Object_Id
        Move False to Err
        Get ApiColumnRemove of ghoDbUpdateFunctionLibrary (phTable(Self)) sColumn to bOK
        Close DF_ALL
        Move (phOldErrorObject(Self)) to Error_Object_Id
        Move False to Err
        Function_Return bOK
    End_Function

    { Published=True }
    Procedure Test_A_Column_Renamed_And_Made_Longer_Keeps_Its_Values
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        // Name, text of 30, is FullName, text of 40. Index 2 is on it.
        Send MakeBaseTable "DUFTT12" 5 True
        Get BaseColumns to aColumns
        Get Col 3 "FullName" DF_ASCII 40 0 to aColumns[2]
        Get BaseIndexes to aIndexes
        Get Idx 2 3 "FullName" 1 "Id" -1 "" to aIndexes[1]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,FullName,Created,Amount" (ColumnNames(Self)) "Name is FullName, in its place."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "FullName")) "FullName holds the names."
        Send AssertIAreEqual 40 (ColumnLength(Self, "FullName")) "FullName has the new length."
        Send AssertSAreEqual "FullName,Id" (IndexColumns(Self, 2)) "Index 2 is on FullName and Id."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "Created holds its date."
        Send AssertIAreEqual 2 (RecordCount(Self)) "Both records are there."

        // The same description once more: nothing is left to do.
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The second run is without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "FullName")) "FullName still holds the names."
    End_Procedure

    { Published=True }
    Procedure Test_A_Renamed_Column_Keeps_Its_Values_When_A_New_Column_Comes_In_Front
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        // Rebate is new, in front of Code. Name is FullName and longer. Its neighbours, Code and Created,
        // are the same as before, though its number is not.
        Send MakeBaseTable "DUFTT13" 5 False
        Get Col 1 "Id" DF_BCD 6 0          to aColumns[0]
        Get Col 2 "Rebate" DF_BCD 8 2      to aColumns[1]
        Get Col 3 "Code" DF_ASCII 5 0      to aColumns[2]
        Get Col 4 "FullName" DF_ASCII 40 0 to aColumns[3]
        Get Col 5 "Created" DF_DATE 6 0    to aColumns[4]
        Get Col 6 "Amount" DF_BCD 8 2      to aColumns[5]
        Get Idx 1 1 "Id" -1 "" -1 ""       to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Rebate,Code,FullName,Created,Amount" (ColumnNames(Self)) "The columns are in the described order."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "FullName")) "FullName holds the names."
        Send AssertSAreEqual (String(DF_ASCII) + "|C1") (ColumnTypeAndFirstValue(Self, "Code")) "Code holds its text."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "Created holds its date."
        Send AssertSAreEqual (String(DF_BCD) + "|" + String(12.5)) (ColumnTypeAndFirstValue(Self, "Amount")) "Amount holds its number."
    End_Procedure

    { Published=True }
    Procedure Test_The_Last_Column_Renamed_And_Made_Longer_Keeps_Its_Values
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors

        // Amount, a number of 8.2, is Total, a number of 10.2. Its right neighbour is the edge of the table.
        Send MakeBaseTable "DUFTT14" 5 False
        Get BaseColumns to aColumns
        Get Col 5 "Total" DF_BCD 10 2    to aColumns[4]
        Get Idx 1 1 "Id" -1 "" -1 ""     to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,Name,Created,Total" (ColumnNames(Self)) "Amount is Total."
        Send AssertSAreEqual (String(DF_BCD) + "|" + String(12.5)) (ColumnTypeAndFirstValue(Self, "Total")) "Total holds the amounts."
        Send AssertIAreEqual 10 (ColumnLength(Self, "Total")) "Total has the new length."
    End_Procedure

    { Published=True }
    Procedure Test_A_Shorter_Column_In_The_Place_Of_A_Removed_One_Is_A_New_Column
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dFirst

        // Name, text of 30, is gone. Short, text of 10, stands in its place. The names would not all fit,
        // so Short is not Name under a new name.
        Send MakeBaseTable "DUFTT15" 5 False
        Get BaseColumns to aColumns
        Get Col 3 "Short" DF_ASCII 10 0  to aColumns[2]
        Get Idx 1 1 "Id" -1 "" -1 ""     to aIndexes[0]

        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,Short,Created,Amount" (ColumnNames(Self)) "Short stands where Name stood."
        Send AssertSAreEqual (String(DF_ASCII) + "|") (ColumnTypeAndFirstValue(Self, "Short")) "The new column is empty."
        Move (DateSet(2026, 1, 15)) to dFirst
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dFirst)) (ColumnTypeAndFirstValue(Self, "Created")) "Created holds its date."
    End_Procedure

    { Published=True }
    Procedure Test_A_Column_Removed_By_A_Call_Of_Its_Own_Is_Not_Taken_For_The_New_One
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Boolean bOK

        // The update code says that Name is to go. FullName is then a new column, although it stands
        // where Name stood and all the names would fit in it.
        Send MakeBaseTable "DUFTT16" 5 False
        Get RemoveColumn "Name" to bOK
        Send Assert bOK "ApiColumnRemove removes the column."

        Get BaseColumns to aColumns
        Get Col 3 "FullName" DF_ASCII 40 0 to aColumns[2]
        Get Idx 1 1 "Id" -1 "" -1 ""       to aIndexes[0]
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,FullName,Created,Amount" (ColumnNames(Self)) "FullName stands where Name stood."
        Send AssertSAreEqual (String(DF_ASCII) + "|") (ColumnTypeAndFirstValue(Self, "FullName")) "The new column is empty."
    End_Procedure

    // ApiTableRename copies the files of an embedded table to the new root name, and only then removes the
    // old ones: a copy that fails used to cost the table its data.
    { Published=True }
    Procedure Test_A_Renamed_Table_Keeps_Its_Records_Under_The_New_Name
        Integer iErrors
        String sRoot

        Send MakeBaseTable "DUFTT17" 5 True
        Get RenameTable "DUFTT17R" to iErrors
        Send AssertIAreEqual 0 iErrors ("The rename runs without an error." + psErrors(oErrors(Self)))
        Get_Attribute DF_FILE_ROOT_NAME of (phTable(Self)) to sRoot
        Send AssertSAreEqual "DUFTT17R" (Uppercase(sRoot)) "The Filelist names the new root name."
        Send Assert (FileThere(Self, "DUFTT17R.dat")) "The data file of the new name is there."
        Send Assert (FileThere(Self, "DUFTT17R.k3")) "So are its index files."
        Send AssertFalse (FileThere(Self, "DUFTT17.dat")) "The data file of the old name is gone."
        Send AssertFalse (FileThere(Self, "DUFTT17.k1")) "So are the index files of the old name."
        Send AssertIAreEqual 2 (RecordCount(Self)) "The table has its two records under the new name."
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "Name")) "The first record is as it was."
    End_Procedure

    { Published=True }
    Procedure Test_A_Rename_That_Cannot_Copy_Keeps_The_Table
        Integer iErrors
        String sRoot

        Send MakeBaseTable "DUFTT18" 5 True
        // A folder with the name of the new data file is in the way: Copy_db cannot write the copy.
        Make_Directory (psFolder(Self) + "\DUFTT18R.dat")
        Get RenameTable "DUFTT18R" to iErrors
        Send Assert (iErrors > 0) "The rename raises an error."
        Get_Attribute DF_FILE_ROOT_NAME of (phTable(Self)) to sRoot
        Send AssertSAreEqual "DUFTT18" (Uppercase(sRoot)) "The Filelist keeps the old root name."
        Send Assert (FileThere(Self, "DUFTT18.dat")) "The data file of the old name is still there."
        Send Assert (FileThere(Self, "DUFTT18.k2")) "So are its index files."
        Send AssertIAreEqual 2 (RecordCount(Self)) "The table still has its two records."
    End_Procedure

    { Published=True }
    Procedure Test_A_Table_In_The_Second_Data_Folder_Is_Renamed_There
        Integer iErrors
        String sFolder sRoot

        Send MakeBaseTable "DUFTT19" 5 True
        // The table's folder is now the second folder of the data path. The first one holds no table.
        Get psFolder to sFolder
        Set psDataPath of (phoWorkspace(ghoApplication)) to (sFolder + "\Second;" + sFolder)
        Get RenameTable "DUFTT19R" to iErrors
        Send AssertIAreEqual 0 iErrors ("The rename runs without an error." + psErrors(oErrors(Self)))
        Get_Attribute DF_FILE_ROOT_NAME of (phTable(Self)) to sRoot
        Send AssertSAreEqual "DUFTT19R" (Uppercase(sRoot)) "The Filelist names the new root name."
        Send Assert (FileThere(Self, "DUFTT19R.dat")) "The copy is made in the folder that holds the table."
        Send AssertFalse (FileThere(Self, "DUFTT19.dat")) "The data file of the old name is gone."
        Send AssertIAreEqual 2 (RecordCount(Self)) "The table has its two records under the new name."
    End_Procedure

    // A text column that the description makes a Date. It becomes one when it holds dates only. When a value is
    // not a date it keeps its type: the restructure would empty that value or make it into another date.
    { Published=True }
    Procedure Test_A_Text_Column_Of_Dates_Becomes_A_Date
        Handle h
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors
        Date dDate

        Send MakeBaseTable "DUFTT20" 5 True
        // Name gets a date, written the way this program writes dates, and an empty value. (DateSet answers a
        // DateTime on newer versions; its text has the time as well, so it goes through a Date first.)
        Move (DateSet(2026, 1, 15)) to dDate
        Get phTable to h
        Open h
        Lock
            Clear h
            Set_Field_Value h 1 to 1
            Vfind h 1 EQ
            Set_Field_Value h 3 to (String(dDate))
            SaveRecord h
            Clear h
            Set_Field_Value h 1 to 2
            Vfind h 1 EQ
            Set_Field_Value h 3 to ""
            SaveRecord h
        Unlock
        Close h

        Get BaseColumns to aColumns
        Get Col 3 "Name" DF_DATE 6 0 to aColumns[2]
        Get BaseIndexes to aIndexes
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual (String(DF_DATE) + "|" + String(dDate)) (ColumnTypeAndFirstValue(Self, "Name")) "Name is a Date column now, with its date."
        Send AssertIAreEqual 2 (RecordCount(Self)) "The table still has its two records."
    End_Procedure

    { Published=True }
    Procedure Test_A_Text_Column_With_Other_Values_Keeps_Its_Type
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors

        // Name holds "Anna" and "Bertil".
        Send MakeBaseTable "DUFTT21" 5 True
        Get BaseColumns to aColumns
        Get Col 3 "Name" DF_DATE 6 0 to aColumns[2]
        Get BaseIndexes to aIndexes
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 1 iErrors ("One error names the column." + psErrors(oErrors(Self)))
        Send AssertSAreEqual (String(DF_ASCII) + "|Anna") (ColumnTypeAndFirstValue(Self, "Name")) "Name keeps its type and its values."
    End_Procedure

    // A new index gets the direction and case of the description, also with the two compare switches off (the
    // default). It used to come out ascending and case-sensitive.
    { Published=True }
    Procedure Test_A_New_Index_Gets_Uppercase_And_Descending
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors iCase iDirection
        Handle h

        Send MakeBaseTable "DUFTT22" 5 True
        Get BaseColumns to aColumns
        Get BaseIndexes to aIndexes
        // Index 4: Name uppercase, Created descending, Id
        Get Idx 4 3 "Name" 4 "Created" 1 "Id" to aIndexes[3]
        Move DF_CASE_IGNORED to aIndexes[3].IndexSegmentArray[0].bUppercase
        Move DF_DESCENDING   to aIndexes[3].IndexSegmentArray[1].bAscending
        Get UpdateTable aColumns aIndexes to iErrors
        Send AssertIAreEqual 0 iErrors ("The update runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Name,Created,Id" (IndexColumns(Self, 4)) "Index 4 is there."

        Get phTable to h
        Open h
        Get_Attribute DF_INDEX_SEGMENT_CASE      of h 4 1 to iCase
        Get_Attribute DF_INDEX_SEGMENT_DIRECTION of h 4 2 to iDirection
        Close h
        Send AssertIAreEqual DF_CASE_IGNORED iCase "Its Name segment is uppercase."
        Send AssertIAreEqual DF_DESCENDING iDirection "Its Created segment is descending."
    End_Procedure

    // The version table is DUF's own: update code that describes it leaves it as it is. (The guard in
    // ApiTableUpdate compared a name that was never filled in, so the table was changed like any other.)
    { Published=True }
    Procedure Test_The_DbVersion_Table_Is_Left_As_It_Is
        tAPIColumn[] aColumns
        tAPIIndex[] aIndexes
        Integer iErrors

        // The table is made under a name of its own (made under the name DbVersion, the guard would skip it), then
        // described to ApiTableUpdate under the name DbVersion, with one more column.
        Send MakeBaseTable "DUFTT23" 5 True
        Set_Attribute DF_FILE_LOGICAL_NAME of (phTable(Self)) to "DbVersion"
        Set psOtherTable to "DbVersion"
        Get BaseColumns to aColumns
        Get BaseIndexes to aIndexes
        Get Col 6 "Note" DF_ASCII 20 0 to aColumns[5]
        Set psTable to "DbVersion"
        Get UpdateTable aColumns aIndexes to iErrors
        Set psTable to "DUFTT23"
        Send AssertIAreEqual 0 iErrors ("The call answers True and raises no error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Id,Code,Name,Created,Amount" (ColumnNames(Self)) "The table keeps its columns; Note is not added."
    End_Procedure

    // A Filelist entry with no table behind it, in a free slot of the copied Filelist from 501 on.
    Function AddFilelistEntry String sRootName String sName Returns Handle
        Handle h
        String sRoot

        Move 500 to h
        Repeat
            Increment h
            Get_Attribute DF_FILE_ROOT_NAME of h to sRoot
        Until (sRoot = "" or h > 4000)
        Set_Attribute DF_FILE_ROOT_NAME    of h to sRootName
        Set_Attribute DF_FILE_LOGICAL_NAME of h to sName
        Set_Attribute DF_FILE_DISPLAY_NAME of h to sName
        Function_Return h
    End_Function

    // One call of UtilTableFixALLBogusFilelistEntries with the fixture's error object in place, made by a library
    // object of the test's own whose parent is oLogHost; the lines it logs are in psLines of oLog. The library
    // object of the program is put back afterwards. Returns the number of errors that were raised, or -1 when the
    // call returned False without one.
    Function FixBogusEntries Returns Integer
        Handle hoErrors hoLibrary hoProgramLibrary
        Boolean bOK
        Integer iErrors

        Set psLines of (oLog(oLogHost(Self))) to ""
        Move ghoDbUpdateFunctionLibrary to hoProgramLibrary
        Get Create of (oLogHost(Self)) (RefClass(cDbUpdateFunctionLibrary)) to hoLibrary
        Move (oErrors(Self)) to hoErrors
        Set piErrors of hoErrors to 0
        Set psErrors of hoErrors to ""
        Set phOldErrorObject to Error_Object_Id
        Move hoErrors to Error_Object_Id
        Move False to Err
        Get UtilTableFixALLBogusFilelistEntries of hoLibrary to bOK
        Close DF_ALL
        Move (phOldErrorObject(Self)) to Error_Object_Id
        Move False to Err
        Send Destroy of hoLibrary
        Move hoProgramLibrary to ghoDbUpdateFunctionLibrary
        Get piErrors of hoErrors to iErrors
        If (iErrors = 0 and bOK = False) Begin
            Move -1 to iErrors
        End
        Function_Return iErrors
    End_Function

    Function LoggedLines Returns String
        Function_Return (psLines(oLog(oLogHost(Self))))
    End_Function

    Function RootNameOf Handle h Returns String
        String sRoot

        Get_Attribute DF_FILE_ROOT_NAME of h to sRoot
        Function_Return sRoot
    End_Function

    // UtilTableFixALLBogusFilelistEntries empties the Filelist slot of a table that is gone, and names the slot in
    // the log with its three names, so the entry can be put back by hand. (It emptied it with no line at all.)
    { Published=True }
    Procedure Test_A_Filelist_Entry_With_No_Table_Is_Emptied_And_Named_In_The_Log
        Handle h
        Integer iErrors
        String sLog

        Get AddFilelistEntry "DUFTT24" "DUFTT24" to h
        Get FixBogusEntries to iErrors
        Send AssertIAreEqual 0 iErrors ("The fix runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "" (RootNameOf(Self, h)) "The slot is empty."
        Get LoggedLines to sLog
        Send Assert ((sLog contains "DUFTT24") and (sLog contains "emptied")) ("The log names the emptied slot. Log:" * sLog)
    End_Procedure

    // A table whose data file is in a folder of the open path (DF_OPEN_PATH) but not of the data path is found by
    // the runtime, so its slot stays.
    { Published=True }
    Procedure Test_A_Table_Found_Through_The_Open_Path_Keeps_Its_Filelist_Entry
        Integer iErrors

        Send MakeBaseTable "DUFTT25" 5 False
        Set psDataPath of (phoWorkspace(ghoApplication)) to (psFolder(Self) + "\Second")
        Get FixBogusEntries to iErrors
        Send AssertIAreEqual 0 iErrors ("The fix runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "DUFTT25" (Uppercase(RootNameOf(Self, phTable(Self)))) "The slot keeps its root name."
    End_Procedure

    // Whether the table of an .int file is there only its driver can tell, so the slot stays, and the log says why.
    { Published=True }
    Procedure Test_The_Filelist_Entry_Of_An_Int_File_Is_Kept_And_Named_In_The_Log
        Handle h
        Integer iErrors
        String sLog

        Get AddFilelistEntry "DUFTT27.int" "DUFTT27" to h
        Get FixBogusEntries to iErrors
        Send AssertIAreEqual 0 iErrors ("The fix runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "DUFTT27.INT" (Uppercase(RootNameOf(Self, h))) "The slot keeps its root name."
        Get LoggedLines to sLog
        Send Assert ((sLog contains "DUFTT27") and (sLog contains "kept")) ("The log names the kept slot. Log:" * sLog)
    End_Procedure

    // A table of a driver the library is not connected to cannot be looked for on its server, so the slot stays.
    { Published=True }
    Procedure Test_The_Filelist_Entry_Of_Another_Driver_Is_Kept
        Handle h
        Integer iErrors

        Get AddFilelistEntry "DUFTESTDRV:DUFTT28" "DUFTT28" to h
        Get FixBogusEntries to iErrors
        Send AssertIAreEqual 0 iErrors ("The fix runs without an error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "DUFTESTDRV:DUFTT28" (Uppercase(RootNameOf(Self, h))) "The slot keeps its root name."
    End_Procedure

    // A table whose logical name is not its root name is no alias when no other entry shares its root name. (Every
    // such table was called an alias, and so it was left out of the conversion to SQL, the date fixing, the repair
    // and reindex and the test that nobody has the database open.)
    { Published=True }
    Procedure Test_A_Table_With_A_Root_Name_Of_Its_Own_Is_No_Alias
        Handle h

        Get AddFilelistEntry "DUFTT30" "DUFTT30X" to h
        Send AssertFalse (UtilTableIsAlias(ghoDbUpdateFunctionLibrary, h)) "Its root name is its own: no alias."
    End_Procedure

    // Of two entries that share a root name, the one whose logical name is the root name is the master.
    { Published=True }
    Procedure Test_The_Entry_Named_Like_Its_Root_Is_The_Master_Of_An_Alias
        Handle hMaster hAlias

        Get AddFilelistEntry "DUFTT31" "DUFTT31A" to hAlias
        Get AddFilelistEntry "DUFTT31" "DUFTT31" to hMaster
        Send AssertFalse (UtilTableIsAlias(ghoDbUpdateFunctionLibrary, hMaster)) "The master is no alias, though its slot is the higher one."
        Send Assert (UtilTableIsAlias(ghoDbUpdateFunctionLibrary, hAlias)) "The other entry is its alias."
    End_Procedure

    // When no entry of a shared root name is named like the root, the lower slot is the master.
    { Published=True }
    Procedure Test_Without_An_Entry_Named_Like_The_Root_The_Lower_Slot_Is_The_Master
        Handle hFirst hSecond

        Get AddFilelistEntry "DUFTT32" "DUFTT32M" to hFirst
        Get AddFilelistEntry "DUFTT32" "DUFTT32A" to hSecond
        Send AssertFalse (UtilTableIsAlias(ghoDbUpdateFunctionLibrary, hFirst)) "The lower slot is the master."
        Send Assert (UtilTableIsAlias(ghoDbUpdateFunctionLibrary, hSecond)) "The higher one is its alias."
    End_Procedure

    // The version table is read in its first record when it is no system file - the record that the new number is
    // written into. (Only a system table was read: the number stayed 0, and every update ran at every start.)
    { Published=True }
    Procedure Test_The_Version_Is_Read_From_A_Table_That_Is_No_System_File
        Handle h

        Send MakeBaseTable "DUFTT33" 5 False
        Get phTable to h
        Open h
        Send AssertNAreEqual 1 (DbVersionStoredValue(h, 1)) "Column 1 of the first record."
        Send AssertNAreEqual 12.5 (DbVersionStoredValue(h, 5)) "Column 5 of the first record."
        Close h
    End_Procedure
    // The fixture's error object takes the errors of the calls between these two.
    Procedure BeginCatch
        Handle hoErrors
        Move (oErrors(Self)) to hoErrors
        Set piErrors of hoErrors to 0
        Set psErrors of hoErrors to ""
        Set phOldErrorObject to Error_Object_Id
        Move hoErrors to Error_Object_Id
        Move False to Err
    End_Procedure

    Function EndCatch Returns Integer
        Close DF_ALL
        Move (phOldErrorObject(Self)) to Error_Object_Id
        Move False to Err
        Function_Return (piErrors(oErrors(Self)))
    End_Function

    // A small text file in the test folder
    Procedure WriteTestFile String sName String[] asLines
        Integer iCh iLine
        Get Seq_New_Channel to iCh
        Direct_Output channel iCh (psFolder(Self) + "\" + sName)
        For iLine from 0 to (SizeOfArray(asLines) - 1)
            Writeln channel iCh asLines[iLine]
        Loop
        Close_Output channel iCh
        Send Seq_Release_Channel iCh
    End_Procedure

    // ApiColumnChangeByColumnNumber gives the column the type it is asked for. (The new type was worked out from
    // the column's present type before that was read, so a text column stayed text.)
    { Published=True }
    Procedure Test_A_Column_Changed_By_Its_Number_Gets_The_New_Type
        Boolean bOK
        Integer iErrors

        Send MakeBaseTable "DUFTT34" 5 False
        Send BeginCatch
        Get ApiColumnChangeByColumnNumber of ghoDbUpdateFunctionLibrary DATAFLEX_ID (phTable(Self)) False False "Code" 2 DF_BCD 6 0 0 to bOK
        Get EndCatch to iErrors
        Send AssertIAreEqual 0 iErrors ("No error." + psErrors(oErrors(Self)))
        Send Assert bOK "The call answers True."
        Send AssertSAreEqual (String(DF_BCD) + "|") (Left(ColumnTypeAndFirstValue(Self, "Code"), 2)) "Code is a number column now."
    End_Procedure

    // ApiIndexInsertSegment puts the new segment in its place and moves the others up; past the end it appends it.
    // (The last segment was written over and the new one got the segment number as its column.)
    { Published=True }
    Procedure Test_A_Segment_Is_Inserted_Into_An_Index
        Boolean bOK
        Integer iErrors

        Send MakeBaseTable "DUFTT37" 5 True
        Send BeginCatch
        Get ApiIndexInsertSegment of ghoDbUpdateFunctionLibrary (phTable(Self)) 2 2 4 DF_CASE_USED DF_ASCENDING to bOK
        Get EndCatch to iErrors
        Send AssertIAreEqual 0 iErrors ("No error." + psErrors(oErrors(Self)))
        Send AssertSAreEqual "Name,Created,Id" (IndexColumns(Self, 2)) "Created is the second segment."
        Send BeginCatch
        Get ApiIndexInsertSegment of ghoDbUpdateFunctionLibrary (phTable(Self)) 2 9 2 DF_CASE_USED DF_ASCENDING to bOK
        Get EndCatch to iErrors
        Send AssertSAreEqual "Name,Created,Id,Code" (IndexColumns(Self, 2)) "Past the end the segment is appended."
    End_Procedure

    // ApiTableRemove deletes the table and empties its Filelist slot.
    { Published=True }
    Procedure Test_A_Removed_Table_Loses_Its_Files_And_Its_Entry
        Boolean bOK
        Integer iErrors

        Send MakeBaseTable "DUFTT38" 5 False
        Send BeginCatch
        Get ApiTableRemove of ghoDbUpdateFunctionLibrary (phTable(Self)) to bOK
        Get EndCatch to iErrors
        Send Assert bOK "The call answers True."
        Send AssertFalse (FileThere(Self, "DUFTT38.dat")) "The data file is gone."
        Send AssertSAreEqual "" (RootNameOf(Self, phTable(Self))) "The slot is empty."
    End_Procedure

    // A table whose data file cannot be deleted keeps its Filelist slot, and the call says so. (The slot was
    // emptied and the call answered True whatever happened.)
    { Published=True }
    Procedure Test_A_Table_That_Cannot_Be_Removed_Keeps_Its_Entry
        Boolean bOK
        Integer iErrors iCh

        Send MakeBaseTable "DUFTT39" 5 False
        // The data file is held open: it cannot be deleted.
        Get Seq_New_Channel to iCh
        Direct_Input channel iCh (psFolder(Self) + "\DUFTT39.dat")
        Send BeginCatch
        Get ApiTableRemove of ghoDbUpdateFunctionLibrary (phTable(Self)) to bOK
        Get EndCatch to iErrors
        Close_Input channel iCh
        Send Seq_Release_Channel iCh
        Send Assert (FileThere(Self, "DUFTT39.dat")) "The open data file could not be deleted."
        Send AssertFalse bOK "The call answers False."
        Send AssertSAreEqual "DUFTT39" (Uppercase(RootNameOf(Self, phTable(Self)))) "The slot keeps its entry."
    End_Procedure

    // _UtilDeleteCacheFile answers True when the cache file is gone, and when there was none. (It answered the
    // result of vDeleteFile, which is 0 - False - when the file is gone.)
    { Published=True }
    Procedure Test_The_Cache_File_Is_Removed
        String[] asLines
        Boolean bOK

        Move "cache" to asLines[0]
        Send WriteTestFile "DUFTT40.cch" asLines
        Get _UtilDeleteCacheFile of ghoDbUpdateFunctionLibrary "DUFTT40" to bOK
        Send Assert bOK "The call answers True."
        Send AssertFalse (FileThere(Self, "DUFTT40.cch")) "The cache file is gone."
        Get _UtilDeleteCacheFile of ghoDbUpdateFunctionLibrary "DUFTT40" to bOK
        Send Assert bOK "No cache file: True as well."
    End_Procedure

    // _UtilChangeSourceCodeLine answers True when it ran without an error - a line changed or not - and writes
    // the file only when a line changed. (It answered "a line changed", and wrote the file back with one more
    // blank line every time.)
    { Published=True }
    Procedure Test_ChangeSourceCodeLine_Writes_Only_A_Changed_File
        String[] asLines
        String sFile
        Boolean bOK
        Integer iSize

        Move "DRIVER_NAME MSSQLDRV" to asLines[0]
        Move "DATABASE_NAME DUFTT41" to asLines[1]
        Move "SCHEMA_NAME dbo" to asLines[2]
        Send WriteTestFile "DUFTT41.int" asLines
        Move (psFolder(Self) + "\DUFTT41.int") to sFile
        Get vWin32_APIFileSize sFile to iSize
        Get _UtilChangeSourceCodeLine of ghoDbUpdateFunctionLibrary sFile "NOSUCHLINE" "X" False to bOK
        Send Assert bOK "No line to change: True."
        Send AssertIAreEqual iSize (vWin32_APIFileSize(sFile)) "The file is as it was."
        Get _UtilChangeSourceCodeLine of ghoDbUpdateFunctionLibrary sFile "DATABASE_NAME DUFTT41" "DATABASE_NAME DUFTT42" False to bOK
        Send Assert bOK "A line changed: True."
        Send AssertIAreEqual (iSize + 0) (vWin32_APIFileSize(sFile)) "The same length: one line changed for one of the same size, nothing added."
        EraseFile sFile
    End_Procedure

    // UtilMoveMiscFilesToBackupFolder moves the files on every run. (Only the run that made the folder moved any.)
    { Published=True }
    Procedure Test_Misc_Files_Go_To_The_Backup_Folder_On_Every_Run
        String[] asLines
        String sBackup
        Boolean bOK

        Move (psFolder(Self) + "\" + CS_DUFBackupDataFolder) to sBackup
        Move "x" to asLines[0]
        Send WriteTestFile "DUFTT43.bak" asLines
        Get UtilMoveMiscFilesToBackupFolder of ghoDbUpdateFunctionLibrary to bOK
        Send WriteTestFile "DUFTT44.bak" asLines
        Get UtilMoveMiscFilesToBackupFolder of ghoDbUpdateFunctionLibrary to bOK
        Send Assert (vFilePathExists(sBackup + "\DUFTT43.bak")) "The first run moved its file."
        Send Assert (vFilePathExists(sBackup + "\DUFTT44.bak")) "So did the second."
        Send AssertFalse (FileThere(Self, "DUFTT44.bak")) "The data folder no longer has it."
        EraseFile (sBackup + "\DUFTT43.bak")
        EraseFile (sBackup + "\DUFTT44.bak")
        EraseFile (sBackup + "\*.fd")
        Remove_Directory sBackup
    End_Procedure

    // A data file in the first folder of a data path with two folders is found. (The whole path was taken for
    // one folder name.)
    { Published=True }
    Procedure Test_The_Data_File_Is_Found_When_The_Data_Path_Names_Two_Folders
        Send MakeBaseTable "DUFTT46" 5 False
        Set psDataPath of (phoWorkspace(ghoApplication)) to (psFolder(Self) + ";" + psFolder(Self) + "\Second")
        Send Assert (_DatFileExists(ghoDbUpdateFunctionLibrary, phTable(Self))) "The data file is found."
    End_Procedure
    // UtilColumnExists leaves a table open that the program had open. (It closed it in any case.)
    { Published=True }
    Procedure Test_A_Table_The_Program_Had_Open_Stays_Open
        Handle h
        Boolean bExists bOpen

        Send MakeBaseTable "DUFTT47" 5 False
        Get phTable to h
        Open h
        Get UtilColumnExists of ghoDbUpdateFunctionLibrary h "Name" to bExists
        Get_Attribute DF_FILE_OPENED of h to bOpen
        Close h
        Send Assert bExists "The column is found."
        Send Assert bOpen "The table is still open."
    End_Procedure
End_Object
