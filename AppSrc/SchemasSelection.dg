// SchemasSelection.dg The schemas of a database, to pick one from.
// The dialog is a cDUFSelectionDialog; the program fills its psTheData before it pops up.

Use cDUFSelectionDialog.pkg

Object oSchemasSelection_sl is a cDUFSelectionDialog
    Set Label to "SQL Schemas Selection"
    Set Size to 118 177
    Set piMinSize to 89 177
    Set Icon to "DatabaseLookup.ico"
    Set psColumnCaption to "Schema Name"
End_Object
