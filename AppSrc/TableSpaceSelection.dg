// TableSpaceSelection.dg The table spaces of a database, to pick one from.
// The dialog is a cDUFSelectionDialog; the program fills its psTheData before it pops up.

Use cDUFSelectionDialog.pkg

Object oTableSpaceSelection_sl is a cDUFSelectionDialog
    Set Label to "SQL Tablespace Selection"
    Set Size to 118 177
    Set piMinSize to 89 177
    Set Icon to "DatabaseLookup.ico"
    Set psColumnCaption to "Table Space Name"
End_Object
