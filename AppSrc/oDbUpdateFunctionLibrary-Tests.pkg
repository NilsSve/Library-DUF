// oDbUpdateFunctionLibrary-Tests.pkg - the helper functions of cDbUpdateFunctionLibrary that need no database:
// folder and table names, driver ids, the length-and-decimals text, the compare of index segments. Nothing here
// logs in or opens a table.
//
// Only procedures carrying { Published=True } are run as tests.

Use DFUnit\Fixturing\Fixture.pkg
Use cDbUpdateFunctionLibrary.pkg

Object oDbUpdateFunctionLibrary_Tests is a cTestFixture
    Set psTestFixtureName to "cDbUpdateFunctionLibrary - no database"

    // The library under test. A program that uses cDUFApplication has one already.
    Procedure Setup
        Handle ho
        If (ghoDbUpdateFunctionLibrary = 0) Begin
            Get Create (RefClass(cDbUpdateFunctionLibrary)) to ho
        End
    End_Procedure

    Procedure TearDown
    End_Procedure

    { Published=True }
    Procedure Test_AddFolderDelimiter_Ends_The_Path_In_One_Backslash
        String sPath
        Get _AddFolderDelimiter of ghoDbUpdateFunctionLibrary "C:\Temp" to sPath
        Send AssertSAreEqual "C:\Temp\" sPath "A path without a backslash at its end gets one."
        Get _AddFolderDelimiter of ghoDbUpdateFunctionLibrary "C:\Temp\" to sPath
        Send AssertSAreEqual "C:\Temp\" sPath "A path that ends in a backslash stays as it is."
        Get _AddFolderDelimiter of ghoDbUpdateFunctionLibrary "  C:\Temp  " to sPath
        Send AssertSAreEqual "C:\Temp\" sPath "Blanks around the path are trimmed first."
    End_Procedure

    { Published=True }
    Procedure Test_SqlFormatLengthAndDecimalAsString
        String sText
        Get _SqlFormatLengthAndDecimalAsString of ghoDbUpdateFunctionLibrary 10 2 to sText
        Send AssertSAreEqual "(10,2)" sText "Length and decimals."
        Get _SqlFormatLengthAndDecimalAsString of ghoDbUpdateFunctionLibrary 10 0 to sText
        Send AssertSAreEqual "(10)" sText "No decimals: the length alone."
        Get _SqlFormatLengthAndDecimalAsString of ghoDbUpdateFunctionLibrary 0 0 to sText
        Send AssertSAreEqual "" sText "No length: nothing at all."
    End_Procedure

    { Published=True }
    Procedure Test_IsDAWSQLDriver_Knows_The_Driver_Ids
        Boolean bIs
        Get IsDAWSQLDriver of ghoDbUpdateFunctionLibrary MSSQLDRV_ID to bIs
        Send Assert bIs "MSSQLDRV is one."
        Get IsDAWSQLDriver of ghoDbUpdateFunctionLibrary DB2_DRV_ID to bIs
        Send Assert bIs "DB2_DRV is one."
        Get IsDAWSQLDriver of ghoDbUpdateFunctionLibrary ODBC_DRV_ID to bIs
        Send Assert bIs "ODBC_DRV is one."
        Get IsDAWSQLDriver of ghoDbUpdateFunctionLibrary DATAFLEX_ID to bIs
        Send AssertFalse bIs "The embedded database is not."
        Get IsDAWSQLDriver of ghoDbUpdateFunctionLibrary "" to bIs
        Send AssertFalse bIs "An empty id is not."
    End_Procedure

    { Published=True }
    Procedure Test_IsSQLDriver_Follows_IsDAWSQLDriver
        Boolean bIs
        Get IsSQLDriver of ghoDbUpdateFunctionLibrary MSSQLDRV_ID to bIs
        Send Assert bIs "MSSQLDRV is an SQL driver."
        Get IsSQLDriver of ghoDbUpdateFunctionLibrary DATAFLEX_ID to bIs
        Send AssertFalse bIs "The embedded database is not."
    End_Procedure

    { Published=True }
    Procedure Test_TableNameOnly_Strips_Driver_And_Int
        String sName
        Get _TableNameOnly of ghoDbUpdateFunctionLibrary "MSSQLDRV:Customer" to sName
        Send AssertSAreEqual "Customer" sName "The driver prefix goes."
        Get _TableNameOnly of ghoDbUpdateFunctionLibrary "Customer.int" to sName
        Send AssertSAreEqual "Customer" sName "The .int extension goes."
        Get _TableNameOnly of ghoDbUpdateFunctionLibrary "MSSQLDRV:Customer.INT" to sName
        Send AssertSAreEqual "Customer" sName "Both go, whatever the case of the extension."
        Get _TableNameOnly of ghoDbUpdateFunctionLibrary "Customer" to sName
        Send AssertSAreEqual "Customer" sName "A plain name stays as it is."
    End_Procedure

    { Published=True }
    Procedure Test_TableNoPrefix_Strips_Driver_And_Schema
        String sName
        Get _TableNoPrefix of ghoDbUpdateFunctionLibrary "mssqldrv:mytable" to sName
        Send AssertSAreEqual "mytable" sName "The driver prefix goes."
        Get _TableNoPrefix of ghoDbUpdateFunctionLibrary "dbo.mytable" to sName
        Send AssertSAreEqual "mytable" sName "The schema goes."
        Get _TableNoPrefix of ghoDbUpdateFunctionLibrary "mssqldrv:dbo.mytable" to sName
        Send AssertSAreEqual "mytable" sName "Both go."
        Get _TableNoPrefix of ghoDbUpdateFunctionLibrary "mytable" to sName
        Send AssertSAreEqual "mytable" sName "A plain name stays as it is."
    End_Procedure

    { Published=True }
    Procedure Test_DriverIDFromRootName
        String sDriver
        Get _DriverIDFromRootName of ghoDbUpdateFunctionLibrary "MSSQLDRV:Customer" to sDriver
        Send AssertSAreEqual "MSSQLDRV" sDriver "What stands in front of the colon is the driver."
        Get _DriverIDFromRootName of ghoDbUpdateFunctionLibrary "Customer" to sDriver
        Send AssertSAreEqual DATAFLEX_ID sDriver "No colon: the embedded database."
    End_Procedure

    { Published=True }
    Procedure Test_RemoveDriverFromRootName_Hands_Back_Both_Parts
        String sName sDriver
        Get _RemoveDriverFromRootName of ghoDbUpdateFunctionLibrary "MSSQLDRV:Customer.int" (&sDriver) to sName
        Send AssertSAreEqual "Customer" sName "The name without driver and extension."
        Send AssertSAreEqual "MSSQLDRV" sDriver "The driver, handed back by reference."
        Move "" to sDriver
        Get _RemoveDriverFromRootName of ghoDbUpdateFunctionLibrary "Customer" (&sDriver) to sName
        Send AssertSAreEqual "Customer" sName "A plain name stays as it is."
        Send AssertSAreEqual DATAFLEX_ID sDriver "No colon: the embedded database."
    End_Procedure

    { Published=True }
    Procedure Test_IsDate_Takes_Digits_Dashes_And_Slashes
        Boolean bIs
        Get IsDate of ghoDbUpdateFunctionLibrary "2026-10-11" to bIs
        Send Assert bIs "Digits and dashes."
        Get IsDate of ghoDbUpdateFunctionLibrary "10/11/2026" to bIs
        Send Assert bIs "Digits and slashes."
        Get IsDate of ghoDbUpdateFunctionLibrary "2026-10-1x" to bIs
        Send AssertFalse bIs "A letter makes it no date."
    End_Procedure

    // -1 means "the same". Otherwise the answer is the first segment that differs, counted from 0.
    { Published=True }
    Procedure Test_UtilIndexSegmentsCompare_Sees_A_Different_Count
        tAPIIndexSegment[] aFrom aTo
        Integer iSegment
        Move 1 to aFrom[0].iFieldNumber
        Move 2 to aFrom[1].iFieldNumber
        Move 1 to aTo[0].iFieldNumber
        Move 2 to aTo[1].iFieldNumber
        Get UtilIndexSegmentsCompare of ghoDbUpdateFunctionLibrary aFrom aTo False False to iSegment
        Send AssertIAreEqual -1 iSegment "The same two segments on both sides."
        Move 9 to aTo[1].iFieldNumber
        Get UtilIndexSegmentsCompare of ghoDbUpdateFunctionLibrary aFrom aTo False False to iSegment
        Send AssertIAreEqual 1 iSegment "Another column in the second segment."
        Move 2 to aTo[1].iFieldNumber
        Move 3 to aFrom[2].iFieldNumber
        Get UtilIndexSegmentsCompare of ghoDbUpdateFunctionLibrary aFrom aTo False False to iSegment
        Send AssertIAreEqual 2 iSegment "A third segment in FROM only."
        Get UtilIndexSegmentsCompare of ghoDbUpdateFunctionLibrary aTo aFrom False False to iSegment
        Send AssertIAreEqual 2 iSegment "A third segment in TO only."
    End_Procedure

    // _UtilUpdateTAGFile adds a column name to a .tag file once, and gives its file channels back. It used to keep
    // one for each call that found the name there already; after about ten calls none was left. And it never found
    // a name there: it opened the file under its name in single quotes. The file name has a space on purpose.
    { Published=True }
    Procedure Test_UtilUpdateTAGFile_Gives_Its_Channels_Back
        String sTemp sFile sLine sNames
        Integer iCh iCall
        Boolean bOK

        Get_Environment "TEMP" to sTemp
        Move (sTemp + "\DUF Unit Test.tag") to sFile
        Get Seq_New_Channel to iCh
        Direct_Output channel iCh sFile
        Writeln channel iCh "ID"
        Writeln channel iCh "NAME"
        Close_Output channel iCh
        Send Seq_Release_Channel iCh

        For iCall from 1 to 30
            Get _UtilUpdateTAGFile of ghoDbUpdateFunctionLibrary sFile "NAME" to bOK
        Loop
        Get _UtilUpdateTAGFile of ghoDbUpdateFunctionLibrary sFile "CITY" to bOK
        Get _UtilUpdateTAGFile of ghoDbUpdateFunctionLibrary sFile "CITY" to bOK
        Send Assert bOK "The last call answers True."

        Get Seq_New_Channel to iCh
        Send Assert (iCh <> DF_SEQ_CHANNEL_NOT_AVAILABLE) "After 32 calls a file channel is still free."
        If (iCh <> DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
            Direct_Input channel iCh sFile
            While (not(SeqEof))
                Readln channel iCh sLine
                If (Trim(sLine) <> "") Begin
                    Move (sNames + Trim(sLine) + ",") to sNames
                End
            Loop
            Close_Input channel iCh
            Send Seq_Release_Channel iCh
        End
        EraseFile sFile
        Send AssertSAreEqual "ID,NAME,CITY," sNames "NAME stays once, CITY is added once."
    End_Procedure

    // A driver prefix or an .int file makes a root name that of a database driver's table. A drive in front is a
    // folder: a driver id is longer than one letter.
    { Published=True }
    Procedure Test_RootNameIsDriverTable_Takes_A_Drive_For_A_Folder
        Send Assert (_UtilRootNameIsDriverTable(ghoDbUpdateFunctionLibrary, "MSSQLDRV:Customer")) "A driver prefix."
        Send Assert (_UtilRootNameIsDriverTable(ghoDbUpdateFunctionLibrary, "Customer.int")) "An .int file."
        Send Assert (_UtilRootNameIsDriverTable(ghoDbUpdateFunctionLibrary, "CUSTOMER.INT")) "An .int file in capitals."
        Send AssertFalse (_UtilRootNameIsDriverTable(ghoDbUpdateFunctionLibrary, "Customer")) "A plain name is embedded."
        Send AssertFalse (_UtilRootNameIsDriverTable(ghoDbUpdateFunctionLibrary, "C:\Data\Customer")) "A drive in front is a folder."
        Send AssertFalse (_UtilRootNameIsDriverTable(ghoDbUpdateFunctionLibrary, "..\Data\Customer")) "So is a relative folder."
    End_Procedure
    // An "=" inside a value is part of the value: a password such as ab=cd. (The first "=" of every value was
    // taken out, so such a password no longer matched.)
    { Published=True }
    Procedure Test_ParseKeyWord_Keeps_An_Equals_Sign_In_A_Value
        String sValue
        Get ParseKeyWord of ghoDbUpdateFunctionLibrary "SERVER=x;UID=u;PWD=ab=cd;DATABASE=d" "PWD=" to sValue
        Send AssertSAreEqual "ab=cd" sValue "The password with its equals sign."
        Get ParseKeyWord of ghoDbUpdateFunctionLibrary "SERVER=x;DFConnectionId=MyId" (Uppercase(CS_SQLConnectionIDText)) to sValue
        Send AssertSAreEqual "MyId" sValue "A keyword passed without its equals sign."
    End_Procedure

    // A keyword is found at the start of the string or after a ";" only: "DSN=" is not the end of "FILEDSN=".
    { Published=True }
    Procedure Test_ParseKeyWord_Finds_A_Keyword_At_Its_Start_Only
        String sValue
        Get ParseKeyWord of ghoDbUpdateFunctionLibrary "FILEDSN=c:\x\a.dsn;DSN=Sales;UID=u" "DSN=" to sValue
        Send AssertSAreEqual "Sales" sValue "DSN, not the end of FILEDSN."
        Get ParseKeyWord of ghoDbUpdateFunctionLibrary "SERVER=x; DATABASE=Orders" "DATABASE=" to sValue
        Send AssertSAreEqual "Orders" sValue "A blank after the semicolon."
        Get ParseKeyWord of ghoDbUpdateFunctionLibrary "SERVER=x;DATABASE=Orders" "NODATABASE=" to sValue
        Send AssertSAreEqual "" sValue "A keyword that is not there."
        Get ParseKeyWord of ghoDbUpdateFunctionLibrary "DFConnectionId=MyId, SERVER=host;DATABASE=Orders" "SERVER=" to sValue
        Send AssertSAreEqual "host" sValue "A keyword after a comma."
    End_Procedure

    // Set pbSilentLogin sets the silent-login flag. (It wrote the trusted-connection flag, so a connection with a
    // user and a password became a Windows login.)
    { Published=True }
    Procedure Test_pbSilentLogin_Is_A_Setting_Of_Its_Own
        Boolean bSilent bTrusted bSilentAfter bTrustedAfter

        Get pbSilentLogin of ghoSQLConnectionHandler to bSilent
        Get pbTrusted     of ghoSQLConnectionHandler to bTrusted
        Set pbSilentLogin of ghoSQLConnectionHandler to (not(bSilent))
        Get pbSilentLogin of ghoSQLConnectionHandler to bSilentAfter
        Get pbTrusted     of ghoSQLConnectionHandler to bTrustedAfter
        Set pbSilentLogin of ghoSQLConnectionHandler to bSilent
        Send Assert (bSilentAfter = (not(bSilent))) "The silent-login flag is set."
        Send Assert (bTrustedAfter = bTrusted) "The trusted-connection flag is left as it was."
    End_Procedure

    // Stands in for the program's error object while a driver that does not exist is loaded.
    Object oNoErrors is a cObject
        Property Integer piErrors 0
        Procedure Error_Report Integer iErr Integer iLine String sMsg
            Set piErrors to (piErrors(Self) + 1)
        End_Procedure
    End_Object

    // DriverIndex of the connection handler is 0 for a driver that cannot be loaded, as its callers test. (It
    // answered -1 or one past the last driver.)
    { Published=True }
    Procedure Test_DriverIndex_Is_0_For_A_Driver_That_Cannot_Be_Loaded
        Integer iDriver iNoDriver
        Handle hoOld

        Get DriverIndex of ghoSQLConnectionHandler DATAFLEX_ID to iDriver
        Move Error_Object_Id to hoOld
        Move (oNoErrors(Self)) to Error_Object_Id
        Get DriverIndex of ghoSQLConnectionHandler "DUFNOSUCHDRV" to iNoDriver
        Move hoOld to Error_Object_Id
        Move False to Err
        Send Assert (iDriver > 0) "The DataFlex driver has a number."
        Send AssertIAreEqual 0 iNoDriver "A driver that cannot be loaded: 0."
    End_Procedure
    // With no step asked for, the preparation for a conversion to SQL has not failed. (The result of the Filelist
    // step was kept in its own input parameter, which had to be True.)
    { Published=True }
    Procedure Test_PrepareDataFolder_Without_A_Step_Is_No_Failure
        Send Assert (UtilPrepareDataFolderForSQLConversion(ghoDbUpdateFunctionLibrary, False, False, False, False, False)) "No step asked for: True."
    End_Procedure

    // IsFirstStringGreaterThanSecond decides at the first part that differs. ("6.3.0.13" passed for "20.1.0.5".)
    { Published=True }
    Procedure Test_IsFirstStringGreaterThanSecond_Decides_At_The_First_Different_Part
        Send AssertFalse (IsFirstStringGreaterThanSecond("6.3.0.13", "20.1.0.5")) "6 is below 20."
        Send AssertFalse (IsFirstStringGreaterThanSecond("19.9", "20.1")) "19 is below 20."
        Send Assert (IsFirstStringGreaterThanSecond("20.1.0.6", "20.1.0.5")) "The last part is higher."
        Send Assert (IsFirstStringGreaterThanSecond("20.1.0.5", "20.1.0.5")) "The same version is enough."
        Send Assert (IsFirstStringGreaterThanSecond("21", "20.1.0.5")) "A higher first part is enough."
    End_Procedure

    // UtilTableCombineFromAndToArrays takes a highest table that is on one side only. (It read one element past the
    // array for the last one.)
    { Published=True }
    Procedure Test_The_Highest_Table_On_One_Side_Only_Is_Combined
        tAPITable[] aFrom aTo
        tAPITableCompare[] aCompare
        Handle hoOld

        Move 3    to aTo[0].hTable
        Move True to aTo[0].bToTable
        Move 3    to aTo[0].ApiTableInfo.iTableNumber
        Move 5    to aFrom[0].hTable
        Move True to aFrom[0].bFromTable
        Move 5    to aFrom[0].ApiTableInfo.iTableNumber
        Set piErrors of oNoErrors to 0
        Move Error_Object_Id to hoOld
        Move (oNoErrors(Self)) to Error_Object_Id
        Get UtilTableCombineFromAndToArrays of ghoDbUpdateFunctionLibrary aFrom aTo to aCompare
        Move hoOld to Error_Object_Id
        Move False to Err
        Send AssertIAreEqual 0 (piErrors(oNoErrors(Self))) "No error."
        Send AssertIAreEqual 2 (SizeOfArray(aCompare)) "Both tables are in the result."
    End_Procedure

    // A type name is looked up by its name. (The lookup compared the type number only, which was 0: every name
    // became DF_ASCII.)
    { Published=True }
    Procedure Test_UtilColumnTypeToInteger_Looks_Up_The_Name
        Send AssertIAreEqual DF_BCD (UtilColumnTypeToInteger(ghoDbUpdateFunctionLibrary, DATAFLEX_ID, EN_DbTypeDataFlex, "Numeric")) "Numeric."
        Send AssertIAreEqual DF_DATE (UtilColumnTypeToInteger(ghoDbUpdateFunctionLibrary, DATAFLEX_ID, EN_DbTypeDataFlex, "date")) "Date, in small letters."
    End_Procedure

    // A text column of the DUF types takes a length, a date column does not: bCanEditSize means what its name
    // says in the hand-written type tables too. (There it meant "fixed", so DF_ASCII_DUF 35 lost its 35.)
    { Published=True }
    Procedure Test_A_DUF_Text_Type_Takes_A_Length
        Send AssertFalse (UtilColumnTypeFixed(ghoDbUpdateFunctionLibrary, MSSQLDRV_ID, EN_DbTypeMSSQL, DF_ASCII_DUF)) "ASCII takes a length."
        Send Assert (UtilColumnTypeFixed(ghoDbUpdateFunctionLibrary, MSSQLDRV_ID, EN_DbTypeMSSQL, DF_DATE_DUF)) "Date does not."
    End_Procedure

    // LogError puts back the report mode it found: a caller's quiet section stays quiet. (It set "report" in any
    // case.)
    { Published=True }
    Procedure Test_LogError_Keeps_A_Quiet_Section_Quiet
        Integer iMode
        Set Error_Report_Mode of ghoDbUpdateFunctionLibrary to DUF_ERROR_NO_REPORT
        Send LogError of ghoDbUpdateFunctionLibrary "A line" False
        Get Error_Report_Mode of ghoDbUpdateFunctionLibrary to iMode
        Set Error_Report_Mode of ghoDbUpdateFunctionLibrary to DUF_ERROR_REPORT
        Send AssertIAreEqual DUF_ERROR_NO_REPORT iMode "Still no report."
    End_Procedure
End_Object
