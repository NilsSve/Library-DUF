# Files to be ignored by git in a DataFlex workspace

# AppHtml
**/apphtml/global.asa

# AppSrc
**/AppSrc/**/*.prn
**/AppSrc/**/*.dep
**/AppSrc/**/*.dbg
**/AppSrc/**/*.exe.manifest
**/AppSrc/**/*.err
**/AppSrc/**/*.fld
**/AppSrc/**/*.pbg
**/AppSrc/**/*.pdp
**/AppSrc/**/*.pkd
**/AppSrc/**/*.prn
**/AppSrc/**/*.prp
loginEncryptionkey.inc

# Data
**/Data/**/*.log
**/Data/**/*.dat
**/Data/**/*.vld
**/Data/**/*.k*
**/Data/**/*.bad
**/Data/**/*.hdr
**/Data/**/*.cch
**/Data/**/*.cfg
**/Data/**/*.tag
**/Data/**/Deploy/**

# DDSrc
**/DdSrc/**/*.def

# IdeSrc
**/IdeSrc/*.dsk
**/IdeSrc/*.loc
**/IdeSrc/*.mtd

# Programs
**/Programs/*.dbg
**/Programs/*.exe
**/Programs/*.exe.manifest
**/Programs/*.log
**/Programs/*.ini

# Workspace specific
**/Data/compileheader.h
**/Help/**/*.hnd
**/Help/**/Assets
**/Help/**/Online Help
# Help/About.rtf is NOT ignored. DfAbout.pkg embeds it as a program resource, so a clone with
# no About.rtf cannot compile at all. A minimal placeholder is committed instead; replace its
# text freely, but do not delete the file.
*.rtf.bak
**/HelpText/*.*
HelpText/

**/Install

**/Capture
**/dfrefactor backup
**/*.mp4
FileListFixes.txt
DUFUpdatelog.txt
TableStructLog.txt
AppSrc/CompileHeader.h
LoginEncryptionKey.inc
